{
	// ============================================================
	// Cloudflare Workers 配置（静态资源型 Worker）
	// ------------------------------------------------------------
	// 本站的线上部署形态是「Worker + 静态资源」，不是 Cloudflare Pages 项目。
	// 判别依据（都已实测确认）：
	//   1. 构建记录名称是「Workers Builds: firefly」；
	//   2. 控制台地址是 workers/services/view/firefly/production；
	//   3. 线上任意不存在的路径返回「404 + 空 body」，
	//      这是 Workers 静态资源层 not_found_handling 默认值的行为。
	//
	// ⚠️ 因此这里只能写 Workers 字段（assets / main）。
	//    千万不要写 Pages 专用的 pages_build_output_dir ——
	//    Worker 读不懂它，wrangler 会在配置阶段直接报错，表现为
	//    「推送后秒失败」，而构建日志又只在 Cloudflare 控制台可见，
	//    排查起来非常绕。2026-09-22 就踩过这个坑，导致 8/13 之后
	//    所有提交都没能上线。
	// ============================================================

	// Worker 名称，必须与控制台里的服务名一致
	"name": "firefly",

	// Worker 入口：只负责 /api/ 下那几个需要服务端的接口
	// （登录、退出、登录状态、GitHub 贡献数据、GitHub 读写代理）
	"main": "worker/index.js",

	// 构建产物目录：Astro 输出到 dist
	"assets": {
		"directory": "./dist",
		// 绑定名，入口里用 env.ASSETS.fetch() 把请求交回资源层
		"binding": "ASSETS"
	},

	// Workerd 运行时兼容性
	"compatibility_date": "2025-01-01",
	"compatibility_flags": ["nodejs_compat"]

	// ------------------------------------------------------------
	// 环境变量（不要把密码/密钥写进本文件！）
	// 在 Cloudflare 控制台配置，路径：
	//   Workers & Pages → firefly → Settings → Variables and Secrets
	// 需要配置的变量见 docs/Cloudflare部署指南.md
	// ------------------------------------------------------------
}
