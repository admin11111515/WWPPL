---
/**
 * 图片库：看仓库里已有哪些图、上传新的、预览、改名、删除、复制 Markdown 插进正文。
 *
 * 为什么要有这一页（2026-10-02 站长原话）：
 *   「后台管理中的功能点不够完善，如图片无法预览和上传以及修改」
 * 之前只有后台首页一个"传图片"小面板（传完只能复制一段 Markdown），
 * 看不到仓库里已有什么、不能预览大图、不能改名、不能删。
 *
 * 参照：git 型 CMS 的媒体库（decaporg/decap-cms ★1.9万、sveltia/sveltia-cms ★2.9k）。
 * 它们对同一件事的做法是：一个库 + 搜索 + 缩略图网格 + 选中态 + 「插入 / 删除」，
 * 上传同时支持点选与拖拽。这里照着做，再加了一条它们没有的：剪贴板粘贴上传。
 *
 * ⚠️ 上传的不是"内容"而是静态资源，落在 public/images/ 下。
 *    线上要在 Cloudflare 重新构建之后才会出现在站上（一两分钟），
 *    所以刚传完的那张在本页用本地 blob 预览，并标一句「重建后站上生效」。
 */
import AdminTheme from "@/components/admin/AdminTheme.astro";
import AdminAuthGate from "@/components/admin/AdminAuthGate.astro";
import AdminTopBar from "@/components/admin/AdminTopBar.astro";
import { adminBodyClass, adminHtmlClass } from "@/components/admin/adminShell";
import { externalPostsConfig } from "@/config/externalPostsConfig";
// 后台不走博客 Layout，也就没有 iconify 运行时，图标用构建期内联的 SVG
import { uiIcon } from "@/constants/ui-icons";

const target = {
	owner: externalPostsConfig.owner,
	repo: externalPostsConfig.repo,
	branch: externalPostsConfig.branch,
	/** 图片库的根目录（仓库里的路径） */
	root: "public/images",
	/** 默认上传到哪 */
	uploadDir: "public/images/uploads",
};

const ICONS = {
	lead: uiIcon("fluent-color:image-24"),
	empty: uiIcon("fluent-color:document-folder-24"),
	search: uiIcon("fluent-color:search-visual-24"),
	zoom: uiIcon("material-symbols:zoom-in"),
	copy: uiIcon("material-symbols:content-copy"),
	// 「复制站上地址」单独一个图标：原来和上面那个共用 content-copy，
	// 同一个图标表示两件事，一排按钮看下来分不清哪个是哪个
	link: uiIcon("material-symbols:link"),
	rename: uiIcon("material-symbols:drive-file-rename-outline"),
	del: uiIcon("material-symbols:delete"),
	upload: uiIcon("material-symbols:upload"),
	refresh: uiIcon("material-symbols:refresh"),
	close: uiIcon("material-symbols:close"),
};
---

<html lang="zh-CN" class={adminHtmlClass}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>图片库 · 后台</title>
  <meta name="robots" content="noindex, nofollow" />
  <AdminTheme />
  <AdminAuthGate />
  <style is:inline>
    /* 通用部分在 admin.css；这里只放这一页特有的。 */

    /* ===== 工具栏 ===== */
    .media-tools {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
      margin-bottom: 0.875rem;
    }
    .media-tools .search {
      flex: 1;
      min-width: 10rem;
      max-width: 20rem;
    }
    .media-tools .spacer { flex: 1; }

    /* ===== 拖放区：平时不画框，拖进来才亮 =====
       2026-10-04 改：原来这里是**常驻的虚线框**，看着像一整块"上传区"，
       而且只在框里能接住文件 —— 拖到工具条/页头/侧栏上没人接，浏览器就按默认行为
       直接打开你拖进来的那张图（人被踢出后台）。现在改成：
         · 平时：透明边框（占位用的，去掉布局会跳）+ 无底色，看着就是一块干净的网格
         · 拖文件进入页面：整块亮起来（虚线 + 主题色淡底），松手哪都能放
       ⚠️ 边框必须是「透明但有宽度」而不是 border:none —— 不然拖拽时突然多出 1px，
          网格会整体跳一下。 */
    .media-drop {
      border: 1px dashed transparent;
      border-radius: var(--radius-large);
      padding: 0.875rem;
      transition: border-color 0.15s, background-color 0.15s;
    }
    .media-drop.over {
      border-color: var(--accent-ink);
      background: color-mix(in oklab, var(--primary) 8%, transparent);
    }

    /* ===== 缩略图网格 ===== */
    .media-grid {
      display: grid;
      /* 150 → 180：150px 一列连一个文件名都放不下，才逼得下面用 break-all 硬断
         （实测断成 3 行）。列宽给够，文字就不需要「逐字断行」这种下策。 */
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 0.75rem;
    }
    /* 分批加载的那条：一次只渲染 24 张，多的按按钮加
       （2026-10-05：原来 58 张一次性铺开，缩略图一多首屏就卡） */
    .media-more {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
      flex-wrap: wrap;
      margin-top: 0.875rem;
      font-size: 0.75rem;
      color: var(--text-3);
    }
    .media-item {
      border: 1px solid var(--line-soft);
      border-radius: var(--radius-large);
      overflow: hidden;
      background: var(--card-bg);
      display: flex;
      flex-direction: column;
      transition: border-color 0.15s, transform 0.15s;
    }
    /* 缩略图左上角的勾选框：24px 的点击范围，视觉上不抢图片 */
    .media-thumb .pick {
      position: absolute;
      top: 0.25rem;
      left: 0.25rem;
      z-index: 2;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 24px;
      height: 24px;
      /* ⚠️ 这里**不放浅色底**（站长 2026-10-04）：只留勾选框本身，
         压在照片上怕看不见就给一点投影（投影不是"容器"）。 */
      filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.35));
    }
    .media-thumb .pick input { width: 0.9375rem; height: 0.9375rem; accent-color: var(--accent-ink); }
    .media-item.picked { border-color: var(--accent-ink); background: color-mix(in oklab, var(--primary) 6%, var(--card-bg)); }
    /* 拖进来的图仓库里已经有了一模一样的一份时，把那一张闪一下指给你看
       （不传第二份，但得让你知道"它在哪儿"） */
    .media-item.dup-flash { animation: dup-flash 1.6s ease; }
    @keyframes dup-flash {
      0%, 100% { box-shadow: none; }
      15%, 55% { box-shadow: 0 0 0 2px var(--primary); }
    }

    .media-item:hover {
      border-color: color-mix(in oklab, var(--primary) 35%, var(--line-soft));
      transform: translateY(-2px);
    }
    .media-thumb {
      position: relative;
      aspect-ratio: 4 / 3;
      background: var(--card-bg-soft);
      cursor: zoom-in;
    }
    .media-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    /* 刚上传、还没重新构建的那张：角标说明"站上还没有" */
    .media-flag {
      position: absolute;
      left: 0.375rem;
      bottom: 0.375rem;
      padding: 0.0625rem 0.375rem;
      border-radius: var(--radius-md);
      font-size: 0.625rem;
      font-weight: 700;
      background: var(--success-soft);
      color: var(--success);
    }
    .media-body {
      padding: 0.625rem 0.75rem 0.75rem;
      min-width: 0;
    }
    /* ⚠️ 原来这两行都是 word-break: break-all —— 文件名/路径被逐字切开、
       断成 3 行（普查里唯一一条「异常断行」就是它）。文件名不是长单词，
       该**单行省略**；完整值放 title 里，悬停能看全。
       路径也不再整条铺开：卡片只需要知道「在哪个目录、多大」，
       完整路径同样进 title。 */
    .media-name {
      font-size: 0.75rem;
      font-weight: 600;
      line-height: 1.4;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .media-meta {
      margin-top: 0.125rem;
      font-size: 0.6875rem;
      color: var(--text-3);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    /* 一条细分隔线：把「只看/复制」和「改名/删除」分开 —— 五个同权重图标一排，
       不知道哪个会改仓库 */
    .media-ops-sep {
      width: 1px;
      align-self: stretch;
      margin: 0.25rem 0.125rem;
      background: var(--line-soft);
    }
    .media-ops {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem;
      margin-top: 0.5rem;
    }
    /* ── 图片库的操作图标 ────────────────────────────────────────
       "不要浅色容器、颜色交给图标"是**全局**规矩，写在 admin.css 的
       「纯图标按钮不要浅色容器」那一节（编辑器工具栏、导航 ↑↓✕、说说的定位
       按钮全部一起生效）。这里只留这一页特有的尺寸：28px 见方、图标 1rem。 */
    .media-ops .btn-icon-only,
    .media-ops .btn-danger-sm.btn-icon-only {
      padding: 0;
      width: 1.75rem;
      height: 1.75rem;
      min-height: 24px; /* 触控下限 */
      border-radius: 0.5rem;
    }
    .media-ops .btn-icon-only svg {
      width: 1rem;
      height: 1rem;
    }

    /* ===== 预览浮层 ===== */
    .media-lightbox {
      position: fixed;
      inset: 0;
      z-index: 60;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      background: color-mix(in oklab, #000 72%, transparent);
      backdrop-filter: blur(4px);
    }
    .media-lightbox img {
      max-width: 100%;
      max-height: 82vh;
      border-radius: var(--radius-large);
      background: var(--card-bg);
    }
    .media-lightbox .lb-bar {
      position: absolute;
      top: 1.25rem;
      right: 1.25rem;
      display: flex;
      gap: 0.5rem;
    }
    .media-lightbox .lb-info {
      position: absolute;
      left: 1.25rem;
      bottom: 1.25rem;
      right: 1.25rem;
      font-size: 0.75rem;
      color: rgb(255 255 255 / 0.85);
      word-break: break-all;
    }
  </style>
</head>
<body class={adminBodyClass}>

  <div id="admin-main">
    <AdminTopBar title="图片库" />

    <div class="container">
      <div class="card">
        <div class="page-lead">
          <span class="lead-icon" set:html={uiIcon("fluent-color:image-24")} />
          <span>
            仓库里 <code>public/images/</code> 下的所有图片都在这儿。可以<b>预览大图、改名、删除</b>，
            也可以直接<b>复制 Markdown</b> 贴进文章或说说。上传支持<b>点选、拖到页面任意位置、Ctrl+V 粘贴</b>三种。
            上传后要等 Cloudflare 重新构建（一两分钟）站上才看得到。
          </span>
        </div>

        <div class="media-tools">
          <button class="btn btn-primary" type="button" onclick="pickFiles()">
            <span class="admin-i" set:html={ICONS.upload} />上传图片
          </button>
          <input type="file" id="file-input" accept="image/*" multiple class="hidden" />
          <button class="btn" type="button" onclick="loadAll(true)">
            <span class="admin-i" set:html={ICONS.refresh} />刷新
          </button>
          <span class="spacer"></span>
          <input type="search" class="input-single search" id="media-search" placeholder="搜文件名…" oninput="renderMedia()" />
        </div>

        {/* 批量条（2026-10-04 加）：58 张图要清几张时不用一张张点删除。
            样式与文章列表共用（admin.css 的 .bulk-bar），平时 hidden。 */}
        <div class="bulk-bar" id="media-bulk">
          <label class="checkbox-row compact">
            <input type="checkbox" id="media-all" onchange="mediaToggleAll(this.checked)" />
            全选
          </label>
          <span class="bulk-count" id="media-bulk-count"></span>
          <span class="spacer"></span>
          {/* 批量复制（2026-10-04 加）：写一篇要用三五张图的文章时，一张张点
              「复制 Markdown」再拼起来太费事 —— 勾完一次复制，一行一张。 */}
          <button type="button" class="btn btn-sm" id="media-bulk-copy" onclick="mediaBulkCopy()">复制 Markdown</button>
          <button type="button" class="btn btn-sm bulk-danger" id="media-bulk-del" onclick="mediaBulkDelete()">删除所选</button>
          <button type="button" class="btn btn-sm btn-ghost" onclick="mediaClear()">取消</button>
        </div>

        <div class="media-drop" id="media-drop">
          <div id="media-list"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="toast" id="toast"></div>
  <div id="lightbox-root"></div>

  <script is:inline src="/js/admin-github.js"></script>
  {/* 图标走属性传进来：SVG 字符串里有引号，直接写进脚本正文会打架（posts.astro 同款做法）。
      ⚠️ 别用 `define:vars` 另开一个 <script> —— 两个 is:inline 脚本之间不共享变量。 */}
  <script is:inline data-target={JSON.stringify(target)} data-icons={JSON.stringify(ICONS)}>
    var _script = document.currentScript;
    var T = JSON.parse(_script.getAttribute("data-target") || "{}");
    var IC = JSON.parse(_script.getAttribute("data-icons") || "{}");

    // ===== 工具 =====
    function $(id) { return document.getElementById(id); }
    var toastTimer = null;
    function toast(msg, type) {
      var el = $("toast");
      el.textContent = msg;
      el.className = "toast " + type + " show";
      clearTimeout(toastTimer);
      toastTimer = setTimeout(function () { el.className = "toast"; }, 3200);
    }
    function setStatus(ok, text) {
      $("status-dot").className = "status-dot " + (ok ? "ok" : "err");
      $("status-text").textContent = text;
    }
    function esc(s) { return String(s == null ? "" : s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;"); }
    /** /images/covers/x.jpg → covers（卡片副行只显示所在目录，不铺整条路径） */
    function dirOf(path) { var a = String(path || "").split("/"); return a.length > 2 ? a[a.length - 2] : "images"; }
    function copyText(text, what) {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(function () {
          toast("已复制" + what + "：" + text, "ok");
        }, function () { window.prompt("复制这段：", text); });
      } else {
        window.prompt("复制这段：", text);
      }
    }
    function kb(size) {
      if (typeof size !== "number") return "";
      return size < 1024 * 1024 ? Math.round(size / 1024) + " KB" : (size / 1024 / 1024).toFixed(1) + " MB";
    }

    /** 仓库路径 public/images/... → 站上地址 /images/... */
    function publicUrl(path) { return "/" + String(path).replace(/^public\//, ""); }
    function isImage(name) { return /\.(png|jpe?g|gif|webp|avif|svg|bmp|tiff?)$/i.test(name); }

    // ===== 数据 =====
    var all = [];          // {name, path, sha, size, url, fresh}
    function opt(path) {
      return { owner: T.owner, repo: T.repo, branch: T.branch, path: path };
    }

    /** 递归列目录，最多三层（uploads / posts/<slug> / covers 都够用） */
    function walk(dir, depth) {
      return WBGitHub.listDir(opt(dir)).then(function (items) {
        var out = [];
        var chain = Promise.resolve();
        items.forEach(function (it) {
          if (it.type === "dir") {
            if (depth < 3) {
              chain = chain.then(function () {
                return walk(it.path, depth + 1).then(function (sub) { out = out.concat(sub); });
              });
            }
          } else if (isImage(it.name)) {
            out.push({ name: it.name, path: it.path, sha: it.sha, size: it.size, url: publicUrl(it.path), fresh: false });
          }
        });
        return chain.then(function () { return out; });
      });
    }

    function loadAll(announce) {
      setStatus(true, "正在读取…");
      return walk(T.root, 1)
        .then(function (list) {
          // 新传的排前面，其余按路径倒序（日期戳文件名，倒序≈新的在前）
          list.sort(function (a, b) { return b.path < a.path ? -1 : b.path > a.path ? 1 : 0; });
          all = list;
          // 数据重读了：搜索词可能已经变了，所以分页从头开始（下面 renderMedia 靠这个判断）
          shown = PAGE;
          lastKw = null;
          setStatus(true, "已连接 · " + all.length + " 张");
          renderMedia();
          if (announce) toast("已刷新，共 " + all.length + " 张", "ok");
        })
        .catch(function (e) {
          setStatus(false, "读取失败");
          $("media-list").innerHTML =
            '<div class="empty-state"><div class="icon">' + IC.empty + '</div><p>图片读不出来：' +
            esc(e && e.message ? e.message : e) + '</p></div>';
        });
    }

    // ===== 分批渲染（2026-10-05）=====
    // 原来 58 张（以后更多）一次性 innerHTML 铺开：DOM 一多，选中态、缩略图
    // 一次性解码，首屏明显卡。改成一次渲染 PAGE 张，底下给一条"再加载"。
    // 搜索词一变就退回第一页；数据重读也一样。
    var PAGE = 24;
    var shown = PAGE;
    var lastKw = null;

    function renderMedia() {
      var kw = ($("media-search").value || "").trim().toLowerCase();
      // 换了个搜索词 = 换了一批图，分页从头开始
      if (kw !== lastKw) { lastKw = kw; shown = PAGE; }
      var list = kw ? all.filter(function (it) { return it.path.toLowerCase().indexOf(kw) >= 0; }) : all;
      var box = $("media-list");
      if (!all.length) {
        box.innerHTML = '<div class="empty-state"><div class="icon">' + IC.empty + '</div><p>这个目录里还没有图片，先传一张</p></div>';
        mediaSyncBulk();
        return;
      }
      if (!list.length) {
        box.innerHTML = '<div class="empty-state"><div class="icon">' + IC.search + '</div><p>没找到名字里含「' + esc(kw) + '」的图片</p></div>';
        mediaSyncBulk();
        return;
      }
      var slice = list.slice(0, shown);
      box.innerHTML = '<div class="media-grid">' + slice.map(function (it) {
        var url = it.blobUrl || it.url;
        return '' +
          '<div class="media-item' + (pickedM[it.path] ? ' picked' : '') + '">' +
            '<div class="media-thumb" onclick="openLightbox(\'' + esc(it.path) + '\')">' +
              // 勾选框：批量用。stopPropagation 免得点它顺手把大图也打开了。
              '<label class="pick" title="选中这张" onclick="event.stopPropagation()">' +
                '<input type="checkbox" data-pick="' + esc(it.path) + '"' + (pickedM[it.path] ? ' checked' : '') + ' />' +
              '</label>' +
              // ⚠️ draggable="false" 不能省：<img> 默认可拖，一拖浏览器就把它当成
              //    "拖着一个文件"，落回本页会被下面的整页拖放区接住 → 又上传一遍
              //    （而且文件名带时间戳，于是仓库里多出一份）。用户以为只是拖一下看看。
              '<img src="' + esc(url) + '" alt="' + esc(it.name) + '" loading="lazy" draggable="false" />' +
              (it.fresh ? '<span class="media-flag">刚上传，重建后站上生效</span>' : '') +
            '</div>' +
            '<div class="media-body">' +
              '<div class="media-name" title="' + esc(it.name) + '">' + esc(it.name) + '</div>' +
              // 副行给「在哪个目录 + 多大」，不是整条 /images/... 路径 —— 卡片宽度有限，
              // 铺整条路径只会被截断；完整路径放 title，想核对悬停即可
              '<div class="media-meta" title="' + esc(publicUrl(it.path)) + '">' + esc(dirOf(it.path)) + (kb(it.size) ? ' · ' + kb(it.size) : '') + '</div>' +
              '<div class="media-ops">' +
                '<button class="btn btn-sm btn-icon-only" title="预览大图" onclick="openLightbox(\'' + esc(it.path) + '\')">' + IC.zoom + '</button>' +
                '<button class="btn btn-sm btn-icon-only" title="复制 Markdown（可直接贴进正文）" onclick="copyMd(\'' + esc(it.path) + '\')">' + IC.copy + '</button>' +
                '<button class="btn btn-sm btn-icon-only" title="复制站上地址" onclick="copyPath(\'' + esc(it.path) + '\')">' + IC.link + '</button>' +
                // 分隔线：前三个是「看一眼 / 复制 Markdown / 拿地址」，后两个会改仓库内容
                '<span class="media-ops-sep" aria-hidden="true"></span>' +
                '<button class="btn btn-sm btn-icon-only" title="改名" onclick="renameItem(\'' + esc(it.path) + '\')">' + IC.rename + '</button>' +
                '<button class="btn-danger-sm btn-icon-only" title="删除" onclick="deleteItem(\'' + esc(it.path) + '\')">' + IC.del + '</button>' +
              '</div>' +
            '</div>' +
          '</div>';
      }).join("") + '</div>';
      // 底下一条：已显示多少 / 共多少，多的给个按钮
      if (list.length > PAGE) {
        box.innerHTML +=
          '<div class="media-more">' +
            '<span>已显示 ' + slice.length + ' / ' + list.length + ' 张</span>' +
            (shown < list.length
              ? '<button type="button" class="btn btn-sm" onclick="mediaMore()">再加载 ' +
                Math.min(PAGE, list.length - shown) + ' 张</button>'
              : '') +
          '</div>';
      }
      mediaSyncBulk();
    }

    window.mediaMore = function () {
      shown += PAGE;
      renderMedia();
    };

    // ===== 批量选择 / 批量删除（2026-10-04）=====
    // pickedM[path]=true 表示勾上了；搜索/刷新后仍保留。
    var pickedM = {};

    function mediaSyncBulk() {
      var bar = $("media-bulk");
      if (!bar) return;
      var n = Object.keys(pickedM).length;
      bar.classList.toggle("on", n > 0);
      if (n) $("media-bulk-count").textContent = "已选 " + n + " 张";
      // ⚠️ 「全选」的判定必须按**过滤后的全部**算，不能只数已渲染的那几张：
      //    分批渲染之后屏幕上只有 24 张，剩下的还没进 DOM，按 DOM 数会得出
      //    "全选上了"（其实后面的没勾）——「全选」的作用对象一直是整个结果集。
      var vis = visible();
      var allChecked = vis.length > 0 && vis.every(function (it) { return !!pickedM[it.path]; });
      var box = $("media-all");
      if (box) {
        box.checked = allChecked;
        box.indeterminate = !allChecked && vis.some(function (it) { return !!pickedM[it.path]; });
      }
    }

    window.mediaToggleAll = function (checked) {
      visible().forEach(function (it) {
        if (checked) pickedM[it.path] = true; else delete pickedM[it.path];
      });
      renderMedia();
    };
    window.mediaClear = function () { pickedM = {}; renderMedia(); };

    /** 当前可见（搜索过滤后的）那些 */
    function visible() {
      var kw = ($("media-search").value || "").trim().toLowerCase();
      return kw ? all.filter(function (it) { return it.path.toLowerCase().indexOf(kw) >= 0; }) : all;
    }

    window.mediaBulkDelete = function () {
      var paths = Object.keys(pickedM);
      if (!paths.length) return;
      var names = paths.map(function (p) { var it = find(p); return it ? it.name : p; });
      var head = names.slice(0, 5).join("\n");
      if (!window.confirm(
        "确定删除这 " + paths.length + " 张图？\n\n" + head +
        (names.length > 5 ? "\n…（共 " + names.length + " 张）" : "") +
        "\n\n删掉就找不回来了（正文里引用它们的地方会变成裂图）。"
      )) return;
      var btn = $("media-bulk-del");
      if (btn) { btn.disabled = true; btn.textContent = "删除中…"; }
      var failed = [];
      var chain = Promise.resolve();
      paths.forEach(function (path) {
        chain = chain.then(function () {
          var it = find(path);
          if (!it) throw new Error("列表里找不到 " + path);
          return WBGitHub.deleteFile({ owner: T.owner, repo: T.repo, branch: T.branch, path: it.path, sha: it.sha, message: "删除图片：" + it.name });
        }).catch(function (e) { failed.push(path + "：" + (e && e.message ? e.message : e)); });
      });
      chain.then(function () {
        if (btn) { btn.disabled = false; btn.textContent = "删除所选"; }
        var okCount = paths.length - failed.length;
        pickedM = {};
        toast(failed.length ? "删了 " + okCount + " 张，" + failed.length + " 张失败" : "已删除 " + okCount + " 张 ✓（重建后生效）", failed.length ? "err" : "ok");
        if (failed.length) console.warn("批量删除没成功的：", failed);
        loadAll();
      });
    };

    // 勾选：事件委托（列表每次重绘都会换 DOM）
    $("media-list").addEventListener("change", function (e) {
      var t = e.target;
      if (!t || !t.getAttribute || !t.getAttribute("data-pick")) return;
      var path = t.getAttribute("data-pick");
      if (t.checked) pickedM[path] = true; else delete pickedM[path];
      var card = t.closest(".media-item");
      if (card) card.classList.toggle("picked", t.checked);
      mediaSyncBulk();
    });

    function find(path) {
      for (var i = 0; i < all.length; i++) if (all[i].path === path) return all[i];
      return null;
    }

    /**
     * 批量复制 Markdown：一行一张图。
     * 顺序按**屏幕上看到的**来（visible() 是过滤+排序后的那份），
     * 不按对象键的顺序 —— 否则贴进正文的图和勾选时的顺序对不上。
     * 只复制当前还看得见的勾选项：被搜索词筛掉的勾选不该混进来。
     */
    window.mediaBulkCopy = function () {
      if (!Object.keys(pickedM).length) return;
      var ordered = visible().filter(function (it) { return !!pickedM[it.path]; });
      if (!ordered.length) return;
      var md = ordered.map(function (it) { return "![](" + publicUrl(it.path) + ")"; }).join("\n");
      var what = ordered.length + " 张图的 Markdown（一行一张，直接贴进正文）";
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(md).then(
          function () { toast("已复制 " + what, "ok"); },
          function () { window.prompt("复制这段：", md); },
        );
      } else {
        window.prompt("复制这段：", md);
      }
    };

    // ===== 操作 =====
    window.copyMd = function (path) {
      var it = find(path); if (!it) return;
      copyText("![](" + publicUrl(it.path) + ")", " Markdown");
    };
    window.copyPath = function (path) {
      var it = find(path); if (!it) return;
      copyText(publicUrl(it.path), "地址");
    };
    window.openLightbox = function (path) {
      var it = find(path); if (!it) return;
      var url = it.blobUrl || it.url;
      $("lightbox-root").innerHTML =
        '<div class="media-lightbox" onclick="closeLightbox()">' +
          '<div class="lb-bar">' +
            '<button class="btn btn-sm" onclick="event.stopPropagation();copyMd(\'' + esc(it.path) + '\')">复制 Markdown</button>' +
            '<button class="btn btn-sm" onclick="event.stopPropagation();closeLightbox()">' + IC.close + '</button>' +
          '</div>' +
          // ⚠️ 大图也要 draggable="false"：这一张是**动态插进来的**，不在 #media-list 里，
          //    只在那一片上禁拖管不到它 —— 2026-10-05 站长第二次报"拖一下就多传一份"，
          //    就是从这个浮层里把图拖了出去。
          '<img src="' + esc(url) + '" alt="' + esc(it.name) + '" draggable="false" onclick="event.stopPropagation()" />' +
          '<div class="lb-info">' + esc(publicUrl(it.path)) + (kb(it.size) ? ' · ' + kb(it.size) : '') +
            ' · <a href="' + esc(url) + '" target="_blank" rel="noopener" style="color:inherit">新标签打开</a></div>' +
        '</div>';
    };
    window.closeLightbox = function () { $("lightbox-root").innerHTML = ""; };

    window.renameItem = function (path) {
      var it = find(path); if (!it) return;
      var next = window.prompt("改成什么名字？（只改文件名，目录不动）", it.name);
      if (!next) return;
      next = next.trim();
      if (!next || next === it.name) return;
      if (!isImage(next)) { toast("文件名要带图片后缀（.png / .jpg / .webp …）", "err"); return; }
      var newPath = it.path.replace(/[^/]+$/, next);
      toast("正在改名…", "");
      WBGitHub.getFile(opt(it.path))
        .then(function (f) {
          if (!f) throw new Error("原文件读不到了");
          // GitHub 没有"改名"接口：写一份新的 + 删掉旧的
          return WBGitHub.putFile({
            owner: T.owner, repo: T.repo, branch: T.branch,
            path: newPath, content: f.content, sha: null, message: "图片改名：" + it.name + " → " + next
          }).then(function () {
            return WBGitHub.deleteFile({ owner: T.owner, repo: T.repo, branch: T.branch, path: it.path, sha: it.sha, message: "图片改名（删旧）：" + it.name });
          });
        })
        .then(function () {
          toast(
            WBGitHub.isLocalPreview ? "本机预览里改了名 —— 没进仓库，线上还是原名" : "改名完成 ✓（重建后生效）",
            WBGitHub.isLocalPreview ? "err" : "ok",
          );
          return loadAll();
        })
        .catch(function (e) { toast("改名失败：" + (e && e.message ? e.message : e), "err"); });
    };

    window.deleteItem = function (path) {
      var it = find(path); if (!it) return;
      if (!window.confirm("确定删除这张图？\n\n" + publicUrl(it.path) + "\n\n删掉就找不回来了（正文里引用它的地方会变成裂图）。")) return;
      toast("正在删除…", "");
      WBGitHub.deleteFile({ owner: T.owner, repo: T.repo, branch: T.branch, path: it.path, sha: it.sha, message: "删除图片：" + it.name })
        .then(function () { toast("已删除 ✓（重建后生效）", "ok"); return loadAll(); })
        .catch(function (e) { toast("删除失败：" + (e && e.message ? e.message : e), "err"); });
    };

    // ===== 上传 =====
    window.pickFiles = function () { $("file-input").click(); };
    $("file-input").addEventListener("change", function () {
      // ⚠️ 先把文件取成真正的数组再清空 input：清空后 files 会变成空列表
      var files = Array.prototype.slice.call(this.files || []);
      this.value = "";
      files.forEach(uploadOne);
    });

    function stampName(ext) {
      var d = new Date();
      function p(n) { return (n < 10 ? "0" : "") + n; }
      return "" + d.getFullYear() + p(d.getMonth() + 1) + p(d.getDate()) + "-" +
        p(d.getHours()) + p(d.getMinutes()) + p(d.getSeconds()) + "-" +
        Math.random().toString(36).slice(2, 6) + "." + ext;
    }
    function extOf(blob, fallback) {
      var t = (blob && blob.type || "").toLowerCase();
      if (t.indexOf("webp") >= 0) return "webp";
      if (t.indexOf("jpeg") >= 0 || t.indexOf("jpg") >= 0) return "jpg";
      if (t.indexOf("png") >= 0) return "png";
      if (t.indexOf("gif") >= 0) return "gif";
      if (t.indexOf("avif") >= 0) return "avif";
      return (fallback || "png").replace(/^\./, "");
    }
    function b64FromBytes(bytes) {
      var s = "";
      for (var i = 0; i < bytes.length; i += 0x8000) {
        s += String.fromCharCode.apply(null, bytes.subarray(i, i + 0x8000));
      }
      return btoa(s);
    }

    /** 压到最长边 1600、质量 0.82；压不动（比如 gif/svg）就原样传 */
    function compressImage(file) {
      if (!/^image\//.test(file.type) || /svg|gif/.test(file.type)) return Promise.resolve(file);
      // ⚠️ 已经是我们压过的 webp（小图）就**不再压第二次**（2026-10-05）：
      //    二次有损压缩会改掉字节，于是"同一张图再拖一次"算出的校验值和仓库里那份
      //    对不上，去重永远命中不了 —— 还是多一份。压一次就够，也别把画质再削一刀。
      if (/webp/.test(file.type) && file.size <= 500 * 1024) return Promise.resolve(file);
      return new Promise(function (resolve) {
        var img = new Image();
        var url = URL.createObjectURL(file);
        img.onload = function () {
          var scale = Math.min(1, 1600 / Math.max(img.width, img.height));
          var w = Math.round(img.width * scale), h = Math.round(img.height * scale);
          var canvas = document.createElement("canvas");
          canvas.width = w; canvas.height = h;
          canvas.getContext("2d").drawImage(img, 0, 0, w, h);
          URL.revokeObjectURL(url);
          canvas.toBlob(function (blob) { resolve(blob || file); }, "image/webp", 0.82);
        };
        img.onerror = function () { URL.revokeObjectURL(url); resolve(file); };
        img.src = url;
      });
    }

    /**
     * 按内容找"仓库里已经有一模一样的这张"。
     *
     * 校验值的算法在 `public/js/admin-github.js` 的 `WBGitHub.blobShaOf`（共用，
     * 文章编辑器那一页也要用同一把尺子）—— 它算的是 **git blob 校验值**，
     * 和仓库里每张图的 `it.sha` 同一种值，两边才能直接比。
     * 拿不到 crypto.subtle 时会返回 null，这里就当"没撞上"，退回按文件名判重。
     */
    function shaOfBlob(blob) {
      return WBGitHub.blobShaOf(blob);
    }
    function findBySha(sha) {
      if (!sha) return null;
      for (var i = 0; i < all.length; i++) if (all[i].sha === sha) return all[i];
      return null;
    }
    /** 把列表里那一张闪一下，顺带复制它的 Markdown —— 既然已经有，就用现成的 */
    function flashItem(it) {
      var box = document.querySelector('[data-pick="' + it.path.replace(/"/g, "") + '"]');
      var card = box && box.closest ? box.closest(".media-item") : null;
      if (!card) return;
      card.classList.remove("dup-flash");
      // 读一次布局再挂类，动画才会重新跑（连着两次拖同一张也能各闪一次）
      void card.offsetWidth;
      card.classList.add("dup-flash");
      card.scrollIntoView({ block: "center", behavior: "smooth" });
    }

    function uploadOne(file, quiet) {
      if (!/^image\//.test(file.type)) { toast("「" + file.name + "」不是图片，跳过", "err"); return; }
      toast("正在检查 " + file.name + " …", "");
      // ⚠️ 2026-10-05 改：**按内容**判重，不再只比文件名。
      //    仓库里的图都是上传时生成的时间戳名（20261005-…webp），你本地那张叫
      //    「封面.jpg」—— 名字永远对不上，于是"拖一张已经传过的图"就又多一份。
      //    现在量两份校验值：原始文件一份、压缩后的字节一份，任一份和仓库里已有的
      //    某张相同，就认定"这张已经有了"，直接不传。
      var rawP = shaOfBlob(file);
      var compP = compressImage(file);
      Promise.all([rawP, compP])
        .then(function (r) {
          var blob = r[1];
          return shaOfBlob(blob).then(function (compSha) {
            return { blob: blob, dup: findBySha(r[0]) || findBySha(compSha) };
          });
        })
        .then(function (r) {
          if (r.dup) {
            toast("这张图仓库里已经有了（" + publicUrl(r.dup.path) + "）—— 没有再传第二份，Markdown 已复制", "ok");
            flashItem(r.dup);
            copyText("![](" + publicUrl(r.dup.path) + ")", "它自己的 Markdown");
            return;
          }
          // 内容没撞上，但**同名**的有一张 —— 那多半是"想替换"的误操作，问一句
          var nameDup = all.filter(function (it) { return it.name === file.name; })[0];
          if (nameDup && !quiet) {
            if (!window.confirm("仓库里已经有同名的《" + file.name + "》。\n\n再传一次不会覆盖它，会多出一份新的（文件名带时间戳）。继续？")) return;
          }
          toast("正在上传 " + file.name + " …", "");
          var ext = extOf(r.blob, file.name);
          var name = stampName(ext);
          var path = T.uploadDir + "/" + name;
          return r.blob.arrayBuffer().then(function (buf) {
            return WBGitHub.putFile({
              owner: T.owner, repo: T.repo, branch: T.branch,
              path: path, content: b64FromBytes(new Uint8Array(buf)),
              message: "上传图片：" + name
            }).then(function () {
              // 刚传的这张站上还没有，用本地 blob 先顶上，标一句等重建
              all.unshift({
                name: name, path: path, sha: "", size: r.blob.size,
                url: publicUrl(path), fresh: true, blobUrl: URL.createObjectURL(r.blob)
              });
              setStatus(true, "已连接 · " + all.length + " 张");
              renderMedia();
              toast(
                WBGitHub.isLocalPreview
                  ? "这张图只放在本机预览里 —— 没进仓库，线上看不到。要真用它，请在线上后台重传一次"
                  : "上传好了 ✓ 复制 Markdown 就能贴进正文（重建后站上生效）",
                WBGitHub.isLocalPreview ? "err" : "ok",
              );
            });
          });
        })
        .catch(function (e) { toast("上传失败：" + (e && e.message ? e.message : e), "err"); });
    }

    // ===== 拖放 / 粘贴 =====
    // ⚠️ 2026-10-04 改：原来只在 #media-drop（那块虚线框）上接文件。
    //    实测（_gen/_图片库拖放探查.mjs）拖到**工具条 / 页头 / 侧栏**上时没有任何人 preventDefault，
    //    浏览器就按默认行为**直接打开你拖进来的那张图** —— 拖歪一点整页就被顶掉。
    //    现在改成「进页面就接、哪都能放」：
    //      · 只在拖的是**文件**时接管，拖文字/链接照旧走浏览器默认（别乱拦）
    //      · dragenter/dragleave 用计数器，鼠标掠过子元素不会闪
    var drop = $("media-drop");
    var dragDepth = 0;
    // ⚠️ 页面内拖拽（拖缩略图、拖选中的文字/链接）**不算**"往这儿传文件"。
    //    浏览器对内拖的 dataTransfer 里也可能带 Files（拖一张 <img> 就是），
    //    不设这道闸门的话，拖一下自己的图 = 又传一份（2026-10-04 站长报的问题）。
    var internalDrag = false;
    // ⚠️ 2026-10-05 改：禁拖从"缩略图那一片"提到**整个文档**。
    //    漏网的就是预览浮层里那张大图 —— 它是点开预览时才插进 DOM 的，
    //    不在 #media-list 里，上一轮那条监听根本管不到（实测：draggable 是空的、
    //    dragstart 也没人拦，一拖就起来）。现在凡是**页面里的图片或链接**一律不让起拖，
    //    以后新加的图也自动跟着走。
    //    ⚠️ 另一半同样要紧：被这里拦下的 dragstart **不能**置 internalDrag ——
    //    拖既然没真启动，就永远等不到 dragend，那个标志会一直卡在 true，
    //    之后从系统拖文件进来就传不进去了（"该传的传不了"）。
    document.addEventListener("dragstart", function (e) {
      var t = e.target;
      if (t && t.closest && t.closest("img, a")) { e.preventDefault(); return; }
      internalDrag = true;
    });
    document.addEventListener("dragend", function () { internalDrag = false; dragDepth = 0; if (drop) drop.classList.remove("over"); });

    function dragHasFiles(e) {
      if (internalDrag) return false;
      var t = e.dataTransfer;
      if (!t) return false;
      var types = t.types || [];
      if (Array.prototype.indexOf.call(types, "Files") < 0) return false;
      // 页面内拖拽（跨页拖也一样）会带 uri-list / html —— 那不是"从系统拖文件过来"
      if (Array.prototype.indexOf.call(types, "text/uri-list") >= 0) return false;
      if (Array.prototype.indexOf.call(types, "text/html") >= 0) return false;
      return true;
    }
    function dropOff() { dragDepth = 0; if (drop) drop.classList.remove("over"); }
    document.addEventListener("dragenter", function (e) {
      if (!dragHasFiles(e)) return;
      dragDepth++;
      if (drop) drop.classList.add("over");
    });
    document.addEventListener("dragover", function (e) {
      if (!dragHasFiles(e)) return;
      e.preventDefault();                       // 不拦就走浏览器默认（打开这张图）
      if (e.dataTransfer) e.dataTransfer.dropEffect = "copy";
    });
    document.addEventListener("dragleave", function (e) {
      if (!dragHasFiles(e)) return;
      dragDepth = Math.max(0, dragDepth - 1);
      if (dragDepth === 0 && drop) drop.classList.remove("over");
    });
    document.addEventListener("drop", function (e) {
      if (!dragHasFiles(e)) return;
      e.preventDefault();
      dropOff();
      var files = e.dataTransfer && e.dataTransfer.files;
      if (files && files.length) {
        Array.prototype.slice.call(files).forEach(function (f) {
          if (/^image\//.test(f.type)) uploadOne(f);
        });
      }
    });
    document.addEventListener("paste", function (e) {
      var items = e.clipboardData && e.clipboardData.items;
      if (!items) return;
      for (var i = 0; i < items.length; i++) {
        if (items[i].type && items[i].type.indexOf("image/") === 0) {
          var f = items[i].getAsFile();
          if (f) { e.preventDefault(); uploadOne(f); return; }
        }
      }
    });
    document.addEventListener("keydown", function (e) { if (e.key === "Escape") closeLightbox(); });

    // ===== 启动 =====
    loadAll();
  </script>
</body>
</html>
