---
// 导航菜单 —— 读写仓库里的 src/data/navLinks.json
// 保存后提交进仓库，Cloudflare 重新构建，全站导航栏跟着变。
import AdminTheme from "@/components/admin/AdminTheme.astro";
import AdminAuthGate from "@/components/admin/AdminAuthGate.astro";
import AdminTopBar from "@/components/admin/AdminTopBar.astro";
import { adminBodyClass, adminHtmlClass } from "@/components/admin/adminShell";
import { externalPostsConfig } from "@/config/externalPostsConfig";
// 后台不走博客 Layout，也就没有 iconify 运行时，图标用构建期内联的 SVG
import { uiIcon } from "@/constants/ui-icons";

/** 这个页面读写仓库里的哪个文件 */
const target = {
	owner: externalPostsConfig.owner,
	repo: externalPostsConfig.repo,
	branch: externalPostsConfig.branch,
	path: "src/data/navLinks.json",
};

/**
 * 图标下拉的候选。
 *
 * ⚠️ 为什么只给清单、不给自由填写：导航栏图标一律走**单色** material-symbols
 *    （彩色图标在"一排横向扫过"的导航栏上显杂，见 main.css 里 #navbar 那条规则）。
 *    清单里的每一个名字都核对过确实存在于图标集里 —— 写一个不存在的名字，
 *    构建时取不到图形，前台就是一个空白占位，而这种错在后台界面上看不出来。
 *
 *    要加图标：确认 `material-symbols:<名字>` 在图标集里存在，再加进这里。
 */
const iconOptions = [
	["mdi:wechat", "微信"],
	["material-symbols:home", "主页"],
	["material-symbols:article", "文章"],
	["material-symbols:archive", "归档"],
	["material-symbols:folder-open-rounded", "分类"],
	["material-symbols:label", "标签"],
	["material-symbols:bolt", "动态"],
	["material-symbols:bolt-outline", "动态·描边"],
	["material-symbols:chat", "留言"],
	["material-symbols:movie", "追番"],
