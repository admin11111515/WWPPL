---
// 笔记管理页面 - 往已有笔记本里写笔记，通过 GitHub Gist 存储
import AdminTheme from "@/components/admin/AdminTheme.astro";
import AdminAuthGate from "@/components/admin/AdminAuthGate.astro";
import AdminTopBar from "@/components/admin/AdminTopBar.astro";
import { adminBodyClass, adminHtmlClass } from "@/components/admin/adminShell";
import { externalNotebooksConfig } from "@/config/externalNotebooksConfig";
// 笔记本身存 Gist，但**图片必须进仓库**（public/images/），所以这里也要仓库信息
import { externalPostsConfig } from "@/config/externalPostsConfig";
// 后台不走博客 Layout，也就没有 iconify 运行时，图标用构建期内联的 SVG
import { uiIcon } from "@/constants/ui-icons";

// 从配置读取笔记本列表
const notebookList = Object.keys(externalNotebooksConfig.notebookGists).sort();

// 模板按钮的图标也在这里换成内联 SVG：
// 配置里的 icon 现在写的是图标名（material-symbols:xxx），
// 万一有人填了取不到的名字，就退回原值，按钮至少还有东西显示。
const templatesForAdmin = (externalNotebooksConfig.templates || []).map(
	(t) => ({
		...t,
		svg: uiIcon(t.icon) || t.icon,
	}),
);
---

<html lang="zh-CN" class={adminHtmlClass}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>笔记 · 后台</title>
  {/* 后台是站长自用界面，不该出现在搜索结果里（sitemap 中同样已剔除） */}
  <meta name="robots" content="noindex, nofollow" />
  {/* 样式、字体、主题色都来自这里，页面自己的样式放在它后面 */}
  <AdminTheme />
  <AdminAuthGate />
  {/* 窗格布局记在本机；要在样式生效**之前**打到 <html> 上，
      否则会先按默认画一遍"分栏"再跳到上次那档，闪一下。
      同一套做法见 src/pages/admin/posts.astro（那边键名带 posts- 前缀，互不干扰）。 */}
  <script is:inline>
    (function () {
      try {
        var m = localStorage.getItem("wb-notebooks-pane-mode");
        if (m === "edit" || m === "preview" || m === "split") document.documentElement.setAttribute("data-notebooks-pane", m);
      } catch (e) {}
    })();
  </script>
  <style is:inline>
    /* ===== 只放这一页特有的排版，通用部分在 src/styles/admin.css ===== */

    /* 原来这里写着 `#admin-main { --admin-content-max: 760px }`（"这一页是窄栏内容"）——
       **它从来没生效过**：admin.css 打包成外链放在 <head> 最后，同特异性后写者胜，
       页面里所有 `#admin-main { --admin-content-max }` 全是死代码（七页皆然）。
       真按 760 收窄反而更糟：编辑器是左右两栏，每栏只剩 ~330px（一行 23 字）。
       所以这里不写宽度 —— 现在走全局那档 1280，靠下面的窗格三态把宽度让给正文。
       要改宽度得写 `#admin-main > .container`，原因见 admin.css「3. 宽度容器」。 */

    /* 窗格三态（2026-10-05，与文章页同一套做法）：默认「编辑」把整行给 Markdown，
       原来只有"左右各一半"一栏，正文只有 ~560px（一行 40 字）。 */
    @media (min-width: 980px) {
      html[data-notebooks-pane="edit"] #editor-container { grid-template-columns: minmax(0, 1fr); }
      html[data-notebooks-pane="edit"] #editor-container .editor-pane[data-pane="preview"] { display: none; }
      html[data-notebooks-pane="preview"] #editor-container { grid-template-columns: minmax(0, 1fr); }
      html[data-notebooks-pane="preview"] #editor-container .editor-pane[data-pane="edit"] { display: none; }
    }
    /* 「分栏」在窄屏没有意义（那边本来就只有一个窗格） */
    @media (max-width: 979px) {
      .seg-btn[data-mode-btn="split"] { display: none; }
    }

    /* ⚠️ .status-bar / .submit-row / .save-row / .draft-hint 已提到
          admin.css 共享层（第三遍：状态条统一成小药丸、操作区收进卡片底栏），
          这里不要重复定义 —— 页面 <style> 在 admin.css 之后加载，
          写了就是本地那份赢，改共享层会看着像没生效。 */

    /* ===== 笔记本标签 ===== */
    .notebook-tabs { display: flex; flex-wrap: wrap; gap: 0.375rem; margin-top: 0.75rem; }
    .notebook-tab {
      padding: 0.375rem 0.75rem;
      font-size: 0.8125rem;
      font-weight: 700;
      border: 1px solid var(--line);
      border-radius: var(--radius-full);
      background: var(--card-bg);
      color: var(--text-2);
      cursor: pointer;
      transition: all 0.15s;
    }
    .notebook-tab:hover { border-color: var(--primary); color: var(--btn-content); }
    /* 与博客 FilterTabs 的选中态一致：实心主色 + 白字 */
    .notebook-tab.active {
      background: var(--primary);
      border-color: var(--primary);
      color: #fff;
    }

    /* ===== 笔记列表 ===== */
    .entry-row {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 0.75rem;
      padding: 0.75rem 0.5rem;
      margin: 0 -0.5rem;
      border-bottom: 1px solid var(--line-soft);
      border-radius: var(--radius-md);
      transition: background-color 0.15s;
    }
    .entry-row:hover { background: var(--hover); }
    .entry-row:last-child { border-bottom: none; }
    .entry-info { flex: 1; min-width: 0; }
    .entry-title { font-size: 0.875rem; font-weight: 700; color: var(--text); }
    .entry-meta {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
      margin-top: 0.1875rem;
      font-size: 0.6875rem;
      color: var(--text-3);
    }
    .entry-meta .sep { opacity: 0.5; }
    .entry-preview {
      margin-top: 0.25rem;
      font-size: 0.8125rem;
      line-height: 1.65;
      color: var(--text-3);
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .entry-actions { display: flex; gap: 0.25rem; flex-shrink: 0; }
  </style>
</head>
<body class={adminBodyClass}>

  <div id="admin-main">
    {/* 这一页正文里已有独立的连接状态条，标题条上不再重复一次 */}
    <AdminTopBar title="笔记" />

    <div class="container">
      <!-- 连接状态 -->
      {/* 上次没有保存就离开时，把本地留存的草稿提示出来 */}
      <div class="restore-bar hidden" id="restore-bar">
        <span class="restore-icon" set:html={uiIcon("fluent-color:history-24")} />
        <span class="restore-text" id="restore-text"></span>
        <div class="restore-actions">
          <button class="btn btn-sm" onclick="restoreDraft()">恢复</button>
          <button class="btn btn-sm" onclick="discardDraft()">丢弃</button>
        </div>
      </div>


      <!-- 选择笔记本 -->
      <div class="card">
        <div class="field-label"><span class="icon" set:html={uiIcon("fluent-color:book-open-24")} /> 选择笔记本</div>
        <div class="notebook-tabs" id="notebook-tabs">
          {notebookList.map((name) => {
            const hasGist = externalNotebooksConfig.notebookGists?.[name];
            return (
              <button class="notebook-tab" data-notebook={name}>
                <span class="admin-i" set:html={uiIcon(hasGist ? "fluent-color:checkmark-circle-24" : "fluent-color:warning-24")} />{name}
              </button>
            );
          })}
        </div>
        <div style="margin-top:0.5rem;font-size:0.75rem;color:var(--text-3);">
          <span class="admin-i" set:html={uiIcon("fluent-color:warning-24")} /> = 未配置 Gist（首次保存自动创建，需手动填回配置） <span class="admin-i" set:html={uiIcon("fluent-color:checkmark-circle-24")} /> = 已配置
        </div>
      </div>

      <!-- 写笔记 -->
      <div class="card" id="editor-card">
        <div class="field-label"><span class="icon" set:html={uiIcon("fluent-color:clipboard-text-edit-24")} /> 写笔记 → <strong id="target-notebook" style="margin-left:0.25rem;">未选择</strong></div>
        <div class="field">
          <div class="field-label">快速模板</div>
          <div id="template-buttons" style="display:flex;gap:0.375rem;flex-wrap:wrap;"></div>
        </div>
        <div class="field">
          <div class="field-label">标题</div>
          <input type="text" class="input-single" id="entry-title" placeholder="笔记标题（可选）" />
        </div>
        <div class="field">
          <div class="field-label">日期</div>
          {/* 视觉上旁边有「日期」两个字，但那不是 label，读屏与自动化都认不出这个框是干嘛的 */}
          <input type="date" id="entry-date" aria-label="日期" />
        </div>
        <div class="field">
          <div class="field-label">内容（Markdown）</div>
          <div class="editor-container" id="editor-container" data-mobile-pane="edit">
            <div class="editor-pane" data-pane="edit">
              <div class="editor-pane-header">
                <span>编辑</span>
                {/* 三态分段：默认「编辑」整行给正文；「分栏」两边都要看时再切回来 */}
                <div class="seg">
                  <button type="button" class="seg-btn active" data-mode-btn="edit">编辑</button>
                  <button type="button" class="seg-btn" data-mode-btn="split">分栏</button>
                  <button type="button" class="seg-btn" data-mode-btn="preview">预览</button>
                </div>
                <div class="editor-toolbar">
                  <button class="toolbar-btn" onclick="insertMd('**','**')" title="加粗">B</button>
                  <button class="toolbar-btn" onclick="insertMd('*','*')" title="斜体">I</button>
                  <button class="toolbar-btn" onclick="insertMd('`','`')" title="行内代码">&lt;&gt;</button>
                  <button class="toolbar-btn" onclick="insertMd('\n```\n','\n```\n')" title="代码块" set:html={uiIcon("fluent-color:code-block-24")} />
                  <button class="toolbar-btn" onclick="insertMd('[','](url)')" title="链接" set:html={uiIcon("fluent-color:link-24")} />
                  <button class="toolbar-btn" onclick="insertMd('![','](url)')" title="插入图片链接" set:html={uiIcon("fluent-color:image-24")} />
                  {/* 2026-10-02：笔记以前插图只能手填链接 —— 接上仓库图片库（共用 admin-media.js） */}
                  <button class="toolbar-btn" onclick="uploadNoteImage()" title="上传图片" set:html={uiIcon("material-symbols:upload")} />
                  <button class="toolbar-btn" onclick="pickNoteImage()" title="从图片库选一张" set:html={uiIcon("material-symbols:add-photo-alternate")} />
                  <input type="file" id="note-img-file" accept="image/*" multiple hidden />
                  <button class="toolbar-btn" onclick="insertMd('> ','')" title="引用" set:html={uiIcon("material-symbols:format-quote")} />
                  <button class="toolbar-btn" onclick="insertMd('- ','')" title="列表" set:html={uiIcon("fluent-color:text-bullet-list-square-24")} />
                </div>
              </div>
              <textarea class="editor-textarea" id="content-input" placeholder="用 Markdown 写下你的笔记..."></textarea>
              <div class="editor-footer">
                <span id="content-counter">0 字</span>
                <span class="editor-hint">Ctrl+B 加粗 · Ctrl+S 保存 · Tab 缩进 · <b>图片可直接拖进来或 Ctrl+V</b> · <b>从 Word／网页复制的内容粘进来自动转格式</b></span>
              </div>
            </div>
            <div class="editor-pane" data-pane="preview">
              <div class="editor-pane-header">
                <span>预览</span>
                {/* 与编辑窗格同一组三态：切到「预览」后编辑窗格会整格藏起来，
                    那时候只能靠这一排切回去，所以两边都放一份。 */}
                <div class="seg">
                  <button type="button" class="seg-btn" data-mode-btn="edit">编辑</button>
                  <button type="button" class="seg-btn" data-mode-btn="split">分栏</button>
                  <button type="button" class="seg-btn active" data-mode-btn="preview">预览</button>
                </div>
              </div>
              <div class="preview-pane" id="preview-pane">
                <div class="empty-state" style="padding:2rem;"><p>开始编辑后预览内容</p></div>
              </div>
            </div>
          </div>
        </div>
        <div class="save-row">
          <button class="btn btn-primary" id="submit-btn" onclick="submitEntry()">保存笔记</button>
          <span class="draft-hint" id="draft-hint"></span>
        </div>
        {/* 样式与收起都在 admin.css 的 .edit-bar / .edit-bar.hidden：
            这里**不要**再写内联 display —— 内联会盖掉 .hidden，没在编辑也常驻 */}
        <div class="hidden edit-bar" id="edit-bar">
          <button class="btn btn-sm" onclick="confirmCancelEdit()" style="flex:1;">取消编辑</button>
        </div>
      </div>

      <!-- 已有笔记 -->
      <div class="card">
        <div class="list-header">
          <div class="field-label" style="margin:0"><span class="icon" set:html={uiIcon("fluent-color:document-text-24")} /> <span id="list-title">已有笔记</span></div>
          <div class="list-tools">
            <input
              type="search"
              id="entries-search"
              class="input-single"
              placeholder="搜标题、正文、日期"
              aria-label="搜索笔记"
              oninput="filterEntries()"
            />
            <span class="count" id="list-count"></span>
          </div>
        </div>
        <div id="entries-list">
          <div class="empty-state"><p>请先选择笔记本</p></div>
        </div>
      </div>
    </div>

  </div>

  <div class="toast" id="toast"></div>

  <script is:inline src="/js/editor-commons.js"></script>
  <script is:inline src="/js/admin-github.js"></script>
  <script is:inline src="/js/admin-media.js"></script>
  <script is:inline
    data-gists={JSON.stringify(externalNotebooksConfig.notebookGists || {})}
    data-templates={JSON.stringify(templatesForAdmin)}
    data-repo={JSON.stringify({
      owner: externalPostsConfig.owner,
      repo: externalPostsConfig.repo,
      branch: externalPostsConfig.branch,
    })}
    data-media-icons={JSON.stringify({
      upload: uiIcon("material-symbols:upload"),
      close: uiIcon("material-symbols:close"),
    })}
    data-icons={JSON.stringify({
      warning: uiIcon("fluent-color:warning-24"),
      check: uiIcon("fluent-color:checkmark-circle-24"),
      note: uiIcon("fluent-color:document-text-24"),
      search: uiIcon("fluent-color:search-visual-24"),
    })}>
    var _script = document.currentScript;
    var NOTEBOOK_GISTS = JSON.parse(_script.getAttribute("data-gists") || "{}");
    var TEMPLATES = JSON.parse(_script.getAttribute("data-templates") || "[]");
    // 图标走属性传进来：SVG 字符串里有引号，直接写进脚本正文会打架
    var ICONS = JSON.parse(_script.getAttribute("data-icons") || "{}");
    // 图片能力（共用 /js/admin-media.js）：图片进仓库，笔记本身还是存 Gist
    var REPO = JSON.parse(_script.getAttribute("data-repo") || "{}");
    WBMedia.init({
      owner: REPO.owner, repo: REPO.repo, branch: REPO.branch,
      uploadDir: "public/images/uploads",
      listRoot: "public/images",
      icons: JSON.parse(_script.getAttribute("data-media-icons") || "{}"),
    });
    var FILE_NAME = "notebooks-entries.json";

    var currentNotebook = "";
    var editingEntryId = null;
    var allEntries = [];
    // 登录校验是否已完成（恢复草稿后要拉列表，得等校验通过）
    var authed = false;
    // 本地草稿与"是否有未保存改动"的判定基线
    var draftStore = WBEditor.createDraftStore("notebook");
    var cleanSnapshot = "";

    function $(id) { return document.getElementById(id); }
    function esc(t) { var d = document.createElement("div"); d.textContent = t; return d.innerHTML; }
    function toast(msg, type) {
      var el = $("toast"); el.textContent = msg; el.className = "toast " + type + " show";
      clearTimeout(el._t); el._t = setTimeout(function() { el.className = "toast"; }, 2800);
    }
    // toggleDark 与明暗初始化由 <AdminTheme /> 提供
    function doLogout() { localStorage.removeItem("admin_auth"); fetch("/api/auth/logout", { method: "POST" }).catch(function() {}); window.location.href = "/admin/"; }
    function setStatus(ok, text) {
      $("status-dot").className = "status-dot " + (ok ? "ok" : "err");
      $("status-text").textContent = text;
    }

    // ===== 笔记本标签切换 =====
    var tabs = document.querySelectorAll(".notebook-tab");
    /** 选中某个笔记本；恢复草稿时也要走这里，不然写的东西不知道该进哪一本 */
    function activateNotebook(name) {
      var wanted = null;
      tabs.forEach(function(t) {
        var on = t.getAttribute("data-notebook") === name;
        t.classList.toggle("active", on);
        if (on) wanted = t;
      });
      if (!wanted) return false;
      currentNotebook = name;
      $("target-notebook").textContent = currentNotebook;
      $("list-title").textContent = currentNotebook + " 的笔记";
      return true;
    }
    tabs.forEach(function(tab) {
      tab.addEventListener("click", function() {
        if (!confirmDiscardIfDirty("切换到另一个笔记本")) return;
        if (!activateNotebook(tab.getAttribute("data-notebook"))) return;
        loadEntries();
      });
    });

    function checkAuth() {
      return fetch("/api/auth/status")
        .then(function(r) { return r.json(); })
        .then(function(d) {
          if (!d.authed) { window.location.href = "/admin/"; return false; }
          return true;
        })
        .catch(function() { window.location.href = "/admin/"; return false; });
    }
    function validateAndLoad() {
      setStatus(true, "已连接");
      initGist();
    }

    // ===== 初始化 =====
    function initGist() {
      var configured = Object.keys(NOTEBOOK_GISTS).filter(function(k) { return NOTEBOOK_GISTS[k]; });
      setStatus(true, "已连接（" + configured.length + " 个笔记本已配置 Gist）");
    }

    /** 一条笔记里能被搜到的东西：标题、正文、日期、笔记本名 */
    function entryHaystack(e) {
      return [
        e.title || "",
        e.content || "",
        e.date || (e.createdAt || ""),
        e.notebook || "",
      ].join(" ").toLowerCase();
    }
    function filterEntries() { renderEntries(); }

    // ===== 加载当前笔记本的笔记 =====
    function loadEntries() {
      if (!currentNotebook) return;
      var gistId = NOTEBOOK_GISTS[currentNotebook];
      if (!gistId) {
        $("entries-list").innerHTML = '<div class="empty-state"><div class="icon">' + ICONS.warning + '</div><p>该笔记本未配置 Gist<br><span style="font-size:0.75rem;">首次保存时自动创建</span></p></div>';
        $("list-count").textContent = "";
        return;
      }

      $("entries-list").innerHTML = '<div class="empty-state"><span class="spinner"></span></div>';
      WBGitHub.readGist(gistId)
        .then(function(gist) {
          allEntries = [];
          try { allEntries = JSON.parse(WBGitHub.gistText(gist, FILE_NAME) || "[]"); } catch(e) {}
          renderEntries();
        })
        .catch(function(e) { $("entries-list").innerHTML = '<div class="empty-state" style="color:var(--danger)">加载失败：' + esc(e.message) + '</div>'; });
    }

    // ===== 渲染当前笔记本的笔记 =====
    function renderEntries() {
      var list = $("entries-list");
      if (!currentNotebook) {
        list.innerHTML = '<div class="empty-state"><p>请先选择笔记本</p></div>';
        $("list-count").textContent = "";
        return;
      }
      var inBook = allEntries.filter(function(e) { return e.notebook === currentNotebook; });
      inBook.sort(function(a, b) { return new Date(b.date || b.createdAt) - new Date(a.date || b.createdAt); });

      // 搜索只影响"显示哪些"：allEntries 是一次读回来的全量，过滤在内存里做，
      // 敲一个字不重新请求（笔记全在同一个 Gist 里，一次就读完了）
      var kw = String(($("entries-search") || {}).value || "").trim().toLowerCase();
      var filtered = kw
        ? inBook.filter(function(e) { return entryHaystack(e).indexOf(kw) >= 0; })
        : inBook;
      $("list-count").textContent = kw && filtered.length !== inBook.length
        ? filtered.length + " / " + inBook.length + " 篇"
        : inBook.length + " 篇";

      if (!filtered.length) {
        // 分清两种空：这个笔记本本来就是空的 / 搜了但没匹配上 —— 提示不一样
        if (!inBook.length) {
          list.innerHTML = '<div class="empty-state"><div class="icon">' + ICONS.note + '</div><p>该笔记本还没有远程笔记</p></div>';
        } else {
          list.innerHTML = '<div class="empty-state"><div class="icon">' + ICONS.search + '</div><p>这个笔记本里没有匹配「' + esc(kw) + '」的笔记</p></div>';
        }
        return;
      }

      list.innerHTML = "";
      filtered.forEach(function(e) {
        var d = document.createElement("div"); d.className = "entry-row";
        var date = e.date || (e.createdAt ? new Date(e.createdAt).toISOString().split("T")[0] : "");
        var preview = (e.content || "").replace(/[#*`>\-\[\]!]/g, "").replace(/\n/g, " ").slice(0, 80);
        d.innerHTML =
          '<div class="entry-info">' +
          '<div class="entry-title">' + esc(e.title || "无标题") + '</div>' +
          '<div class="entry-meta"><span>' + date + '</span></div>' +
          (preview ? '<div class="entry-preview">' + esc(preview) + '</div>' : "") +
          '</div>' +
          '<div class="entry-actions">' +
          '<button class="btn btn-sm" onclick="editEntry(\'' + e.id + '\')">编辑</button>' +
          '<button class="btn btn-danger-sm" onclick="deleteEntry(\'' + e.id + '\')">删除</button>' +
          '</div>';
        list.appendChild(d);
      });
    }

    // ===== 模板 =====
    // 从配置生成模板按钮
    (function() {
      var container = document.getElementById("template-buttons");
      if (!container || !TEMPLATES.length) return;
      TEMPLATES.forEach(function(tpl) {
        var btn = document.createElement("button");
        btn.className = "btn btn-sm";
        btn.innerHTML = tpl.svg + " " + tpl.name;
        btn.onclick = function() { applyTemplate(tpl); };
        container.appendChild(btn);
      });
    })();

    function applyTemplate(tpl) {
      if ($("content-input").value.trim() && !confirm("当前内容将被覆盖，确定切换模板？")) return;
      var today = new Date().toISOString().split("T")[0];
      $("entry-title").value = (tpl.title || "").replace(/\{name\}/g, today);
      $("content-input").value = tpl.content || "";
      updatePreview();
    }

    // ===== 窗格布局：编辑 / 分栏 / 预览 =====
    // 2026-10-05：与文章页同一套做法（那边有完整说明，这里不重复）。
    // 状态打在 <html> 上，<head> 里那段脚本已提前按本机存的值设好，不会闪。
    var PANE_MODE_KEY = "wb-notebooks-pane-mode";
    function setPaneMode(mode, remember) {
      if (mode !== "edit" && mode !== "preview" && mode !== "split") mode = "split";
      if (window.innerWidth < 980 && mode === "split") mode = "edit";
      var box = $("editor-container");
      if (!box) return;
      box.setAttribute("data-mobile-pane", mode === "preview" ? "preview" : "edit");
      document.documentElement.setAttribute("data-notebooks-pane", mode);
      Array.prototype.forEach.call(document.querySelectorAll("[data-mode-btn]"), function (b) {
        b.classList.toggle("active", b.getAttribute("data-mode-btn") === mode);
      });
      if (remember !== false) {
        try { localStorage.setItem(PANE_MODE_KEY, mode); } catch (e) {}
      }
    }
    (function() {
      var saved = null;
      try { saved = localStorage.getItem(PANE_MODE_KEY); } catch (e) {}
      setPaneMode(saved || "edit", false);
      Array.prototype.forEach.call(document.querySelectorAll("[data-mode-btn]"), function(btn) {
        btn.addEventListener("click", function() {
          setPaneMode(btn.getAttribute("data-mode-btn"), true);
        });
      });
    })();

    // ===== 编辑器工具栏 =====
    function insertMd(before, after) {
      var ta = $("content-input");
      var start = ta.selectionStart, end = ta.selectionEnd;
      var text = ta.value, selected = text.substring(start, end) || "文本";
      ta.value = text.substring(0, start) + before + selected + after + text.substring(end);
      ta.focus(); ta.selectionStart = start + before.length; ta.selectionEnd = start + before.length + selected.length;
      updatePreview();
    }

    // ===== 图片：上传 / 从图片库选（2026-10-02 加，共用 /js/admin-media.js）=====
    function insertImageMd(url) {
      var ta = $("content-input");
      var start = ta.selectionStart == null ? (ta.value || "").length : ta.selectionStart;
      ta.value = ta.value.substring(0, start) + "![](" + url + ")" + ta.value.substring(start);
      ta.focus();
      ta.selectionStart = ta.selectionEnd = start + ("![](" + url + ")").length;
      updatePreview();
    }
    function noteImgStatus(text) { toast(text, /失败/.test(text) ? "err" : "ok"); }
    function uploadNoteImage() { $("note-img-file").click(); }
    $("note-img-file").addEventListener("change", function () {
      // ⚠️ 先把文件取成数组再清空 input：清空后 files 会变空
      var files = Array.prototype.slice.call(this.files || []);
      this.value = "";
      if (!files.length) return;
      noteImgStatus("正在上传 " + files.length + " 张…");
      files.forEach(function (f) {
        WBMedia.upload(f)
          .then(function (r) { insertImageMd(r.url); noteImgStatus("插图好了（重建后站上生效）"); })
          .catch(function (e) { noteImgStatus("上传失败：" + e.message); });
      });
    });
    function pickNoteImage() {
      WBMedia.openPicker({
        title: "从图片库选一张（笔记插图）",
        onPick: function (url) { insertImageMd(url); },
      });
    }
    // 编辑器里直接拖图 / Ctrl+V 粘贴 → 上传并插图
    WBMedia.wireEditor($("content-input"), { onStatus: noteImgStatus });

    var previewTimer = null;
    function updatePreview() {
      clearTimeout(previewTimer);
      previewTimer = setTimeout(function() {
        var md = $("content-input").value;
        $("preview-pane").innerHTML = md ? renderMarkdown(md) : '<div class="empty-state" style="padding:2rem;"><p>开始编辑后预览内容</p></div>';
      }, 200);
    }

    function renderMarkdown(md) {
      if (!md) return "";
      var html = md;
      html = html.replace(/```(\w*)\n([\s\S]*?)```/g, function(m, l, c) { return '<pre><code>' + esc(c) + '</code></pre>'; });
      html = html.replace(/`([^`]+)`/g, '<code>$1</code>');
      html = html.replace(/^### (.+)$/gm, '<h3>$1</h3>');
      html = html.replace(/^## (.+)$/gm, '<h2>$1</h2>');
      html = html.replace(/^# (.+)$/gm, '<h1>$1</h1>');
      html = html.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
      html = html.replace(/\*(.+?)\*/g, '<em>$1</em>');
      html = html.replace(/!\[([^\]]*)\]\(([^)]+)\)/g, '<img src="$2" alt="$1">');
      html = html.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank">$1</a>');
      html = html.replace(/^> (.+)$/gm, '<blockquote>$1</blockquote>');
      html = html.replace(/^- (.+)$/gm, '<li>$1</li>');
      html = html.replace(/(<li>.*<\/li>\n?)+/g, '<ul>$&</ul>');
      html = html.replace(/^---$/gm, '<hr>');
      html = html.replace(/\n\n/g, '</p><p>');
      html = html.replace(/\n/g, '<br>');
      html = '<p>' + html + '</p>';
      html = html.replace(/<p>\s*<\/p>/g, '');
      html = html.replace(/<p>\s*(<h[1-6]>)/g, '$1');
      html = html.replace(/(<\/h[1-6]>)\s*<\/p>/g, '$1');
      html = html.replace(/<p>\s*(<pre>)/g, '$1');
      html = html.replace(/(<\/pre>)\s*<\/p>/g, '$1');
      html = html.replace(/<p>\s*(<ul>)/g, '$1');
      html = html.replace(/(<\/ul>)\s*<\/p>/g, '$1');
      html = html.replace(/<p>\s*(<blockquote>)/g, '$1');
      html = html.replace(/(<\/blockquote>)\s*<\/p>/g, '$1');
      html = html.replace(/<p>\s*(<hr>)/g, '$1');
      html = html.replace(/(<hr>)\s*<\/p>/g, '$1');
      return html;
    }

    // ===== 编辑 =====
    function editEntry(id) {
      if (!confirmDiscardIfDirty("切换到另一条")) return;
      var entry = allEntries.find(function(e) { return e.id === id; });
      if (!entry) { toast("未找到", "err"); return; }
      editingEntryId = id;
      $("entry-title").value = entry.title || "";
      $("entry-date").value = entry.date || "";
      $("content-input").value = entry.content || "";
      $("submit-btn").textContent = "保存修改";
      $("edit-bar").classList.remove("hidden");
      updatePreview();
      updateCounter();
      markClean();
      window.scrollTo({ top: 0, behavior: "smooth" });
      toast("正在编辑: " + (entry.title || "无标题"), "ok");
    }

    function cancelEdit() {
      editingEntryId = null;
      $("entry-title").value = "";
      $("entry-date").value = new Date().toISOString().split("T")[0];
      $("content-input").value = "";
      $("submit-btn").textContent = "保存笔记";
      $("edit-bar").classList.add("hidden");
      updatePreview();
      updateCounter();
      markClean();
    }
    // 点“取消编辑”时先问一句；保存成功后内部的收尾不走这个口
    function confirmCancelEdit() {
      if (!confirmDiscardIfDirty("取消编辑")) return;
      cancelEdit();
    }

    // ===== 提交 =====
    function submitEntry() {
      if (!currentNotebook) { toast("请先选择笔记本", "err"); return; }
      var content = $("content-input").value.trim();
      if (!content) { toast("请输入内容", "err"); return; }

      // 先把本地这份写下来：万一这次没存进仓库，内容也还在
      saveDraftNow();
      clearTimeout(autosaveTimer);

      var title = $("entry-title").value.trim();
      var date = $("entry-date").value || new Date().toISOString().split("T")[0];
      var btn = $("submit-btn");
      var isEdit = !!editingEntryId;
      var saved = false;
      btn.disabled = true; btn.textContent = "保存中...";

      var gistId = NOTEBOOK_GISTS[currentNotebook];

      function doSave(gid) {
        var fetchGist = gid
          ? WBGitHub.readGist(gid)
          : Promise.resolve({ files: {} });

        fetchGist.then(function(gist) {
          var entries = [];
          try { entries = JSON.parse(WBGitHub.gistText(gist, FILE_NAME) || "[]"); } catch(e) {}

          if (isEdit) {
            var idx = entries.findIndex(function(e) { return e.id === editingEntryId; });
            // 找不到就直接报错收手。原先这里什么都不做，然后照样把原内容提交回去
            // 并提示"已保存"，用户写的东西会悄无声息地丢掉
            if (idx === -1) throw new Error("这条笔记在远端已经不存在了，请刷新后重试");
            entries[idx].title = title;
            entries[idx].date = date;
            entries[idx].content = content;
            entries[idx].updatedAt = new Date().toISOString();
          } else {
            entries.push({
              id: "nb-" + Date.now(),
              notebook: currentNotebook,
              title: title, date: date, content: content,
              createdAt: new Date().toISOString(),
              updatedAt: new Date().toISOString()
            });
          }

          var payload = JSON.stringify(entries, null, 2);

          return (gid
            ? WBGitHub.patchGist(gid, FILE_NAME, payload)
            : WBGitHub.createGist("firefly-notebook:" + currentNotebook, FILE_NAME, payload)
          ).then(function(result) {
            saved = true;
            // 内容已经进了仓库，本地那份临时草稿就没用了
            clearDraft();
            return result;
          }).then(function(result) {
            if (!gid) {
              // 自动创建了新 Gist，提示用户填回配置
              NOTEBOOK_GISTS[currentNotebook] = result.id;
              toast("已保存 ✓ 新 Gist ID: " + result.id + "，请填回配置文件", "ok");
              // 更新标签状态
              tabs.forEach(function(t) {
                if (t.getAttribute("data-notebook") === currentNotebook) {
                  t.innerHTML = ICONS.check + currentNotebook;
                }
              });
            } else {
              toast(isEdit ? "已保存 ✓" : "保存成功 ✓", "ok");
            }
            allEntries = entries;
            cancelEdit();
            renderEntries();
          });
        }).catch(function(e) {
          toast("保存失败: " + e.message, "err");
        }).finally(function() {
          btn.disabled = false;
          // 成功时 cancelEdit 已把文字复位；失败时也要复位，
          // 否则编辑态保存失败后按钮会一直停在“保存中...”
          if (!saved) btn.textContent = isEdit ? "保存修改" : "保存笔记";
        });
      }

      doSave(gistId);
    }

    // ===== 删除 =====
    function deleteEntry(id) {
      if (!confirm("确定删除该笔记？")) return;
      var gistId = NOTEBOOK_GISTS[currentNotebook];
      if (!gistId) return;

      WBGitHub.readGist(gistId)
        .then(function(gist) {
          var entries = [];
          try { entries = JSON.parse(WBGitHub.gistText(gist, FILE_NAME) || "[]"); } catch(e) {}
          entries = entries.filter(function(e) { return e.id !== id; });
          return WBGitHub.patchGist(gistId, FILE_NAME, JSON.stringify(entries, null, 2));
        })
        .then(function() {
          allEntries = allEntries.filter(function(e) { return e.id !== id; });
          toast("已删除", "ok");
          renderEntries();
        })
        .catch(function(e) { toast("删除失败：" + e.message, "err"); });
    }

    // ===== 字数 =====
    function updateCounter() {
      var s = WBEditor.summarize($("content-input").value);
      $("content-counter").textContent = "正文 " + s.chars + " 字 · 约 " + s.minutes + " 分钟读完";
    }
    $("content-input").addEventListener("input", updateCounter);

    // ===== 本地草稿：写到一半也不会丢 =====
    // 只存在这台浏览器里，不上传任何地方。正式内容仍然以存进仓库的为准。
    var pendingDraft = null;
    var autosaveTimer = null;

    function snapshot() {
      return {
        id: editingEntryId,
        notebook: currentNotebook,
        title: $("entry-title").value,
        date: $("entry-date").value,
        content: $("content-input").value,
      };
    }
    function isDirty() {
      return JSON.stringify(snapshot()) !== cleanSnapshot;
    }
    function markClean() {
      cleanSnapshot = JSON.stringify(snapshot());
    }
    function pad2(n) { return String(n).padStart(2, "0"); }
    function fmtTime(ts) {
      var d = new Date(ts);
      return pad2(d.getMonth() + 1) + "月" + pad2(d.getDate()) + "日 " + pad2(d.getHours()) + ":" + pad2(d.getMinutes());
    }
    function clearDraft() {
      draftStore.clear();
      pendingDraft = null;
      $("draft-hint").textContent = "";
      $("restore-bar").classList.add("hidden");
    }
    function saveDraftNow() {
      var s = snapshot();
      // 没选笔记本或内容为空时不写草稿，免得把上一份还有用的顶掉
      if (!s.notebook || !String(s.content || "").trim()) return;
      if (draftStore.save(s)) $("draft-hint").textContent = "本地草稿 " + fmtTime(Date.now());
    }
    function scheduleDraftSave() {
      clearTimeout(autosaveTimer);
      autosaveTimer = setTimeout(saveDraftNow, 900);
    }
    ["entry-title", "entry-date", "content-input"].forEach(function(id) {
      $(id).addEventListener("input", scheduleDraftSave);
    });

    function applySnapshot(s) {
      if (s.notebook) activateNotebook(s.notebook);
      editingEntryId = s.id || null;
      $("entry-title").value = s.title || "";
      $("entry-date").value = s.date || "";
      $("content-input").value = s.content || "";
      $("submit-btn").textContent = editingEntryId ? "保存修改" : "保存笔记";
      $("edit-bar").classList.toggle("hidden", !editingEntryId);
      updatePreview();
      updateCounter();
    }
    function showRestoreBar() {
      var draft = draftStore.load();
      if (!draft || !draft.data) return;
      var d = draft.data;
      if (!String(d.content || "").trim()) {
        draftStore.clear();
        return;
      }
      pendingDraft = draft;
      var preview = String(d.content).trim().replace(/\s+/g, " ");
      if (preview.length > 24) preview = preview.slice(0, 24) + "…";
      $("restore-text").textContent =
        "上次有内容没保存（" + fmtTime(draft.at) + "）：" +
        (d.notebook ? "【" + d.notebook + "】" : "") + (d.title || preview);
      $("restore-bar").classList.remove("hidden");
    }
    function restoreDraft() {
      if (!pendingDraft) return;
      applySnapshot(pendingDraft.data);
      $("restore-bar").classList.add("hidden");
      $("draft-hint").textContent = "本地草稿 " + fmtTime(pendingDraft.at);
      if (currentNotebook && authed) loadEntries();
      markClean();
      toast("已恢复上次未保存的内容", "ok");
    }
    function discardDraft() {
      clearDraft();
      toast("已丢弃本地草稿", "ok");
    }
    function confirmDiscardIfDirty(action) {
      if (!isDirty()) return true;
      return confirm(
        "当前内容还没保存，确定要" + action + "吗？\n" +
        "未保存的内容仍留在本地草稿里，之后可以点“恢复”取回。"
      );
    }

    // 关标签页或刷新时拦一下，避免手滑丢掉正在写的内容
    WBEditor.guardUnsavedChanges(isDirty);

    // ===== 快捷键 =====
    WBEditor.installTabIndent($("content-input"));
    WBEditor.installShortcuts($("content-input"), {
      bold: function() { insertMd("**", "**"); },
      italic: function() { insertMd("*", "*"); },
      link: function() { insertMd("[", "](url)"); },
      save: submitEntry,
      submit: submitEntry,
    });

    // ===== 不想写 Markdown 也能用（2026-10-03 加，与文章页同一套）=====
    WBEditor.installRichPaste($("content-input"), {
      onConverted: function() { toast("已把粘贴的内容转成 Markdown", "ok"); }
    });
    WBEditor.installAutoList($("content-input"));

    // ===== 初始化 =====
    (function() {
      // 先落好默认日期再对齐基线，否则刚打开页面就会被当成"有未保存改动"
      $("entry-date").value = new Date().toISOString().split("T")[0];
      updateCounter();
      markClean();
      showRestoreBar();
      checkAuth().then(function(ok) {
        if (!ok) return;
        authed = true;
        $("content-input").addEventListener("input", updatePreview);
        validateAndLoad();
      });
    })();
  </script>
</body>
</html>
