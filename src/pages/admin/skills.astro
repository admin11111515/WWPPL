---
// 技能 —— 读写仓库里的 src/data/skills.json
//
// 为什么会有这一页：技能页（/skills/）原来**只有代码能改** —— 数据写死在
// `src/data/skills.ts` 的 `skillsData: Skill[]` 里，后台没有任何入口。
// （同类的坑：项目页、相册页、友链页、公告都各踩过一次。）
// 数据搬到 `skills.json` 之后，这一页就是它唯一的编辑入口。
//
// ⚠️ 技能图标是**构建期内联**的：名字不在 `skillIcons.json` 里 = 卡片上一个空图标。
//    所以保存时会去 iconify 把缺的 SVG 拉下来、一起提交；**拉不到就不让保存** ——
//    宁可当面拦住，也不要存出一个静默的空图标。
import AdminTheme from "@/components/admin/AdminTheme.astro";
import AdminAuthGate from "@/components/admin/AdminAuthGate.astro";
import AdminTopBar from "@/components/admin/AdminTopBar.astro";
import { adminBodyClass, adminHtmlClass } from "@/components/admin/adminShell";
import { externalPostsConfig } from "@/config/externalPostsConfig";
import { uiIcon } from "@/constants/ui-icons";

/** 这个页面读写仓库里的哪个文件 */
const target = {
	owner: externalPostsConfig.owner,
	repo: externalPostsConfig.repo,
	branch: externalPostsConfig.branch,
	path: "src/data/skills.json",
};

/**
 * 页面里要用的图标。
 * ⚠️ 必须在 `scripts/generate-icons.js` 的 EXPLICIT_ICONS 白名单里 ——
 *    `uiIcon()` 对不在名单里的名字**静默返回空串**（按钮在、里面什么都没有）。
 * 后台页脚本是 `is:inline` 不能用 import，所以构建期渲染好、用 data 属性传进去。
 */
const rowIcons = {
	up: uiIcon("material-symbols:arrow-upward"),
	down: uiIcon("material-symbols:arrow-downward"),
	del: uiIcon("material-symbols:delete"),
};
---

<html lang="zh-CN" class={adminHtmlClass}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>技能 · 后台</title>
  {/* 后台是站长自用界面，不该出现在搜索结果里（sitemap 中同样已剔除） */}
  <meta name="robots" content="noindex, nofollow" />
  <AdminTheme />
  <AdminAuthGate />
  <style is:inline>
    /* ===== 只放这一页特有的排版，通用部分在 src/styles/admin.css ===== */

    /* ⚠️ 宽度必须声明在 `.container` 自己身上；写 `#admin-main { --admin-content-max }`
       是死代码（admin.css 那条 1280 会压掉它，实测过）。详见 admin.css「3. 宽度容器」。 */
    #admin-main > .container {
      /* 每行 8 个字段（名称/图标/分类/熟练度/年/月/色/描述），820 会挤，
         跟同为列表编辑器的「项目」页对齐用 980 */
      --admin-content-max: 980px;
    }

    .sk-item {
      border: 1px solid var(--line-soft);
      border-radius: var(--r-lg);
      padding: var(--sp-3) var(--sp-4) var(--sp-4);
      margin-bottom: var(--sp-3);
      background: var(--card-bg);
    }
    .sk-item.off { opacity: 0.55; }
    .sk-head {
      display: flex; align-items: center; gap: var(--sp-2);
      margin-bottom: var(--sp-3);
      padding-bottom: var(--sp-2);
      border-bottom: 1px solid var(--line-soft);
    }
    .sk-no { font-size: 0.6875rem; font-weight: 700; color: var(--text-3); min-width: 1.5rem; }
    .sk-avatar {
      width: 1.5rem; height: 1.5rem; flex: none;
      border-radius: var(--r-full);
      border: 1px solid var(--line-soft);
      object-fit: cover;
      background: var(--card-bg-soft);
    }
    .sk-head .sk-title {
      flex: 1; min-width: 0;
      font-size: 0.8125rem; font-weight: 700; color: var(--text);
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .sk-tag {
      flex: none;
      padding: 0 0.375rem;
      border-radius: var(--r-sm);
      background: var(--btn-regular-bg);
      color: var(--text-2);
      font-size: 0.625rem;
      line-height: 1.35rem;
    }
    .sk-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--sp-2) var(--sp-4);
    }
    .sk-grid .wide { grid-column: 1 / -1; }
    @media (max-width: 720px) { .sk-grid { grid-template-columns: 1fr; } }
    .sk-label {
      display: block; font-size: 0.6875rem; font-weight: 700;
      color: var(--text-3); margin-bottom: 0.25rem;
    }
    .sk-check {
      display: flex; align-items: center; gap: 0.4375rem;
      font-size: 0.75rem; color: var(--text-2);
      min-height: 24px; cursor: pointer;
    }
    .sk-empty {
      padding: var(--sp-8) var(--sp-4);
      text-align: center; font-size: 0.8125rem; color: var(--text-3);
    }
  </style>
</head>
<body class={adminBodyClass}>

  <div id="admin-main">
    <AdminTopBar title="技能" />

    <div class="container">
      <div class="card">
        <div class="page-lead">
          <span class="lead-icon" set:html={uiIcon("fluent-color:lightbulb-24")} />
          <span>
            这里改的是前台 <b>/skills/</b> 那页的技能墙。保存后提交到仓库，
            Cloudflare 重新构建（约一两分钟）才生效。
            <br />图标名（形如 <code>logos:python</code>）在 <b>iconify.design</b> 上搜；
            写错了这里会当面拦住，不会让你存出一个空图标。
          </span>
        </div>

        <div id="sk-list"></div>

        <div class="save-row" style="margin-top: 1rem;">
          <button class="btn" type="button" onclick="addSkill()">+ 添加一条技能</button>
        </div>

        {/* ⚠️ id 必须是 save-btn / dirty-hint（全局 Ctrl/⌘+S 与悬浮保存条靠它们找）；
              而且一开始就得 disabled —— 数据还没读回来时不该能点。 */}
        <div class="save-row">
          <button class="btn btn-primary" id="save-btn" onclick="saveSkills()" disabled>保存并生效</button>
          <button class="btn btn-ghost" type="button" onclick="reloadFromRepo()">还原成仓库里的版本</button>
          <span class="dirty-hint" id="dirty-hint"></span>
        </div>
      </div>
    </div>
  </div>

  <div class="toast" id="toast"></div>

  {/* ⚠️ admin-github.js 不能漏：WBGitHub 是它挂上去的。漏了的表现是
         「点保存毫无反应、状态栏永远停在正在读取」——TypeError 落在 .then() 链里，
         只变成一条没人接的 rejection。 */}
  <script is:inline src="/js/admin-github.js"></script>
  <script is:inline src="/js/editor-commons.js"></script>
  <script is:inline data-target={JSON.stringify(target)} data-row-icons={JSON.stringify(rowIcons)}>
    var _script = document.currentScript;
    var TARGET = JSON.parse(_script.getAttribute("data-target") || "{}");
    var ICONS = JSON.parse(_script.getAttribute("data-row-icons") || "{}");

    // ===== 工具 =====
    function $(id) { return document.getElementById(id); }
    function esc(s) { return String(s == null ? "" : s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;"); }
    function toast(msg, type) {
      var el = $("toast"); el.textContent = msg; el.className = "toast " + type + " show";
      clearTimeout(el._t); el._t = setTimeout(function () { el.className = "toast"; }, 3200);
    }
    function setStatus(ok, text) { $("status-dot").className = "status-dot " + (ok ? "ok" : "err"); $("status-text").textContent = text; }
    function b64EncodeUnicode(str) { return btoa(unescape(encodeURIComponent(str))); }
    function b64DecodeUnicode(str) { return decodeURIComponent(escape(atob(str))); }

    // ===== 状态 =====
    var data = [];        // 当前编辑中的技能数组
    var fileSha = "";
    var cleanSnapshot = "";

    // 技能图标是**构建期内联**的（名字不在 skillIcons.json 里 = 卡片上一个空图标）。
    // 所以这一页要同时盯着那份文件：加载时读进来做本地校验，保存时把缺的补进去。
    var ICON_PATH = "src/data/skillIcons.json";
    var iconSet = {};      // name → SVG 文本
    var iconSetRaw = null; // 原对象（保留 _说明/_来源/_为什么，写回去时别丢）
    var iconSetSha = "";

    function snapshot() { return JSON.stringify(data); }
    function isDirty() {
      // ⚠️ 还没建立基线时**不算有改动** —— 数据没读上来时（网慢、接口挂了）
      //    cleanSnapshot 还是空串，照原样比会把"什么都没改"判成"有改动"，
      //    于是离开页面就弹「未保存」，还会拦掉"取消编辑"这类操作。
      if (!cleanSnapshot) return false;
      return snapshot() !== cleanSnapshot;
    }
    function markClean() { cleanSnapshot = snapshot(); updateHint(); syncSaveBtn(); }
    function updateHint() {
      var el = $("dirty-hint");
      if (!el) return;
      var dirty = isDirty();
      el.textContent = dirty ? "有改动还没保存" : "";
      el.className = "dirty-hint" + (dirty ? " dirty" : "");
      syncSaveBtn();
    }
    function syncSaveBtn() {
      var b = $("save-btn");
      if (!b) return;
      var dirty = isDirty();
      b.disabled = !dirty;
      b.title = dirty ? "" : "还没有改动可保存";
    }

    // ===== 渲染 =====
    /** 分类与熟练度的下拉项：值与前台 types/skills 里的联合类型一致，标签用中文 */
    var CATEGORY_OPTIONS = [
      ["frontend", "前端"], ["backend", "后端"], ["database", "数据库"],
      ["tools", "工具"], ["other", "其他"],
    ].map(function (o) { return '<option value="' + o[0] + '">' + o[1] + '</option>'; }).join("");
    var LEVEL_OPTIONS = [
      ["beginner", "入门"], ["intermediate", "熟练"], ["advanced", "进阶"], ["expert", "精通"],
    ].map(function (o) { return '<option value="' + o[0] + '">' + o[1] + '</option>'; }).join("");

    function render() {
      var box = $("sk-list");
      if (!data.length) {
        box.innerHTML = '<div class="sk-empty">还没有技能。点下面的「+ 添加一条技能」开始。<br />' +
          '（前台 /skills/ 现在显示的是空态，加上第一条之后就会变成技能卡。）</div>';
        updateHint();
        return;
      }
      box.innerHTML = data.map(function (f, i) {
        var color = f.color || "#3B82F6";
        var exp = f.experience || {};
        return '' +
          '<div class="sk-item" data-i="' + i + '">' +
            '<div class="sk-head">' +
              '<span class="sk-no">#' + (i + 1) + '</span>' +
              '<span class="sk-swatch" style="background:' + esc(color) + '"></span>' +
              '<span class="sk-title">' + (esc(f.name) || "（还没填名字）") + '</span>' +
              '<button class="btn-icon" type="button" title="上移" aria-label="上移" data-move="-1" data-i="' + i + '">' + ICONS.up + '</button>' +
              '<button class="btn-icon" type="button" title="下移" aria-label="下移" data-move="1" data-i="' + i + '">' + ICONS.down + '</button>' +
              '<button class="btn-icon is-danger" type="button" title="删除这条" aria-label="删除这条" data-del="1" data-i="' + i + '">' + ICONS.del + '</button>' +
            '</div>' +
            '<div class="sk-grid">' +
              '<div><label class="sk-label" for="nm' + i + '">名称（必填）</label>' +
                '<input type="text" class="input-single" id="nm' + i + '" data-k="name" data-i="' + i + '" value="' + esc(f.name) + '" placeholder="例：影刀 RPA" maxlength="20" /></div>' +
              '<div><label class="sk-label" for="ic' + i + '">图标名（iconify，必填）</label>' +
                '<input type="text" class="input-single" id="ic' + i + '" data-k="icon" data-i="' + i + '" value="' + esc(f.icon) + '" placeholder="例：logos:python" />' +
                '<div class="sk-icon-hint" id="ih' + i + '"></div></div>' +
              '<div><label class="sk-label" for="cg' + i + '">分类</label>' +
                '<select class="input-single" id="cg' + i + '" data-k="category" data-i="' + i + '">' + CATEGORY_OPTIONS + '</select></div>' +
              '<div><label class="sk-label" for="lv' + i + '">熟练度</label>' +
                '<select class="input-single" id="lv' + i + '" data-k="level" data-i="' + i + '">' + LEVEL_OPTIONS + '</select></div>' +
              '<div><label class="sk-label" for="ey' + i + '">年限 · 年</label>' +
                '<input type="number" class="input-single" id="ey' + i + '" data-k="exp_years" data-i="' + i + '" value="' + esc(exp.years == null ? 0 : exp.years) + '" min="0" step="1" /></div>' +
              '<div><label class="sk-label" for="em' + i + '">年限 · 月</label>' +
                '<input type="number" class="input-single" id="em' + i + '" data-k="exp_months" data-i="' + i + '" value="' + esc(exp.months == null ? 0 : exp.months) + '" min="0" max="11" step="1" /></div>' +
              '<div><label class="sk-label" for="cl' + i + '">主题色</label>' +
                '<input type="text" class="input-single" id="cl' + i + '" data-k="color" data-i="' + i + '" value="' + esc(color) + '" placeholder="#3B82F6" /></div>' +
              '<div class="wide"><label class="sk-label" for="ds' + i + '">一句话描述</label>' +
                '<input type="text" class="input-single" id="ds' + i + '" data-k="description" data-i="' + i + '" value="' + esc(f.description) + '" maxlength="60" placeholder="例：订单数据清洗与自动化" /></div>' +
            '</div>' +
          '</div>';
      }).join("");
      // 下拉框的选中值只能在这里回填（拼字符串时标不了 selected）
      data.forEach(function (f, i) {
        var c = document.getElementById("cg" + i); if (c) c.value = f.category || "other";
        var l = document.getElementById("lv" + i); if (l) l.value = f.level || "beginner";
      });
      updateHint();
      checkIcons();
    }

    /** 每行图标名下面那句提示：在不在已下载的图标集里（不联网，只看本地那份 JSON） */
    function checkIcons() {
      data.forEach(function (f, i) {
        var el = document.getElementById("ih" + i);
        if (!el) return;
        var name = String(f.icon || "").trim();
        if (!name) { el.textContent = "没填图标名 —— 卡片上会留一个空位"; el.className = "sk-icon-hint warn"; return; }
        if (iconSet[name]) { el.textContent = "图标集里已有 ✓"; el.className = "sk-icon-hint"; return; }
        el.textContent = "图标集里还没有它 —— 保存时会去 iconify 拉一次（拉不到就不提交）";
        el.className = "sk-icon-hint warn";
      });
    }

    // ===== 编辑 =====
    document.addEventListener("input", function (e) {
      var el = e.target;
      if (!el || !el.hasAttribute || !el.hasAttribute("data-k")) return;
      var i = Number(el.getAttribute("data-i")), k = el.getAttribute("data-k");
      if (!data[i]) return;
      if (k === "exp_years" || k === "exp_months") {
        var exp = data[i].experience || (data[i].experience = { years: 0, months: 0 });
        exp[k === "exp_years" ? "years" : "months"] = Number(el.value) || 0;
      } else {
        data[i][k] = el.value;
        // 顶上那一行跟着变：名字换标题、颜色换色块、图标名重判一次
        var item = $("sk-list").querySelector('.sk-item[data-i="' + i + '"]');
        if (item) {
          if (k === "name") { var t = item.querySelector(".sk-title"); if (t) t.textContent = el.value || "（还没填名字）"; }
          if (k === "color") { var sw = item.querySelector(".sk-swatch"); if (sw) sw.style.background = el.value || "#3B82F6"; }
        }
        if (k === "icon") checkIcons();
      }
      updateHint();
    });

    document.addEventListener("change", function (e) {
      var el = e.target;
      if (!el || !el.hasAttribute || !el.hasAttribute("data-k")) return;
      // 只有下拉框走这里（改选完才触发 change，input 不一定发）
      if (el.tagName !== "SELECT") return;
      var i = Number(el.getAttribute("data-i")), k = el.getAttribute("data-k");
      if (!data[i]) return;
      data[i][k] = el.value;
      updateHint();
    });

    document.addEventListener("click", function (e) {
      var el = e.target.closest ? e.target.closest("[data-move],[data-del]") : null;
      if (!el) return;
      var i = Number(el.getAttribute("data-i"));
      if (el.hasAttribute("data-del")) {
        if (!confirm("删掉「" + (data[i].name || "这条技能") + "」？删完还要点保存才真的生效。")) return;
        data.splice(i, 1);
        render();
        return;
      }
      var j = i + Number(el.getAttribute("data-move"));
      if (j < 0 || j >= data.length) return;
      var t = data[i]; data[i] = data[j]; data[j] = t;
      render();
    });

    function addSkill() {
      data.push({
        id: "sk-" + Date.now().toString(36),
        name: "", description: "", icon: "",
        category: "other", level: "beginner",
        experience: { years: 0, months: 0 },
        color: "#3B82F6",
      });
      render();
      var items = $("sk-list").querySelectorAll(".sk-item");
      var last = items.length - 1;
      if (items.length) items[last].scrollIntoView({ block: "center" });
      var t = document.getElementById("nm" + last);
      if (t) t.focus();
    }

    // ===== 读 / 写仓库 =====
    function normalize(parsed) {
      if (!Array.isArray(parsed)) return [];
      return parsed.map(function (f) {
        // ⚠️ 从原对象**拷一份**再改：projects / certifications 这类这一页没做的可选字段
        //    就不会被覆盖丢掉（接口里它们是可选的，以后可能用上）。
        var o = Object.assign({}, f);
        o.id = String(f.id || "");
        o.name = String(f.name || "");
        o.description = String(f.description || "");
        o.icon = String(f.icon || "");
        o.category = f.category || "other";
        o.level = f.level || "beginner";
        var e = f.experience || {};
        o.experience = { years: Number(e.years) || 0, months: Number(e.months) || 0 };
        o.color = String(f.color || "#3B82F6");
        return o;
      });
    }

    /** 读 skillIcons.json（只为本地校验与保存时合并；读不到不报错） */
    function loadIconSet() {
      return WBGitHub.getFile({
        owner: TARGET.owner, repo: TARGET.repo, branch: TARGET.branch, path: ICON_PATH
      }).then(function (file) {
        if (!file) return;
        iconSetSha = file.sha || "";
        var text = b64DecodeUnicode(String(file.content || "").replace(/\s/g, ""));
        var obj = null;
        try { obj = JSON.parse(text); } catch (e) { return; }
        iconSetRaw = obj;
        iconSet = (obj && obj.icons) || {};
        checkIcons();
      }).catch(function () { /* 图标集读不到就先不校验，保存时会兜住 */ });
    }

    function loadFromRepo() {
      setStatus(false, "正在读取仓库里的 skills.json…");
      return WBGitHub.getFile({
        owner: TARGET.owner, repo: TARGET.repo, branch: TARGET.branch, path: TARGET.path
      }).then(function (file) {
        if (!file) {
          setStatus(false, "仓库里没找到 " + TARGET.path);
          toast("没读到 " + TARGET.path + "，检查一下路径", "err");
          return;
        }
        fileSha = file.sha || "";
        var text = b64DecodeUnicode(String(file.content || "").replace(/\s/g, ""));
        var parsed;
        try {
          parsed = JSON.parse(text);
        } catch (err) {
          // 解析不了绝不写回去：一写就把原文件覆盖成空的了
          setStatus(false, "文件内容不是合法 JSON，没有改动任何东西");
          toast("读出来的内容解析不了：" + err.message, "err");
          return;
        }
        data = normalize(parsed);
        render();
        markClean();
        setStatus(true, "已连接（" + data.length + " 条技能）");
        // 图标集单独读一次：读不到不影响编辑，只是每行会提示"图标集里还没有它"
        loadIconSet();
      }).catch(function (err) {
        setStatus(false, err.message);
      });
    }

    // ===== 保存 =====
    // 图标是**构建期内联**的：名字不在 skillIcons.json 里，卡片上就是一块空白。
    // 所以保存分三步，中途任何一步不成立都**当面拦住、不写仓库**：
    //   ① 校验名称与图标名（空名字/空图标名 = 空壳卡）
    //   ② 把图标集里缺的图标从 iconify 拉下来（404 或连不上都停）
    //   ③ 提交 skills.json；图标有新增时再补一次 skillIcons.json
    function saveSkills() {
      for (var i = 0; i < data.length; i++) {
        if (!String(data[i].name || "").trim()) {
          toast("第 " + (i + 1) + " 条还没填名称", "err");
          focusItem(i, "nm");
          return;
        }
        if (!String(data[i].icon || "").trim()) {
          toast("第 " + (i + 1) + " 条还没填图标名（去 iconify.design 搜一个）", "err");
          focusItem(i, "ic");
          return;
        }
      }

      var want = [];
      data.forEach(function (f) {
        var n = String(f.icon || "").trim();
        if (n && want.indexOf(n) === -1) want.push(n);
      });
      var missing = want.filter(function (n) { return !iconSet[n]; });

      var btn = $("save-btn");
      btn.disabled = true; btn.textContent = "保存中…";

      fetchMissingIcons(missing)
        .then(function (addedCount) {
          setStatus(false, "正在提交到仓库…");
          return putSkills().then(function () {
            if (!addedCount) return null;
            return putIconSet();
          });
        })
        .then(function () {
          markClean();
          setStatus(true, "已提交，等 Cloudflare 重新构建");
          toast("已保存。Cloudflare 重新构建后 /skills/ 生效（约一两分钟）", "ok");
        })
        .catch(function (err) {
          setStatus(false, err.message);
          toast(err.message, "err");
        })
        .then(function () {
          btn.textContent = "保存并生效";
          syncSaveBtn();
        });
    }

    /** 把图标集里还没有的图标从 iconify 拉下来；**拉不到就抛错**（宁可不提交，也别存出空图标） */
    function fetchMissingIcons(names) {
      if (!names.length) return Promise.resolve(0);
      setStatus(false, "正在从 iconify 取 " + names.length + " 个新图标…");
      var chain = Promise.resolve();
      var done = 0;
      names.forEach(function (name) {
        chain = chain.then(function () {
          var parts = String(name).split(":");
          if (parts.length !== 2 || !parts[0] || !parts[1]) {
            throw new Error("图标名要写成两段「前缀:名字」，比如 logos:python（现在是「" + name + "」）");
          }
          var url = "https://api.iconify.design/" + parts[0] + "/" + parts[1] + ".svg";
          return fetch(url).then(function (r) {
            if (r.status === 404) throw new Error("iconify 上没有「" + name + "」这个图标，换个名字（去 iconify.design 搜）");
            if (!r.ok) throw new Error("取图标 " + name + " 失败（HTTP " + r.status + "）");
            return r.text();
          }).then(function (svg) {
            if (!/<svg/i.test(svg)) throw new Error("取回来的不是 SVG：" + name);
            iconSet[name] = svg.trim();
            done++;
          });
        });
      });
      return chain.catch(function (e) {
        var msg = String((e && e.message) || e);
        // 连不上（不是"这个名字不存在"）时说清楚是网络问题，别让人以为是名字写错了
        if (/Failed to fetch|NetworkError|load failed|ERR_/i.test(msg)) {
          throw new Error("连不上 iconify，没法确认图标名对不对 —— 稍后重试，或先填图标集里已有的名字");
        }
        throw e;
      }).then(function () { return done; });
    }

    function putSkills() {
      return WBGitHub.putFile({
        owner: TARGET.owner, repo: TARGET.repo, branch: TARGET.branch, path: TARGET.path,
        content: b64EncodeUnicode(JSON.stringify(data, null, "\t") + "\n"),
        message: "chore: 更新技能清单",
        sha: fileSha || undefined
      }).then(function (res) {
        fileSha = (res && res.content && res.content.sha) || fileSha;
      });
    }

    /** 写回图标集：保留 _说明/_来源/_为什么 那几个键，只换 icons */
    function putIconSet() {
      var obj = iconSetRaw && typeof iconSetRaw === "object" ? Object.assign({}, iconSetRaw) : {};
      obj.icons = iconSet;
      return WBGitHub.putFile({
        owner: TARGET.owner, repo: TARGET.repo, branch: TARGET.branch, path: ICON_PATH,
        content: b64EncodeUnicode(JSON.stringify(obj, null, "\t") + "\n"),
        message: "chore: 补充技能图标",
        sha: iconSetSha || undefined
      }).then(function (res) {
        iconSetSha = (res && res.content && res.content.sha) || iconSetSha;
        iconSetRaw = obj;
      });
    }

    function focusItem(i, prefix) {
      var box = $("sk-list").querySelector('.sk-item[data-i="' + i + '"]');
      if (box) box.scrollIntoView({ block: "center" });
      var el = document.getElementById(prefix + i);
      if (el) el.focus();
    }

    function reloadFromRepo() {
      if (isDirty() && !confirm("现在有没保存的改动，还原会丢掉它们。继续？")) return;
      loadFromRepo();
    }

    // ===== 初始化 =====
    function checkAuth() {
      return fetch("/api/auth/status")
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (!d.authed) { window.location.href = "/admin/"; return false; }
          return true;
        })
        .catch(function () { window.location.href = "/admin/"; return false; });
    }
    function doLogout() {
      localStorage.removeItem("admin_auth");
      fetch("/api/auth/logout", { method: "POST" }).catch(function () {});
      window.location.href = "/admin/";
    }

    WBEditor.guardUnsavedChanges(isDirty);
    checkAuth().then(function (ok) { if (ok) loadFromRepo(); });
  </script>
</body>
</html>
