---
// 站点外观 —— 读写仓库里的 src/data/appearance.json
// 改的是色相、明暗、壁纸模式、页面开关这些结构值，保存后重新构建才生效。
import AdminTheme from "@/components/admin/AdminTheme.astro";
import AdminAuthGate from "@/components/admin/AdminAuthGate.astro";
import AdminTopBar from "@/components/admin/AdminTopBar.astro";
import { adminBodyClass, adminHtmlClass } from "@/components/admin/adminShell";
import { externalPostsConfig } from "@/config/externalPostsConfig";
// 后台不走博客 Layout，也就没有 iconify 运行时，图标用构建期内联的 SVG
import { uiIcon } from "@/constants/ui-icons";

/** 这个页面读写仓库里的哪个文件 */
const target = {
	owner: externalPostsConfig.owner,
	repo: externalPostsConfig.repo,
	branch: externalPostsConfig.branch,
	path: "src/data/appearance.json",
};

/**
 * 表单字段表。key 必须与 src/data/appearance.json 的键、以及
 * src/config/appearance.ts 里读的键三处一致 —— 对不上不报错，
 * 只是前台退回默认值，表现为"保存了却没生效"。
 *
 * kind：
 *   hue   色相（数字 + 色块预览）
 *   enum  下拉，options 里给 [值, 名字]
 *   bool  开关（勾上 = true）
 */
type Field = {
	key: string;
	label: string;
	kind: "hue" | "enum" | "bool";
	hint: string;
	options?: [string, string][];
};

const fields: Field[] = [
	{
		key: "themeHue",
		label: "主题色相",
		kind: "hue",
		hint: '整站的主色。0 红 · 30 橙 · 90 黄绿 · 150 青绿 · 200 青 · 250 蓝绿（本站现在这个）· 300 紫 · 345 粉。填 0–360 之间的整数，填别的会退回上一次的值。',
	},
	{
		key: "visitorCanChangeHue",
		label: "让访客自己换主题色",
		kind: "bool",
		hint: '勾上：访客能在导航栏的「显示设置」里自己拖色相。不勾：全站锁死成上面那个色相，访客看不到换色入口。',
	},
	{
		key: "defaultMode",
		label: "新访客的明暗",
		kind: "enum",
		options: [
			["system", "跟随系统"],
			["light", "始终亮色"],
			["dark", "始终暗色"],
		],
		hint: "只决定**第一次进来**的访客看到什么；访客自己切过之后以他的选择为准。",
	},
	{
		key: "cardBorder",
		label: "卡片边框和阴影",
		kind: "bool",
		hint: "勾上卡片有描边和轻微阴影，层次更清楚；不勾更平板。",
	},
	{
		key: "cardFollowTheme",
		label: "卡片风格跟随主题色",
		kind: "bool",
		hint: "勾上卡片会带一点主题色的底；不勾则一律中性灰白。",
	},
	{
		key: "wallpaperMode",
		label: "壁纸模式",
		kind: "enum",
		options: [
			["fullscreen", "全屏壁纸（现在这个）"],
			["banner", "只有首页顶部一条横幅"],
			["overlay", "全屏半透明覆盖"],
			["none", "不要壁纸，纯色背景"],
		],
		hint: "壁纸图是随机图接口（t.alcy.cc），每次刷新换一张。切到「无」之后首页就是纯色背景。",
	},
	{
		key: "wallpaperSwitchable",
		label: "让访客切换壁纸模式",
		kind: "bool",
		hint: "勾上：访客能在显示设置里自己换壁纸模式。主题作者不推荐 —— 几种模式来回切会有奇怪的过渡。",
	},
	{
		key: "wallpaperPlayer",
		label: "背景视频播放按钮",
		kind: "bool",
		hint: "勾上：导航栏出现一个播放按钮，点开播放背景视频。",
	},
	{
		key: "bannerText",
		label: "首页横幅文字",
		kind: "bool",
		hint: "首页顶部那条大字和轮播句子。关掉就只剩壁纸。",
	},
];

/**
 * 页面开关：关掉的页面会返回 404，并且从导航栏里自动消失。
 * ⚠️ 这里只列**真的做出来了**的页面 —— /bangumi/ /devices/ /timeline/
 *    三个页面根本不存在，放进后台只会让人打开一个 404。
 */
const pageSwitches = [
	["friends", "友链 /friends/"],
	["sponsor", "打赏 /sponsor/"],
	["guestbook", "留言 /guestbook/"],
	["anime", "追番 /anime/"],
	["gallery", "相册 /gallery/"],
	["projects", "项目 /projects/"],
	["skills", "技能 /skills/"],
];
---

<html lang="zh-CN" class={adminHtmlClass}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>站点外观 · 后台</title>
  {/* 后台是站长自用界面，不该出现在搜索结果里（sitemap 中同样已剔除） */}
  <meta name="robots" content="noindex, nofollow" />
  <AdminTheme />
  <AdminAuthGate />
  <style is:inline>
    /* ===== 只放这一页特有的排版，通用部分在 src/styles/admin.css ===== */
    #admin-main { --admin-content-max: 720px; }

    /* ⚠️ .page-lead / .section-title / .save-row / .dirty-hint 已提到
          admin.css 的共享层（第三遍），这里不要重复定义 —— 页面 <style>
          在 admin.css 之后加载，写了就是本地那份赢，改共享层看着像没生效。
          下面只留这一页特有的：色相试色块、开关行、页面开关。 */

    /* 色相：数字框 + 色块，色块跟着数字实时变 */
    .hue-row { display: flex; align-items: center; gap: 0.625rem; }
    .hue-row input { width: 6rem; flex-shrink: 0; }
    .hue-swatch {
      width: 2.25rem;
      height: 2.25rem;
      border-radius: 0.625rem;
      border: 1px solid var(--line-soft);
      flex-shrink: 0;
      background: oklch(0.6 0.16 270);
    }
    .hue-presets { display: flex; flex-wrap: wrap; gap: 0.375rem; margin-top: 0.5rem; }
    .hue-chip {
      width: 1.75rem;
      height: 1.75rem;
      border-radius: 999px;
      border: 1px solid var(--line-soft);
      cursor: pointer;
      padding: 0;
    }
    .hue-chip:focus-visible { outline: 2px solid var(--primary-ring); outline-offset: 2px; }

    /* 开关行：左边说明，右边开关 */
    .switch-row {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
      padding: 0.625rem 0;
      border-bottom: 1px dashed var(--line-soft);
    }
    .switch-row:last-child { border-bottom: none; }
    .switch-text { flex: 1; min-width: 0; }
    .switch-name { font-size: 0.8125rem; font-weight: 600; color: var(--text); }
    .switch-hint { font-size: 0.6875rem; color: var(--text-3); line-height: 1.7; margin-top: 0.125rem; }
    .switch-row input[type="checkbox"] { width: 1.125rem; height: 1.125rem; margin-top: 0.1875rem; flex-shrink: 0; accent-color: var(--primary); }

    /* 页面开关：两列排，8 个不至于拉太长 */
    .page-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 0.25rem 1rem;
    }
    .page-grid .switch-row { border-bottom: none; padding: 0.375rem 0; }
  </style>
</head>
<body class={adminBodyClass}>

  <div id="admin-main">
    {/* 连接状态放在内容区顶部（顶栏那个位置留给页面名，别两处都叫 status-dot） */}
    <AdminTopBar title="站点外观" />

    <div class="container">
      <div class="card">
        <div class="page-lead">
          <span class="lead-icon" set:html={uiIcon("fluent-color:paint-brush-24")} />
          <span>
            这里改的是站点的配色、明暗、壁纸和页面开关。保存后提交到仓库，
            Cloudflare 重新构建（约一两分钟）才生效 —— 这类是结构值，不像文案改完就能看出来。
          </span>
        </div>

        <div class="form-rows">
        <div class="form-group">
        <div class="section-title">配色与明暗</div>
        {
          fields.slice(0, 5).map((f) =>
            f.kind === "hue" ? (
              <div class="field">
                <div class="field-label">{f.label}</div>
                <div class="hue-row">
                  <input
                    type="number"
                    class="input-single"
                    id={f.key}
                    min="0"
                    max="360"
                    step="1"
                    data-kind="hue"
                    aria-label={f.label}
                  />
                  <span class="hue-swatch" id="hue-swatch" />
                </div>
                <div class="hue-presets" id="hue-presets" />
                <div class="field-hint" set:html={f.hint} />
              </div>
            ) : f.kind === "enum" ? (
              <div class="field">
                <div class="field-label">{f.label}</div>
                <select class="input-single" id={f.key} data-kind="enum" aria-label={f.label}>
                  {f.options.map((o) => <option value={o[0]}>{o[1]}</option>)}
                </select>
                <div class="field-hint" set:html={f.hint} />
              </div>
            ) : (
              // ⚠️ 用 <label> 包住整行：点「名字/说明」也能切换。
              //    原来只有右边那个 18px 的复选框能点（体检里量到"开关不可点标签"），
              //    设置页 8 个开关全都得瞄准那个小方块点。
              //    （注释写成 JS 行注释，别用 {/* */} —— 那个只在元素内部合法，写在
              //      JSX 表达式位置 Astro 会报 `Expected ")" but found "$$render"`。）
              <label class="switch-row">
                <div class="switch-text">
                  <div class="switch-name">{f.label}</div>
                  <div class="switch-hint" set:html={f.hint} />
                </div>
                <input type="checkbox" id={f.key} data-kind="bool" aria-label={f.label} />
              </label>
            ),
          )
        }

        </div>
        <div class="form-group">
        <div class="section-title">壁纸</div>
        {
          fields.slice(5).map((f) =>
            f.kind === "enum" ? (
              <div class="field">
                <div class="field-label">{f.label}</div>
                <select class="input-single" id={f.key} data-kind="enum" aria-label={f.label}>
                  {f.options.map((o) => <option value={o[0]}>{o[1]}</option>)}
                </select>
                <div class="field-hint" set:html={f.hint} />
              </div>
            ) : (
              // ⚠️ 用 <label> 包住整行：点「名字/说明」也能切换。
              //    原来只有右边那个 18px 的复选框能点（体检里量到"开关不可点标签"），
              //    设置页 8 个开关全都得瞄准那个小方块点。
              //    （注释写成 JS 行注释，别用 {/* */} —— 那个只在元素内部合法，写在
              //      JSX 表达式位置 Astro 会报 `Expected ")" but found "$$render"`。）
              <label class="switch-row">
                <div class="switch-text">
                  <div class="switch-name">{f.label}</div>
                  <div class="switch-hint" set:html={f.hint} />
                </div>
                <input type="checkbox" id={f.key} data-kind="bool" aria-label={f.label} />
              </label>
            ),
          )
        }

        </div>
        <div class="form-group">
        <div class="section-title">页面开关</div>
        <div class="field-hint" style="margin-bottom:0.375rem;">
          关掉的页面会返回 404，导航栏里那一项也会自动消失。
        </div>
        <div class="page-grid" id="page-grid">
          {
            pageSwitches.map((p) => (
              <label class="switch-row">
                <div class="switch-text">
                  <div class="switch-name">{p[1]}</div>
                </div>
                <input type="checkbox" id={"page-" + p[0]} data-page={p[0]} data-kind="page" aria-label={p[1]} />
              </label>
            ))
          }
        </div>
        </div>
        </div>

      {/* 操作区在卡片**里**：贴卡片左右边缘、有上分隔线，跟卡片是同一张皮，
          不是卡片外悬着一条通栏。admin.css「第三遍」里的 .card > .save-row 管样式。 */}
      <div class="save-row">
        <button class="btn btn-primary" id="save-btn" onclick="saveAppearance()">保存并生效</button>
        <button class="btn btn-ghost" type="button" onclick="reloadFromRepo()">还原成仓库里的版本</button>
        <span class="dirty-hint" id="dirty-hint"></span>
      </div>
      </div>
    </div>

  </div>

  <div class="toast" id="toast"></div>

  <script is:inline src="/js/editor-commons.js"></script>
  <script is:inline src="/js/admin-github.js"></script>
  <script is:inline data-target={JSON.stringify(target)}>
    var _script = document.currentScript;
    var TARGET = JSON.parse(_script.getAttribute("data-target") || "{}");

    // ===== 工具 =====
    function $(id) { return document.getElementById(id); }
    function toast(msg, type) {
      var el = $("toast"); el.textContent = msg; el.className = "toast " + type + " show";
      clearTimeout(el._t); el._t = setTimeout(function() { el.className = "toast"; }, 3200);
    }
    function setStatus(ok, text) { $("status-dot").className = "status-dot " + (ok ? "ok" : "err"); $("status-text").textContent = text; }

    // toggleDark 与明暗初始化由 <AdminTheme /> 提供

    var fileSha = "";
    var cleanSnapshot = "";

    // ===== 色相：数字框与色块联动，下面一排常用色点一下就换 =====
    var HUE_PRESETS = [
      [0, "红"], [30, "橙"], [90, "黄绿"], [150, "青绿"],
      [200, "青"], [250, "蓝绿"], [300, "紫"], [345, "粉"],
    ];
    (function () {
      var box = $("hue-presets");
      HUE_PRESETS.forEach(function (p) {
        var b = document.createElement("button");
        b.type = "button";
        b.className = "hue-chip";
        b.style.background = "oklch(0.6 0.16 " + p[0] + ")";
        b.title = p[1] + " " + p[0];
        b.setAttribute("aria-label", p[1] + " " + p[0]);
        b.onclick = function () {
          $("themeHue").value = p[0];
          paintSwatch();
          updateHint();
        };
        box.appendChild(b);
      });
    })();
    function paintSwatch() {
      var v = Number($("themeHue").value);
      var hue = isNaN(v) ? 250 : v;
      $("hue-swatch").style.background = "oklch(0.6 0.16 " + hue + ")";
    }

    // ===== 取值 / 填值 =====
    function snapshot() {
      var out = {};
      Array.prototype.forEach.call(document.querySelectorAll("[data-kind]"), function (el) {
        var key = el.getAttribute("data-kind");
        if (key === "page") return;
        if (key === "hue") {
          // ⚠️ 空着必须是"空"，不能变成 0：Number("") === 0，而 0 是一个合法色相（红）。
          //    让空串悄悄变成 0，等于把站点刷成红色还说"保存成功" —— 留成 null，
          //    由下面的 problem() 当面拦下。
          var raw = String(el.value).trim();
          out[el.id] = raw === "" ? null : Number(raw);
        } else if (key === "bool") out[el.id] = !!el.checked;
        else out[el.id] = el.value;
      });
      out.pages = {};
      Array.prototype.forEach.call(document.querySelectorAll('[data-kind="page"]'), function (el) {
        out.pages[el.getAttribute("data-page")] = !!el.checked;
      });
      return out;
    }

    function applyData(data) {
      Array.prototype.forEach.call(document.querySelectorAll("[data-kind]"), function (el) {
        var key = el.getAttribute("data-kind");
        var v = data ? data[el.id] : undefined;
        if (key === "hue") el.value = typeof v === "number" ? v : 250;
        else if (key === "bool") el.checked = v === true;
        else if (key === "page") el.checked = !!(data && data.pages && data.pages[el.getAttribute("data-page")] === true);
        else if (typeof v === "string") el.value = v;
      });
      paintSwatch();
    }

    function isDirty() { return JSON.stringify(snapshot()) !== cleanSnapshot; }
    function markClean() { cleanSnapshot = JSON.stringify(snapshot()); updateHint(); }
    function updateHint() {
      var el = $("dirty-hint");
      var dirty = isDirty();
      el.textContent = dirty ? "有改动还没保存" : "";
      el.className = "dirty-hint" + (dirty ? " dirty" : "");
    }

    function b64DecodeUnicode(str) {
      var bin = atob(str);
      var bytes = new Uint8Array(bin.length);
      for (var i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
      return new TextDecoder("utf-8").decode(bytes);
    }
    function b64EncodeUnicode(str) {
      var bytes = new TextEncoder().encode(str);
      var bin = "";
      bytes.forEach(function (b) { bin += String.fromCharCode(b); });
      return btoa(bin);
    }

    // ===== 读 =====
    function loadFromRepo() {
      setStatus(false, "正在读取仓库里的 appearance.json…");
      return WBGitHub.getFile({
        owner: TARGET.owner, repo: TARGET.repo, branch: TARGET.branch, path: TARGET.path
      }).then(function (file) {
        if (!file) {
          setStatus(false, "仓库里没找到 " + TARGET.path);
          toast("没读到 " + TARGET.path + "，检查一下路径", "err");
          return;
        }
        fileSha = file.sha || "";
        var text = b64DecodeUnicode(String(file.content || "").replace(/\s/g, ""));
        var data = null;
        try {
          data = JSON.parse(text);
        } catch (e) {
          // 解析不了绝不写回去：一写就把原文件覆盖成空的了
          setStatus(false, "文件内容不是合法 JSON，没有改动任何东西");
          toast("读出来的内容解析不了：" + e.message, "err");
          return;
        }
        applyData(data);
        markClean();
        setStatus(true, "已连接");
      }).catch(function (e) {
        setStatus(false, e.message);
        toast(e.message, "err");
      });
    }

    function reloadFromRepo() {
      if (isDirty() && !confirm("还有没保存的改动，确定丢掉、重新读仓库里的版本？")) return;
      loadFromRepo();
    }

    // ===== 写 =====
    // 判据与 src/config/appearance.ts 的校验保持一致：不在这里拦住的话，
    // 你会"保存成功但站上看着没变"（前台退回了默认值）。
    function problem(data) {
      var hue = data.themeHue;
      // 空 / 不是数 / 越界 / 带小数，四种都不放行。空必须单独判：Number("") 是 0，
      // 而 0 是合法色相（正红），让"没填"变成"红色"是最糟的一种兜底。
      if (hue === null || typeof hue !== "number" || !isFinite(hue)) {
        return "主题色相要填 0 到 360 之间的整数（现在是空的）";
      }
      if (Math.round(hue) < 0 || Math.round(hue) > 360) {
        return "主题色相要填 0 到 360 之间的整数";
      }
      if (["light", "dark", "system"].indexOf(data.defaultMode) < 0) {
        return "明暗默认只能选 跟随系统 / 始终亮色 / 始终暗色";
      }
      if (["banner", "fullscreen", "overlay", "none"].indexOf(data.wallpaperMode) < 0) {
        return "壁纸模式只能选给定的四种之一";
      }
      return "";
    }

    function saveAppearance() {
      var data = snapshot();
      // 色相按整数写回，避免"270"被写成"270.0"之类的脏 diff
      if (data.themeHue !== null) data.themeHue = Math.round(data.themeHue);
      var bad = problem(data);
      if (bad) { toast(bad, "err"); $("themeHue").focus(); return; }

      var text = JSON.stringify(data, null, "\t") + "\n";
      var btn = $("save-btn");
      btn.disabled = true; btn.textContent = "保存中…";
      setStatus(false, "正在提交到仓库…");

      WBGitHub.putFile({
        owner: TARGET.owner, repo: TARGET.repo, branch: TARGET.branch, path: TARGET.path,
        content: b64EncodeUnicode(text),
        message: "chore: 更新站点外观",
        sha: fileSha || undefined
      }).then(function (res) {
        fileSha = (res && res.content && res.content.sha) || fileSha;
        markClean();
        setStatus(true, "已提交，等 Cloudflare 重新构建");
        toast("已保存。这类改动要重新构建后才看得到（约一两分钟）", "ok");
      }).catch(function (e) {
        setStatus(false, e.message);
        toast(e.message, "err");
      }).then(function () {
        btn.disabled = false; btn.textContent = "保存并生效";
      });
    }

    // ===== 初始化 =====
    function checkAuth() {
      return fetch("/api/auth/status")
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (!d.authed) { window.location.href = "/admin/"; return false; }
          return true;
        })
        .catch(function () { window.location.href = "/admin/"; return false; });
    }
    function doLogout() {
      localStorage.removeItem("admin_auth");
      fetch("/api/auth/logout", { method: "POST" }).catch(function () {});
      window.location.href = "/admin/";
    }

    Array.prototype.forEach.call(document.querySelectorAll("[data-kind]"), function (el) {
      var ev = (el.type === "checkbox" || el.tagName === "SELECT") ? "change" : "input";
      el.addEventListener(ev, function () {
        if (el.id === "themeHue") paintSwatch();
        updateHint();
      });
    });

    WBEditor.guardUnsavedChanges(isDirty);
    checkAuth().then(function (ok) { if (ok) loadFromRepo(); });
  </script>
</body>
</html>
