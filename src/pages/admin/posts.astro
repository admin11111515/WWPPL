---
// 文章管理页面 - 通过 GitHub Contents API 读写博客仓库
import { externalPostsConfig } from "@/config/externalPostsConfig";
const postsConfig = JSON.stringify(externalPostsConfig);
---

<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>文章管理</title>
  {/* 后台是站长自用界面，不该出现在搜索结果里（sitemap 中同样已剔除） */}
  <meta name="robots" content="noindex, nofollow" />
  <style is:inline>
    :root {
      --bg: #fff; --card: transparent; --border: #d9d9d9; --text: #1a1a1a;
      --text-2: #595959; --text-3: #8c8c8c; --primary: #4d4d4d;
      --input-bg: transparent; --hover: #f5f5f5; --danger: #cf1322;
      --success: #389e0d; --code-bg: #f6f8fa;
    }
    :root.dark {
      --bg: #141414; --card: transparent; --border: #404040; --text: #e8e8e8;
      --text-2: #a6a6a6; --text-3: #737373; --input-bg: transparent;
      --hover: #262626; --primary: #d9d9d9; --code-bg: #1e1e1e;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Roboto', sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans SC", sans-serif;
      background: var(--bg); color: var(--text); min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }

    .navbar {
      position: sticky; top: 0; z-index: 50;
      background: var(--bg); border-bottom: 1px solid var(--border);
    }
    .navbar-inner {
      max-width: 1200px; margin: 0 auto; padding: 0 1rem;
      display: flex; align-items: center; justify-content: space-between; height: 48px;
    }
    .navbar-left { display: flex; align-items: center; gap: 0.5rem; }
    .navbar-left h1 { font-size: 0.9375rem; font-weight: 600; color: var(--text); }
    .nav-right { display: flex; align-items: center; gap: 0.5rem; }
    .back-link {
      display: inline-flex; align-items: center; gap: 0.25rem;
      color: var(--text-2); text-decoration: none; font-size: 0.8125rem;
      padding: 0.25rem 0.5rem; transition: color 0.15s;
    }
    .back-link:hover { color: var(--text); }
    .back-link svg { width: 16px; height: 16px; }
    .logout-btn {
      background: none; border: 1px solid var(--border); color: var(--text-3);
      padding: 0.25rem 0.5rem; font-size: 0.6875rem;
      cursor: pointer; transition: all 0.15s;
    }
    .logout-btn:hover { border-color: var(--danger); color: var(--danger); }

    .container { max-width: 1200px; margin: 0 auto; padding: 1.25rem 1rem 4rem; }

    .card {
      background: var(--card); border: 1px solid var(--border);
      padding: 1.25rem; margin-bottom: 1rem;
    }

    .status-bar {
      display: flex; align-items: center; gap: 0.5rem;
      padding: 0.5rem 0.75rem; margin-bottom: 1rem;
      border: 1px solid var(--border); font-size: 0.8125rem; color: var(--text-2);
    }
    .status-dot { width: 6px; height: 6px; border-radius: 50%; }
    .status-dot.ok { background: var(--success); }
    .status-dot.err { background: var(--danger); }

    .field { margin-bottom: 1rem; }
    .field:last-child { margin-bottom: 0; }
    .field-label {
      display: flex; align-items: center; gap: 0.375rem;
      font-size: 0.75rem; font-weight: 500; color: var(--text-2);
      margin-bottom: 0.5rem;
    }
    .field-label .icon { font-size: 0.875rem; }
    .field-hint { margin-top: 0.375rem; font-size: 0.75rem; color: var(--text-3); }

    .input-single {
      width: 100%; padding: 0.4rem 0.625rem; border: 1px solid var(--border);
      border-radius: 0; font-size: 0.8125rem; background: var(--input-bg);
      color: var(--text); outline: none; transition: border-color 0.15s;
    }
    .input-single:focus { border-color: var(--primary); }
    .input-single::placeholder { color: var(--text-3); }

    input[type="date"] {
      width: 100%; padding: 0.4rem 0.625rem; border: 1px solid var(--border);
      border-radius: 0; font-size: 0.8125rem; background: var(--input-bg);
      color: var(--text); outline: none; transition: border-color 0.15s;
      font-family: inherit;
    }
    input[type="date"]:focus { border-color: var(--primary); }

    textarea {
      width: 100%; min-height: 60px; padding: 0.625rem 0.75rem;
      border: 1px solid var(--border); border-radius: 0;
      font-size: 0.875rem; line-height: 1.7; background: var(--input-bg);
      color: var(--text); outline: none; resize: vertical;
      font-family: inherit; transition: border-color 0.15s;
    }
    textarea:focus { border-color: var(--primary); }
    textarea::placeholder { color: var(--text-3); }

    .editor-container {
      display: grid; grid-template-columns: 1fr; gap: 0;
      border: 1px solid var(--border);
    }
    @media (min-width: 900px) {
      .editor-container { grid-template-columns: 1fr 1fr; }
    }
    .editor-pane { display: flex; flex-direction: column; }
    .editor-pane-header {
      display: flex; align-items: center; justify-content: space-between;
      padding: 0.5rem 0.75rem;
      border-bottom: 1px solid var(--border);
      font-size: 0.75rem; font-weight: 500; color: var(--text-3);
    }
    .editor-textarea {
      width: 100%; min-height: 420px; padding: 0.75rem;
      border: none; border-radius: 0;
      font-size: 0.875rem; line-height: 1.8; background: var(--input-bg);
      color: var(--text); outline: none; resize: vertical;
      font-family: 'JetBrains Mono', 'Fira Code', monospace;
    }
    .editor-textarea::placeholder { color: var(--text-3); }
    .preview-pane {
      border-top: 1px solid var(--border);
      min-height: 420px; padding: 0.75rem;
      overflow-y: auto; font-size: 0.875rem; line-height: 1.8;
    }
    @media (min-width: 900px) {
      .preview-pane { border-top: none; border-left: 1px solid var(--border); }
    }
    .preview-pane h1, .preview-pane h2, .preview-pane h3 { margin: 1em 0 0.5em; }
    .preview-pane h1 { font-size: 1.5rem; }
    .preview-pane h2 { font-size: 1.25rem; }
    .preview-pane h3 { font-size: 1.1rem; }
    .preview-pane p { margin: 0 0 0.75em; }
    .preview-pane ul, .preview-pane ol { margin: 0 0 0.75em; padding-left: 1.5em; }
    .preview-pane li { margin-bottom: 0.25em; }
    .preview-pane blockquote { border-left: 3px solid var(--primary); padding-left: 1em; margin: 0 0 0.75em; color: var(--text-2); }
    .preview-pane code { font-family: 'JetBrains Mono', monospace; background: var(--code-bg); padding: 0.15em 0.4em; font-size: 0.85em; }
    .preview-pane pre { background: var(--code-bg); padding: 0.75em; margin: 0 0 0.75em; overflow-x: auto; }
    .preview-pane pre code { background: none; padding: 0; }
    .preview-pane img { max-width: 100%; }
    .preview-pane a { color: var(--primary); }
    .preview-pane hr { border: none; border-top: 1px solid var(--border); margin: 1.5em 0; }

    .editor-toolbar { display: flex; gap: 0.25rem; flex-wrap: wrap; }
    .toolbar-btn {
      width: 28px; height: 28px; display: flex; align-items: center; justify-content: center;
      border: 1px solid var(--border); background: var(--bg); color: var(--text-2);
      cursor: pointer; font-size: 0.8rem; transition: all 0.15s;
    }
    .toolbar-btn:hover { border-color: var(--primary); color: var(--primary); }

    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 0.375rem;
      padding: 0.5rem 0.75rem; border: 1px solid var(--border); border-radius: 0;
      font-size: 0.8125rem; font-weight: 500; cursor: pointer;
      transition: all 0.15s; font-family: inherit; background: var(--bg); color: var(--text);
    }
    .btn:hover { border-color: var(--primary); color: var(--primary); }
    .btn:active { background: var(--hover); }
    .btn-primary { background: var(--text); color: var(--bg); width: 100%; border-color: var(--text); }
    .btn-primary:hover { opacity: 0.85; color: var(--bg); }
    .btn-primary:disabled { opacity: 0.4; cursor: not-allowed; }
    .btn-sm { padding: 0.25rem 0.625rem; font-size: 0.75rem; background: transparent; color: var(--text-2); border: 1px solid var(--border); }
    .btn-sm:hover { border-color: var(--primary); color: var(--primary); }
    .btn-danger-sm { padding: 0.25rem 0.5rem; font-size: 0.6875rem; background: transparent; color: var(--text-3); border: 1px solid var(--border); }
    .btn-danger-sm:hover { border-color: var(--danger); color: var(--danger); }

    .layout-grid {
      display: grid; grid-template-columns: 1fr; gap: 1rem;
    }
    @media (min-width: 900px) {
      .layout-grid { grid-template-columns: 340px 1fr; align-items: start; }
    }
    .post-list-card { position: sticky; top: 60px; }
    @media (max-width: 899px) {
      .post-list-card { position: static; }
    }

    .list-header {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 0.75rem;
    }
    .list-header .count { font-size: 0.75rem; color: var(--text-3); }

    .post-row {
      display: flex; align-items: center; justify-content: space-between; gap: 0.75rem;
      padding: 0.625rem 0; border-bottom: 1px solid var(--border);
    }
    .post-row:last-child { border-bottom: none; }
    .post-info { flex: 1; min-width: 0; }
    .post-title { font-size: 0.8125rem; font-weight: 500; color: var(--text); }
    .post-meta { display: flex; align-items: center; gap: 0.5rem; margin-top: 0.15rem; font-size: 0.6875rem; color: var(--text-3); }
    .post-meta .sep { opacity: 0.4; }
    .post-badge {
      display: inline-block; padding: 0.1rem 0.35rem;
      border: 1px solid var(--border); font-size: 0.625rem; color: var(--text-3);
    }
    .post-badge.draft { border-color: var(--danger); color: var(--danger); }
    .post-actions { display: flex; gap: 0.25rem; flex-shrink: 0; }

    .empty-state { text-align: center; padding: 2rem 1rem; color: var(--text-3); }
    .empty-state .icon { font-size: 1.5rem; margin-bottom: 0.5rem; opacity: 0.4; }
    .empty-state p { font-size: 0.8125rem; }

    .toast {
      position: fixed; top: 60px; left: 50%; transform: translateX(-50%) translateY(-8px);
      padding: 0.5rem 1rem; font-size: 0.8125rem;
      font-weight: 500; z-index: 999; opacity: 0;
      transition: opacity 0.2s, transform 0.2s;
      pointer-events: none; border: 1px solid var(--border);
    }
    .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
    .toast.ok { background: var(--success); color: #fff; border-color: var(--success); }
    .toast.err { background: var(--danger); color: #fff; border-color: var(--danger); }

    .dark-fab {
      position: fixed; bottom: 1.5rem; right: 1.5rem;
      width: 36px; height: 36px;
      background: var(--bg); border: 1px solid var(--border);
      cursor: pointer; font-size: 1rem;
      display: flex; align-items: center; justify-content: center;
      transition: border-color 0.15s;
    }
    .dark-fab:hover { border-color: var(--primary); }

    .spinner {
      display: inline-block; width: 14px; height: 14px;
      border: 1.5px solid var(--border); border-top-color: var(--primary);
      border-radius: 50%; animation: spin 0.6s linear infinite;
      vertical-align: middle; margin-right: 0.375rem;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    .hidden { display: none !important; }
    .edit-bar { display: flex; gap: 0.5rem; margin-top: 0.75rem; }
    .form-grid { display: grid; grid-template-columns: 1fr; gap: 0 1rem; }
    @media (min-width: 640px) {
      .form-grid { grid-template-columns: 1fr 1fr; }
    }
    .form-grid .full { grid-column: 1 / -1; }
    .checkbox-row {
      display: flex; align-items: center; gap: 0.5rem;
      font-size: 0.8125rem; color: var(--text-2); cursor: pointer;
    }
    .checkbox-row input { accent-color: var(--primary); }
    .cover-row { display: flex; gap: 0.5rem; }
    .cover-row input { flex: 1; }

    @media (min-width: 768px) {
      .container { padding: 2rem 1.5rem 4rem; }
      .card { padding: 1.5rem; }
    }
    @media (max-width: 480px) {
      .navbar-inner { padding: 0 0.75rem; }
      .container { padding: 1rem 0.75rem 3rem; }
      .card { padding: 1rem; }
      .editor-textarea { min-height: 280px; }
      .preview-pane { min-height: 200px; }
      .post-list-card { position: static; }
    }
  </style>
</head>
<body>

  <nav class="navbar">
    <div class="navbar-inner">
      <div class="navbar-left">
        <span class="dot"></span>
        <h1>文章管理</h1>
      </div>
      <div class="nav-right">
        <a href="/admin/" class="back-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><polyline points="12 19 5 12 12 5"/></svg>
          <span>后台</span>
        </a>
        <button class="logout-btn" onclick="doLogout()">退出</button>
      </div>
    </div>
  </nav>

  <div class="container">
    <div class="status-bar" id="status-bar">
      <span class="status-dot" id="status-dot"></span>
      <span id="status-text">正在连接...</span>
    </div>


    <div class="layout-grid">
      <div class="card post-list-card">
        <div class="list-header">
          <div class="field-label" style="margin:0"><span class="icon">📋</span> 已有文章</div>
          <span class="count" id="list-count"></span>
        </div>
        <button class="btn btn-sm" onclick="newPost()" style="width:100%;margin-bottom:0.75rem;">+ 新建文章</button>
        <div id="post-list">
          <div class="empty-state"><span class="spinner"></span><p>正在加载...</p></div>
        </div>
      </div>

      <div class="card" id="editor-card">
        <div class="field-label"><span class="icon">✍️</span> <span id="editor-title">写文章</span></div>

        <div class="form-grid">
          <div class="field">
            <div class="field-label">标题</div>
            <input type="text" class="input-single" id="title-input" placeholder="文章标题" />
          </div>
          <div class="field">
            <div class="field-label">Slug（文章路径）</div>
            <input type="text" class="input-single" id="slug-input" placeholder="留空自动生成" />
          </div>
          <div class="field">
            <div class="field-label">分类</div>
            <input type="text" class="input-single" id="category-input" placeholder="如：前端" />
          </div>
          <div class="field">
            <div class="field-label">标签（逗号分隔）</div>
            <input type="text" class="input-single" id="tags-input" placeholder="如：Astro, 性能" />
          </div>
          <div class="field">
            <div class="field-label">发布日期</div>
            <input type="date" id="date-input" />
          </div>
          <div class="field">
            <div class="field-label">摘要（可选）</div>
            <input type="text" class="input-single" id="description-input" placeholder="文章摘要" />
          </div>
          <div class="field full">
            <div class="field-label">封面（可填 URL 或上传图片）</div>
            <div class="cover-row">
              <input type="text" class="input-single" id="cover-input" placeholder="https://... 或 /images/posts/..." />
              <button class="btn btn-sm" id="cover-upload-btn" onclick="pickCover()">上传封面</button>
              <input type="file" id="cover-file" accept="image/*" class="hidden" />
            </div>
          </div>
          <div class="field full">
            <label class="checkbox-row">
              <input type="checkbox" id="draft-input" />
              草稿（保存后不对外展示）
            </label>
          </div>
        </div>

        <div class="field">
          <div class="field-label">正文（Markdown，可直接拖图片进来）</div>
          <div class="editor-container">
            <div class="editor-pane">
              <div class="editor-pane-header">
                <span>编辑</span>
                <div class="editor-toolbar">
                  <button class="toolbar-btn" onclick="insertMd('**','**')" title="加粗">B</button>
                  <button class="toolbar-btn" onclick="insertMd('*','*')" title="斜体">I</button>
                  <button class="toolbar-btn" onclick="insertMd('`','`')" title="行内代码">&lt;&gt;</button>
                  <button class="toolbar-btn" onclick="insertMd('\n```\n','\n```\n')" title="代码块">{}</button>
                  <button class="toolbar-btn" onclick="insertMd('[','](url)')" title="链接">🔗</button>
                  <button class="toolbar-btn" id="body-upload-btn" onclick="pickBodyImage()" title="上传图片">🖼</button>
                  <button class="toolbar-btn" onclick="insertMd('> ','')" title="引用">❝</button>
                  <button class="toolbar-btn" onclick="insertMd('- ','')" title="列表">☰</button>
                </div>
              </div>
              <textarea class="editor-textarea" id="content-input" placeholder="用 Markdown 写下文章..." ondrop="onBodyDrop(event)" ondragover="onBodyDragOver(event)"></textarea>
              <input type="file" id="body-file" accept="image/*" class="hidden" />
            </div>
            <div class="editor-pane">
              <div class="editor-pane-header"><span>预览</span></div>
              <div class="preview-pane" id="preview-pane">
                <div class="empty-state" style="padding:2rem;"><p>开始编辑后预览内容</p></div>
              </div>
            </div>
          </div>
        </div>

        <button class="btn btn-primary" id="save-btn" onclick="savePost()">发布文章</button>
        <div class="hidden" id="edit-bar" style="display:flex;gap:0.5rem;margin-top:0.5rem;">
          <button class="btn btn-sm" onclick="cancelEdit()" style="flex:1;">取消编辑</button>
        </div>
      </div>
    </div>
  </div>

  <button class="dark-fab" onclick="toggleDark()" title="切换暗色模式">🌙</button>
  <div class="toast" id="toast"></div>

  <script is:inline data-config={postsConfig}>
    var _script = document.currentScript;
    var CONFIG = JSON.parse(_script.getAttribute("data-config") || "{}");
    var API = "/api/github";
    var posts = [];
    var editingPath = "";
    var editingSha = "";
    var slugAutoMode = true;
    var editingFm = {};

    function $(id) { return document.getElementById(id); }
    function esc(t) { var d = document.createElement("div"); d.textContent = t; return d.innerHTML; }
    function toast(msg, type) {
      var el = $("toast"); el.textContent = msg; el.className = "toast " + type + " show";
      clearTimeout(el._t); el._t = setTimeout(function() { el.className = "toast"; }, 2800);
    }
    function toggleDark() {
      document.documentElement.classList.toggle("dark");
      localStorage.setItem("theme", document.documentElement.classList.contains("dark") ? "dark" : "light");
    }
    if (localStorage.getItem("theme") === "dark") document.documentElement.classList.add("dark");
    function doLogout() { sessionStorage.removeItem("admin_auth"); fetch("/api/auth/logout", { method: "POST" }).catch(function() {}); window.location.href = "/admin/"; }
    function setStatus(ok, text) {
      $("status-dot").className = "status-dot " + (ok ? "ok" : "err");
      $("status-text").textContent = text;
    }
    function todayStr() {
      var d = new Date();
      return d.getFullYear() + "-" + String(d.getMonth() + 1).padStart(2, "0") + "-" + String(d.getDate()).padStart(2, "0");
    }
    function encPath(p) {
      return p.split("/").map(encodeURIComponent).join("/");
    }
    function slugFromPath(path) {
      var prefix = CONFIG.postsPath + "/";
      return path.indexOf(prefix) === 0 ? path.slice(prefix.length).replace(/\.(md|mdx)$/i, "") : path;
    }

    function b64EncodeUnicode(str) {
      var bytes = new TextEncoder().encode(str);
      var bin = "";
      bytes.forEach(function(b) { bin += String.fromCharCode(b); });
      return btoa(bin);
    }
    function b64DecodeUnicode(str) {
      var bin = atob(str);
      var bytes = new Uint8Array(bin.length);
      for (var i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
      return new TextDecoder("utf-8").decode(bytes);
    }

    // ===== 认证 =====
    // ===== 认证 =====
    function checkAuth() {
      return fetch("/api/auth/status")
        .then(function(r) { return r.json(); })
        .then(function(d) {
          if (!d.authed) { window.location.href = "/admin/"; return false; }
          return true;
        })
        .catch(function() { window.location.href = "/admin/"; return false; });
    }
    function connect() {
      setStatus(true, "已连接");
      loadPosts();
    }

    // ===== 文章列表 =====
    function loadPosts() {
      $("post-list").innerHTML = '<div class="empty-state"><span class="spinner"></span><p>正在加载...</p></div>';
      var url = API + "/repos/" + CONFIG.owner + "/" + CONFIG.repo + "/git/trees/" + CONFIG.branch + "?recursive=1";
      fetch(url, {})
        .then(function(r) {
          if (!r.ok) throw new Error("拉取仓库失败 HTTP " + r.status);
          return r.json();
        })
        .then(function(tree) {
          var paths = (tree.tree || [])
            .filter(function(item) {
              return item.type === "blob" &&
                item.path.indexOf(CONFIG.postsPath + "/") === 0 &&
                /\.(md|mdx)$/i.test(item.path);
            })
            .map(function(item) { return item.path; });
          posts = [];
          return Promise.all(paths.map(fetchPostMeta));
        })
        .then(function() {
          posts.sort(function(a, b) {
            return new Date(b.published || 0) - new Date(a.published || 0);
          });
          renderList();
        })
        .catch(function(e) {
          $("post-list").innerHTML = '<div class="empty-state" style="color:var(--danger)">加载失败：' + esc(e.message) + '</div>';
          setStatus(false, "加载失败");
        });
    }
    function fetchPostMeta(path) {
      return fetch(API + "/repos/" + CONFIG.owner + "/" + CONFIG.repo + "/contents/" + encPath(path) + "?ref=" + CONFIG.branch, {})
        .then(function(r) {
          if (!r.ok) throw new Error("读取文件失败 HTTP " + r.status);
          return r.json();
        })
        .then(function(file) {
          var md = b64DecodeUnicode(file.content || "");
          var parsed = parsePost(md);
          posts.push({
            path: path,
            sha: file.sha,
            slug: path.replace(new RegExp("^" + CONFIG.postsPath + "/"), "").replace(/\.(md|mdx)$/i, ""),
            title: parsed.fm.title || path,
            published: String(parsed.fm.published || "").slice(0, 10),
            category: parsed.fm.category || "",
            draft: parsed.fm.draft === true || parsed.fm.draft === "true",
            tags: parsed.fm.tags || [],
          });
        });
    }
    function renderList() {
      $("list-count").textContent = posts.length + " 篇";
      if (!posts.length) {
        $("post-list").innerHTML = '<div class="empty-state"><div class="icon">📝</div><p>还没有文章，点“新建文章”开始</p></div>';
        return;
      }
      $("post-list").innerHTML = "";
      posts.forEach(function(post) {
        var row = document.createElement("div");
        row.className = "post-row";
        row.innerHTML =
          '<div class="post-info">' +
          '<div class="post-title">' + esc(post.title) + '</div>' +
          '<div class="post-meta">' +
          '<span>' + esc(post.published) + '</span>' +
          (post.category ? '<span class="sep">·</span><span>' + esc(post.category) + '</span>' : "") +
          (post.draft ? '<span class="post-badge draft">草稿</span>' : '') +
          '</div></div>' +
          '<div class="post-actions">' +
          '<button class="btn btn-sm" onclick="editPost(\'' + escapeAttr(post.path) + '\')">编辑</button>' +
          '<button class="btn btn-danger-sm" onclick="deletePost(\'' + escapeAttr(post.path) + '\')">删除</button>' +
          '</div>';
        $("post-list").appendChild(row);
      });
    }
    function escapeAttr(s) {
      return s.replace(/\\/g, "\\\\").replace(/'/g, "\\'");
    }

    // ===== frontmatter 解析 =====
    function parsePost(md) {
      var fm = {};
      var body = md;
      var m = md.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n?/);
      if (m) {
        body = md.slice(m[0].length);
        m[1].split(/\r?\n/).forEach(function(line) {
          var kv = line.match(/^([A-Za-z_][\w]*):\s*(.*)$/);
          if (!kv) return;
          var key = kv[1], value = kv[2].trim();
          if (key === "tags") {
            try { fm.tags = JSON.parse(value); } catch(e) {
              fm.tags = value.replace(/^\[|\]$/g, "").split(",").map(function(s) { return s.trim().replace(/^["']|["']$/g, ""); }).filter(Boolean);
            }
          } else if (key === "draft" || key === "pinned" || key === "comment") {
            fm[key] = value === "true";
          } else {
            fm[key] = value.replace(/^["']|["']$/g, "");
          }
        });
      }
      return { fm: fm, body: body.trim() };
    }

    // ===== 表单 =====
    function fillForm(fm, body) {
      $("title-input").value = fm.title || "";
      $("slug-input").value = (fm.slug || "");
      $("category-input").value = fm.category && fm.category !== "null" ? fm.category : "";
      $("tags-input").value = (fm.tags || []).join(", ");
      $("date-input").value = String(fm.published || todayStr()).slice(0, 10);
      $("description-input").value = fm.description || "";
      $("cover-input").value = fm.image || "";
      $("draft-input").checked = fm.draft === true || fm.draft === "true";
      $("content-input").value = body || "";
      slugAutoMode = false;
      updatePreview();
    }
    function resetForm() {
      $("title-input").value = "";
      $("slug-input").value = "";
      $("category-input").value = "";
      $("tags-input").value = "";
      $("date-input").value = todayStr();
      $("description-input").value = "";
      $("cover-input").value = "";
      $("draft-input").checked = false;
      $("content-input").value = "";
      slugAutoMode = true;
      updatePreview();
    }
    function newPost() {
      editingPath = "";
      editingSha = "";
      resetForm();
      editingFm = {};
      $("editor-title").textContent = "写文章";
      $("save-btn").textContent = "发布文章";
      $("edit-bar").classList.add("hidden");
      window.scrollTo({ top: 0, behavior: "smooth" });
      toast("开始写新文章", "ok");
    }
    function cancelEdit() {
      newPost();
    }
    function editPost(path) {
      fetch(API + "/repos/" + CONFIG.owner + "/" + CONFIG.repo + "/contents/" + encPath(path) + "?ref=" + CONFIG.branch, {})
        .then(function(r) {
          if (!r.ok) throw new Error("读取失败 HTTP " + r.status);
          return r.json();
        })
        .then(function(file) {
          var parsed = parsePost(b64DecodeUnicode(file.content || ""));
          editingPath = path;
          editingSha = file.sha;
          parsed.fm.slug = path.replace(new RegExp("^" + CONFIG.postsPath + "/"), "").replace(/\.(md|mdx)$/i, "");
          editingFm = parsed.fm;
          fillForm(parsed.fm, parsed.body);
          $("editor-title").textContent = "编辑文章";
          $("save-btn").textContent = "保存修改";
          $("edit-bar").classList.remove("hidden");
          window.scrollTo({ top: 0, behavior: "smooth" });
          toast("正在编辑: " + (parsed.fm.title || path), "ok");
        })
        .catch(function(e) { toast("加载失败: " + e.message, "err"); });
    }

    // ===== slug =====
    function slugifyTitle(title) {
      var s = (title || "").trim().toLowerCase()
        .replace(/\s+/g, "-")
        .replace(/[^\w\u4e00-\u9fa5-]+/g, "")
        .replace(/-+/g, "-")
        .replace(/^-+|-+$/g, "");
      return s || "post-" + todayStr();
    }
    function ensureSlug() {
      var slug = $("slug-input").value.trim();
      if (!slug) {
        slug = slugifyTitle($("title-input").value);
        $("slug-input").value = slug;
      }
      return slug;
    }
    $("title-input").addEventListener("input", function() {
      if (slugAutoMode) $("slug-input").value = slugifyTitle(this.value);
    });
    $("slug-input").addEventListener("input", function() {
      slugAutoMode = false;
    });

    // ===== 保存 =====
    function buildMarkdown() {
      var title = $("title-input").value.trim();
      var date = $("date-input").value || todayStr();
      var category = $("category-input").value.trim();
      var tags = $("tags-input").value.split(/[,，]/).map(function(s) { return s.trim(); }).filter(Boolean);
      var description = $("description-input").value.trim();
      var cover = $("cover-input").value.trim();
      var draft = $("draft-input").checked;
      var body = $("content-input").value.trim();
      var lines = ["---", "title: " + JSON.stringify(title), "published: " + date];
      if (description) lines.push("description: " + JSON.stringify(description));
      if (cover) lines.push("image: " + JSON.stringify(cover));
      lines.push("tags: " + JSON.stringify(tags));
      if (category) lines.push("category: " + JSON.stringify(category));
      lines.push("draft: " + draft);
      var knownKeys = ["title", "published", "description", "image", "tags", "category", "draft", "slug"];
      Object.keys(editingFm).forEach(function(key) {
        if (knownKeys.indexOf(key) !== -1) return;
        var v = editingFm[key];
        if (v === undefined || v === null || v === "") return;
        lines.push(key + ": " + (typeof v === "boolean" || typeof v === "number" ? String(v) : JSON.stringify(v)));
      });
      lines.push("---");
      lines.push("");
      lines.push(body);
      return lines.join("\n");
    }
    function putTextFile(path, text, sha, message) {
      return fetch(API + "/repos/" + CONFIG.owner + "/" + CONFIG.repo + "/contents/" + encPath(path), {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          message: message,
          content: b64EncodeUnicode(text),
          branch: CONFIG.branch,
          ...(sha ? { sha: sha } : {})
        })
      }).then(function(r) {
        if (!r.ok) throw new Error("保存失败 HTTP " + r.status);
        return r.json();
      });
    }
    function getFileMeta(path) {
      return fetch(API + "/repos/" + CONFIG.owner + "/" + CONFIG.repo + "/contents/" + encPath(path) + "?ref=" + CONFIG.branch, {})
        .then(function(r) { return r.json(); });
    }
    function deleteFile(path, sha, message) {
      return fetch(API + "/repos/" + CONFIG.owner + "/" + CONFIG.repo + "/contents/" + encPath(path), {
        method: "DELETE",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ message: message, sha: sha, branch: CONFIG.branch })
      }).then(function(r) {
        if (!r.ok) throw new Error("删除失败 HTTP " + r.status);
        return r.json();
      });
    }
    function listImagesDir(slug) {
      return fetch(API + "/repos/" + CONFIG.owner + "/" + CONFIG.repo + "/contents/" + encPath(CONFIG.imagesPath + "/" + slug) + "?ref=" + CONFIG.branch, {})
        .then(function(r) {
          if (r.status === 404) return [];
          if (!r.ok) throw new Error("读取图片目录失败 HTTP " + r.status);
          return r.json();
        });
    }
    function deleteImagesForPost(slug) {
      return listImagesDir(slug).then(function(files) {
        var list = Array.isArray(files) ? files.filter(function(f) { return f.type === "file"; }) : [];
        return Promise.all(list.map(function(f) {
          return deleteFile(f.path, f.sha, "删除文章图片: " + f.path);
        }));
      });
    }
    function putBase64File(path, content, message) {
      return fetch(API + "/repos/" + CONFIG.owner + "/" + CONFIG.repo + "/contents/" + encPath(path), {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ message: message, content: content, branch: CONFIG.branch })
      }).then(function(r) {
        if (!r.ok) throw new Error("上传失败 HTTP " + r.status);
        return r.json();
      });
    }
    function moveImageFile(oldPath, newPath) {
      return getFileMeta(oldPath).then(function(file) {
        if (!file.sha || !file.content) throw new Error("读取图片失败: " + oldPath);
        return putBase64File(newPath, file.content, "移动文章图片: " + newPath)
          .then(function() { return deleteFile(oldPath, file.sha, "移动文章图片: " + oldPath); });
      });
    }
    function moveImagesForPost(oldSlug, newSlug) {
      return listImagesDir(oldSlug).then(function(files) {
        var list = Array.isArray(files) ? files.filter(function(f) { return f.type === "file"; }) : [];
        return Promise.all(list.map(function(f) {
          var name = f.path.split("/").pop();
          return moveImageFile(f.path, CONFIG.imagesPath + "/" + newSlug + "/" + name);
        }));
      });
    }
    function savePost() {
      var title = $("title-input").value.trim();
      var body = $("content-input").value.trim();
      if (!title) { toast("请填写标题", "err"); return; }
      if (!body) { toast("请填写正文", "err"); return; }

      var slug = ensureSlug();
      var newPath = CONFIG.postsPath + "/" + slug + ".md";
      var btn = $("save-btn");
      btn.disabled = true;
      var originalText = btn.textContent;
      btn.textContent = "保存中...";
      var isNew = !editingPath;
      var renamingFrom = editingPath && editingPath !== newPath ? editingPath : "";
      var newSlug = slugFromPath(newPath);
      if (renamingFrom) {
        var oldImgPrefix = "/images/posts/" + slugFromPath(renamingFrom) + "/";
        var newImgPrefix = "/images/posts/" + newSlug + "/";
        $("cover-input").value = $("cover-input").value.split(oldImgPrefix).join(newImgPrefix);
        $("content-input").value = $("content-input").value.split(oldImgPrefix).join(newImgPrefix);
      }
      var md = buildMarkdown();

      function finish(okMsg) {
        toast(okMsg, "ok");
        btn.disabled = false;
        btn.textContent = originalText;
        editingPath = newPath;
        editingSha = "";
        loadPosts();
      }

      function doPut(sha) {
        putTextFile(newPath, md, sha, (renamingFrom || !isNew ? "更新文章: " : "发布文章: ") + title)
          .then(function() {
            editingPath = newPath;
            if (!renamingFrom) return;
            return moveImagesForPost(slugFromPath(renamingFrom), newSlug)
              .catch(function(e) {
                toast("文章已保存，但图片目录迁移失败: " + e.message, "err");
              })
              .then(function() {
                return getFileMeta(renamingFrom).then(function(old) {
                  if (old.sha) return deleteFile(renamingFrom, old.sha, "文章改名: " + title);
                });
              })
              .catch(function(e) {
                toast("文章已保存，但旧文件删除失败: " + e.message, "err");
              });
          })
          .then(function() { finish(isNew ? "发布成功 ✓" : "已保存 ✓"); })
          .catch(function(e) {
            toast("保存失败: " + e.message, "err");
            btn.disabled = false;
            btn.textContent = originalText;
          });
      }

      if (editingPath) {
        getFileMeta(editingPath).then(function(file) { doPut(file.sha || ""); })
          .catch(function() { doPut(""); });
      } else {
        getFileMeta(newPath).then(function(file) {
          if (file.sha && !confirm("仓库已有同名文章，确定覆盖？")) throw new Error("已取消");
          doPut(file.sha || "");
        }).catch(function(e) {
          if (e && e.message === "已取消") {
            btn.disabled = false;
            btn.textContent = originalText;
            return;
          }
          doPut("");
        });
      }
    }

    // ===== 删除 =====
    function deletePost(path) {
      if (!confirm("确定删除这篇文章？文章图片也会一并删除。")) return;
      getFileMeta(path).then(function(file) {
        if (!file.sha) throw new Error("未找到文件");
        var slug = slugFromPath(path);
        return deleteFile(path, file.sha, "删除文章: " + path)
          .then(function() {
            return deleteImagesForPost(slug).catch(function(e) {
              toast("文章已删除，但图片清理失败: " + e.message, "err");
              return null;
            });
          });
      }).then(function() {
        toast("已删除", "ok");
        if (editingPath === path) newPost();
        loadPosts();
      }).catch(function(e) {
        toast("删除失败: " + e.message, "err");
      });
    }

    // ===== Markdown 预览 =====
    var previewTimer = null;
    function updatePreview() {
      clearTimeout(previewTimer);
      previewTimer = setTimeout(function() {
        var md = $("content-input").value;
        $("preview-pane").innerHTML = md ? renderMarkdown(md) : '<div class="empty-state" style="padding:2rem;"><p>开始编辑后预览内容</p></div>';
      }, 200);
    }
    $("content-input").addEventListener("input", updatePreview);

    function renderMarkdown(md) {
      if (!md) return "";
      var html = esc(md);
      html = html.replace(/```(\w*)\n([\s\S]*?)```/g, function(m, l, c) { return '<pre><code>' + c + '</code></pre>'; });
      html = html.replace(/`([^`]+)`/g, '<code>$1</code>');
      html = html.replace(/^### (.+)$/gm, '<h3>$1</h3>');
      html = html.replace(/^## (.+)$/gm, '<h2>$1</h2>');
      html = html.replace(/^# (.+)$/gm, '<h1>$1</h1>');
      html = html.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
      html = html.replace(/\*(.+?)\*/g, '<em>$1</em>');
      html = html.replace(/!\[([^\]]*)\]\(([^)]+)\)/g, '<img src="$2" alt="$1">');
      html = html.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank">$1</a>');
      html = html.replace(/^> (.+)$/gm, '<blockquote>$1</blockquote>');
      html = html.replace(/^- (.+)$/gm, '<li>$1</li>');
      html = html.replace(/(<li>.*<\/li>\n?)+/g, '<ul>$&</ul>');
      html = html.replace(/^---$/gm, '<hr>');
      html = html.replace(/\n\n/g, '</p><p>');
      html = html.replace(/\n/g, '<br>');
      html = '<p>' + html + '</p>';
      html = html.replace(/<p>\s*<\/p>/g, '');
      html = html.replace(/<p>\s*(<h[1-6]>)/g, '$1');
      html = html.replace(/(<\/h[1-6]>)\s*<\/p>/g, '$1');
      html = html.replace(/<p>\s*(<pre>)/g, '$1');
      html = html.replace(/(<\/pre>)\s*<\/p>/g, '$1');
      html = html.replace(/<p>\s*(<ul>)/g, '$1');
      html = html.replace(/(<\/ul>)\s*<\/p>/g, '$1');
      html = html.replace(/<p>\s*(<blockquote>)/g, '$1');
      html = html.replace(/(<\/blockquote>)\s*<\/p>/g, '$1');
      html = html.replace(/<p>\s*(<hr>)/g, '$1');
      html = html.replace(/(<hr>)\s*<\/p>/g, '$1');
      return html;
    }

    // ===== 编辑器工具栏 =====
    function insertMd(before, after) {
      var ta = $("content-input");
      var start = ta.selectionStart, end = ta.selectionEnd;
      var text = ta.value, selected = text.substring(start, end) || "文本";
      ta.value = text.substring(0, start) + before + selected + after + text.substring(end);
      ta.focus(); ta.selectionStart = start + before.length; ta.selectionEnd = start + before.length + selected.length;
      updatePreview();
    }

    // ===== 图片上传 =====
    function pickCover() { $("cover-file").click(); }
    function pickBodyImage() { $("body-file").click(); }
    $("cover-file").addEventListener("change", function() {
      if (this.files && this.files[0]) uploadImage(this.files[0], "cover");
      this.value = "";
    });
    $("body-file").addEventListener("change", function() {
      if (this.files && this.files[0]) uploadImage(this.files[0], "body");
      this.value = "";
    });
    function onBodyDragOver(e) {
      e.preventDefault();
      e.dataTransfer.dropEffect = "copy";
    }
    function onBodyDrop(e) {
      e.preventDefault();
      if (e.dataTransfer.files && e.dataTransfer.files[0]) uploadImage(e.dataTransfer.files[0], "body");
    }

    function loadImage(file) {
      return new Promise(function(resolve, reject) {
        var url = URL.createObjectURL(file);
        var img = new Image();
        img.onload = function() { URL.revokeObjectURL(url); resolve(img); };
        img.onerror = function() { URL.revokeObjectURL(url); reject(new Error("图片读取失败")); };
        img.src = url;
      });
    }
    function canvasToBlob(canvas, quality) {
      return new Promise(function(resolve, reject) {
        canvas.toBlob(function(blob) {
          if (blob) { resolve(blob); return; }
          canvas.toBlob(function(png) {
            if (png) resolve(png);
            else reject(new Error("图片压缩失败"));
          }, "image/png");
        }, "image/webp", quality);
      });
    }
    function compressImage(file, maxSide, quality) {
      return loadImage(file).then(function(img) {
        var scale = Math.min(1, maxSide / Math.max(img.width, img.height));
        var canvas = document.createElement("canvas");
        canvas.width = Math.max(1, Math.round(img.width * scale));
        canvas.height = Math.max(1, Math.round(img.height * scale));
        var ctx = canvas.getContext("2d");
        ctx.imageSmoothingEnabled = true;
        ctx.imageSmoothingQuality = "high";
        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
        return canvasToBlob(canvas, quality).then(function(blob) {
          if (blob.size > 500 * 1024 && quality > 0.55) {
            return compressImage(blob, maxSide, quality - 0.15);
          }
          return blob;
        });
      });
    }
    function blobToBase64(blob) {
      return new Promise(function(resolve, reject) {
        var reader = new FileReader();
        reader.onload = function() { resolve(String(reader.result).split(",")[1]); };
        reader.onerror = reject;
        reader.readAsDataURL(blob);
      });
    }
    function uploadImage(file, purpose) {
      if (!/^image\//.test(file.type)) { toast("请选择图片文件", "err"); return; }
      var slug = ensureSlug();
      if (!slug) { toast("请先填写标题", "err"); return; }

      var btn = purpose === "cover" ? $("cover-upload-btn") : $("body-upload-btn");
      var original = btn.textContent;
      btn.disabled = true;
      btn.textContent = "上传中...";

      var fileName = Date.now() + ".webp";
      var imagePath = CONFIG.imagesPath + "/" + slug + "/" + fileName;
      var imageUrl = "/images/posts/" + slug + "/" + fileName;
      toast(purpose === "cover" ? "正在压缩封面上传..." : "正在压缩图片上传...", "");

      compressImage(file, 1600, 0.82)
        .then(blobToBase64)
        .then(function(base64) {
          return fetch(API + "/repos/" + CONFIG.owner + "/" + CONFIG.repo + "/contents/" + encPath(imagePath), {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              message: "上传文章图片: " + slug,
              content: base64,
              branch: CONFIG.branch
            })
          }).then(function(r) {
            if (!r.ok) throw new Error("上传失败 HTTP " + r.status);
            return r.json();
          });
        })
        .then(function() {
          if (purpose === "cover") {
            $("cover-input").value = imageUrl;
          } else {
            insertMd("![](" + imageUrl + ")", "");
          }
          toast("图片已上传 ✓", "ok");
        })
        .catch(function(e) {
          toast("上传失败: " + e.message, "err");
        })
        .finally(function() {
          btn.disabled = false;
          btn.textContent = original;
        });
    }

    // ===== 初始化 =====
    $("date-input").value = todayStr();
    checkAuth().then(function(ok) {
      if (!ok) return;
      connect();
    });
  </script>
</body>
</html>
