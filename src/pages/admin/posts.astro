---
// 文章管理页面 - 通过 GitHub Contents API 读写博客仓库
import AdminTheme from "@/components/admin/AdminTheme.astro";
import AdminAuthGate from "@/components/admin/AdminAuthGate.astro";
import AdminTopBar from "@/components/admin/AdminTopBar.astro";
import { adminBodyClass, adminHtmlClass } from "@/components/admin/adminShell";
import { externalPostsConfig } from "@/config/externalPostsConfig";
// 后台不走博客 Layout，也就没有 iconify 运行时，图标用构建期内联的 SVG
import { uiIcon } from "@/constants/ui-icons";

const postsConfig = JSON.stringify(externalPostsConfig);
---

<html lang="zh-CN" class={adminHtmlClass}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>文章 · 后台</title>
  {/* 后台是站长自用界面，不该出现在搜索结果里（sitemap 中同样已剔除） */}
  <meta name="robots" content="noindex, nofollow" />
  {/* 样式、字体、主题色都来自这里，页面自己的样式放在它后面 */}
  <AdminTheme />
  <AdminAuthGate />
  <style is:inline>
    /* ===== 只放这一页特有的排版，通用部分在 src/styles/admin.css ===== */

    /* 这一页是「列表 + 编辑器」两栏，内容区比别的页宽一些。
       2026-10-04：1100 → 1320。原来它比全局那档还窄，站长在宽屏上看着就是「右边空一截」。 */
    #admin-main { --admin-content-max: 1320px; }

    .layout-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1rem;
      align-items: start;
    }
    /* 左栏 340 → 400 → **480px**（2026-10-04）：
       三个操作按钮占掉一截之后，400px 里标题只剩 160px，长标题照样被切；
       480px + 标题允许两行（见 admin.css 的 .post-title）之后，
       最长的那条「Astro Content Collections，迁移完我才敢乱改 frontmatter」也能读全。
       右栏还剩 820px 以上，编辑器不受影响（实测 1366 屏也不挤）。 */
    @media (min-width: 980px) {
      .layout-grid { grid-template-columns: 480px minmax(0, 1fr); }
    }

    /* 文章列表：跟随页面滚动，长列表不会把编辑器顶下去 */
    .post-list-card { position: sticky; top: 5.25rem; }
    .post-list-scroll { max-height: calc(100vh - 17rem); overflow-y: auto; margin: 0 -0.25rem; padding: 0 0.25rem; }
    @media (max-width: 979px) {
      .post-list-card { position: static; }
      .post-list-scroll { max-height: 22rem; }
    }

    .list-filter { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 0.75rem; }
    .list-filter-row { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
    /* 排序是一个下拉，别让它把整行撑满：只占右侧一小块 */
    .list-filter-row .list-sort {
      flex: none;
      width: auto;
      max-width: 46%;
      height: 30px;
      padding: 0 0.5rem;
      font-size: 0.75rem;
    }

    /* 批量条的样式在 admin.css（图片库页也用同一套） */

    /* ===== 编辑器卡片 ===== */
    /* 卡片自身不留内边距，好让底部操作条能贴齐整条边 */
    .editor-card { padding: 0; }
    .editor-body { padding: 1.25rem 1.25rem 1rem; }
    @media (min-width: 768px) {
      .editor-body { padding: 1.5rem 1.5rem 1.25rem; }
    }

    .editor-head {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
      margin-bottom: 1.125rem;
    }
    .editor-head .field-label { margin: 0; font-size: 0.875rem; }

    /* 底部操作条：长文章滚到一半也够得着保存 */
    .editor-actions {
      position: sticky;
      bottom: 0;
      z-index: 5;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
      padding: 0.75rem 1.25rem;
      background: color-mix(in oklab, var(--card-bg) 92%, transparent);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border-top: 1px solid var(--line-soft);
      border-radius: 0 0 var(--radius-large) var(--radius-large);
    }
    @media (min-width: 768px) {
      .editor-actions { padding: 0.875rem 1.5rem; }
    }
    .save-actions { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
    /* ⚠️ .edit-bar 的样式与收起已提到 admin.css（原来这里写 display:flex，
          同特异性下压掉了 .hidden → 没在编辑也常驻一条「取消编辑」） */
    .draft-hint { font-size: 0.6875rem; color: var(--text-3); margin-left: auto; }

    /* ===== 字段 ===== */
    .form-grid { display: grid; grid-template-columns: 1fr; gap: 0 1rem; }
    @media (min-width: 720px) {
      .form-grid { grid-template-columns: 1fr 1fr; }
    }
    .form-grid .full { grid-column: 1 / -1; }

    .cover-row { display: flex; gap: 0.5rem; }
    .cover-row .input-single { flex: 1; min-width: 0; }
    .cover-row .btn { flex: none; }

    .cover-preview {
      position: relative;
      margin-top: 0.625rem;
      max-width: 22rem;
      aspect-ratio: 2 / 1;
      border: 1px solid var(--line-soft);
      border-radius: var(--radius-md);
      overflow: hidden;
      background: var(--card-bg-soft);
    }
    .cover-preview img { width: 100%; height: 100%; object-fit: cover; }

    .slug-hint { font-family: var(--admin-font-mono); font-size: 0.6875rem; }
    .slug-hint .warn { color: var(--danger); }

    /* 正文区的编辑器容器：小屏时一次只看一个窗格 */
    .editor-container { --pane-min: 520px; }
    @media (max-width: 640px) {
      .editor-container { --pane-min: 340px; }
    }

    .preview-empty { padding: 2.5rem 1rem; }
  </style>
</head>
<body class={adminBodyClass}>

  {/* ⚠️ 这一层「#admin-main」外壳别删：admin.css 里的内容区宽度、核验脚本的探针都按它取。
       2026-10-03 发现这一页整段 git 历史里都没有它 —— 结果是这页不受后台外壳约束
       （宽度跟着 --page-width 走，比别的页宽出一大截），而核验在它上面是"空过"的。 */}
  <div id="admin-main">
    <AdminTopBar title="文章" />

  <div class="container">
    {/* 上次没有保存就离开时，把本地留存的草稿提示出来 */}
    <div class="restore-bar hidden" id="restore-bar">
      <span class="restore-icon" set:html={uiIcon("fluent-color:history-24")} />
      <span class="restore-text" id="restore-text"></span>
      <div class="restore-actions">
        <button class="btn btn-sm" onclick="restoreDraft()">恢复</button>
        <button class="btn btn-ghost btn-sm" onclick="discardDraft()">丢弃</button>
      </div>
    </div>

    <div class="layout-grid">
      <!-- ===== 左：文章列表 ===== -->
      <aside class="card post-list-card">
        <div class="list-header">
          <div class="field-label" style="margin:0"><span class="icon" set:html={uiIcon("fluent-color:document-text-24")} /> 已有文章</div>
          <span class="count" id="list-count"></span>
        </div>
        <button class="btn" onclick="startNewPost()" style="width:100%;margin-bottom:0.75rem;">
          <span class="admin-i" set:html={uiIcon("material-symbols:note-add")} />新建文章
        </button>
        <div class="list-filter">
          <input type="search" class="input-single" id="list-search" placeholder="搜标题 / 路径 / 标签" />
          {/* 「只看草稿」与排序并排一行：58 篇默认按发布时间倒着排，想找某一类
              的时候能换成标题/分类的顺序 —— 排序只影响**列表显示**，不动仓库。 */}
          <div class="list-filter-row">
            <label class="checkbox-row compact">
              <input type="checkbox" id="list-draft-only" />
              只看草稿
            </label>
            <select class="input-single list-sort" id="list-sort" aria-label="列表排序方式">
              <option value="date-desc">最新在前</option>
              <option value="date-asc">最早在前</option>
              <option value="title-asc">按标题</option>
              <option value="category-asc">按分类</option>
            </select>
          </div>
        </div>
        {/* 批量条（2026-10-04 加）：58 篇文章要删其中几篇时，一条条点删除太费事。
            默认藏着，勾了才出现 —— 不占平时的地方。 */}
        <div class="bulk-bar" id="bulk-bar">
          <label class="checkbox-row compact">
            <input type="checkbox" id="bulk-all" onchange="bulkToggleAll(this.checked)" />
            全选
          </label>
          <span class="bulk-count" id="bulk-count"></span>
          <span class="spacer"></span>
          <button type="button" class="btn btn-sm bulk-danger" id="bulk-delete" onclick="bulkDelete()">删除所选</button>
          <button type="button" class="btn btn-sm btn-ghost" onclick="bulkClear()">取消</button>
        </div>
        <div class="post-list-scroll">
          <div id="post-list">
            <div class="empty-state"><span class="spinner"></span><p>正在加载…</p></div>
          </div>
        </div>
      </aside>

      <!-- ===== 右：编辑器 ===== -->
      <main class="card editor-card" id="editor-card">
        <div class="editor-body">
          <div class="editor-head">
            <div class="field-label"><span class="icon" set:html={uiIcon("fluent-color:clipboard-text-edit-24")} /> <span id="editor-title">写文章</span></div>
          </div>

          <div class="form-grid">
            <div class="field full">
              <div class="field-label">标题</div>
              <input type="text" class="input-single" id="title-input" placeholder="文章标题" />
            </div>
            <div class="field">
              <div class="field-label">路径（slug）</div>
              <input type="text" class="input-single" id="slug-input" placeholder="留空按标题生成" />
              <div class="field-hint slug-hint" id="slug-hint"></div>
            </div>
            <div class="field">
              <div class="field-label">分类</div>
              <input type="text" class="input-single" id="category-input" list="category-options" placeholder="如：life" />
              <div class="field-hint">可点右侧箭头选已有分类，避免同一个分类被拼成两种写法</div>
            </div>
            <div class="field">
              <div class="field-label">标签（逗号分隔）</div>
              <input type="text" class="input-single" id="tags-input" list="tag-options" placeholder="如：Astro, 性能" />
            </div>
            <div class="field">
              <div class="field-label">发布日期</div>
              {/* 旁边那两个字是视觉标签、不是 label，补一个名字给读屏和自动化 */}
              <input type="date" id="date-input" aria-label="发布日期" />
            </div>
            <div class="field full">
              <div class="field-label">摘要（可选）</div>
              <input type="text" class="input-single" id="description-input" placeholder="一句话说明这篇写了什么" />
            </div>
            <div class="field full">
              <div class="field-label">封面</div>
              <div class="cover-row">
                <input type="text" class="input-single" id="cover-input" placeholder="https://… 或 /images/posts/…" />
                <button class="btn btn-sm" id="cover-upload-btn" onclick="pickCover()">上传图片</button>
                <input type="file" id="cover-file" accept="image/*" class="hidden" />
              </div>
              <div class="cover-preview hidden" id="cover-preview">
                <img id="cover-preview-img" alt="封面预览" loading="lazy" />
              </div>
            </div>
            <div class="field full">
              <label class="checkbox-row">
                <input type="checkbox" id="draft-input" />
                存为草稿（保存后不对外展示）
              </label>
            </div>
          </div>

          {/* 分类 / 标签的可选项，由脚本按已有文章填进去 */}
          <datalist id="category-options"></datalist>
          <datalist id="tag-options"></datalist>

          <div class="field" style="margin-top:1rem;">
            <div class="field-label">正文（Markdown，图片可直接拖进来）</div>
            <div class="editor-container" id="editor-container" data-mobile-pane="edit">
              <!-- 编辑窗格 -->
              <div class="editor-pane" data-pane="edit">
                <div class="editor-pane-header">
                  <span>Markdown</span>
                  <div class="seg mobile-only">
                    <button type="button" class="seg-btn active" data-pane-btn="edit">编辑</button>
                    <button type="button" class="seg-btn" data-pane-btn="preview">预览</button>
                  </div>
                  <div class="editor-toolbar">
                    <button type="button" class="toolbar-btn" onclick="insertMd('## ','')" title="二级标题">H2</button>
                    <button type="button" class="toolbar-btn" onclick="insertMd('### ','')" title="三级标题">H3</button>
                    <button type="button" class="toolbar-btn" onclick="insertMd('**','**')" title="加粗（Ctrl+B）"><b>B</b></button>
                    <button type="button" class="toolbar-btn" onclick="insertMd('*','*')" title="斜体（Ctrl+I）"><i>I</i></button>
                    <button type="button" class="toolbar-btn" onclick="insertMd('`','`')" title="行内代码">&lt;&gt;</button>
                    <button type="button" class="toolbar-btn" onclick="insertMd('```\n','\n```')" title="代码块" set:html={uiIcon("fluent-color:code-block-24")} />
                    <button type="button" class="toolbar-btn" onclick="insertMd('[','](url)','链接文字')" title="链接（Ctrl+K）" set:html={uiIcon("fluent-color:link-24")} />
                    <button type="button" class="toolbar-btn" id="body-upload-btn" onclick="pickBodyImage()" title="上传图片（也可以直接把图拖进来 / Ctrl+V 粘贴）" set:html={uiIcon("material-symbols:upload")} />
                    {/* 2026-10-02：从图片库挑一张插进来（不用先复制再粘贴） */}
                    <button type="button" class="toolbar-btn" onclick="pickBodyImageFromLibrary()" title="从图片库选一张" set:html={uiIcon("material-symbols:add-photo-alternate")} />
                    <button type="button" class="toolbar-btn" onclick="insertBlock('> 引用')" title="引用" set:html={uiIcon("material-symbols:format-quote")} />
                    <button type="button" class="toolbar-btn" onclick="insertBlock('- 列表项')" title="无序列表" set:html={uiIcon("fluent-color:text-bullet-list-square-24")} />
                    <button type="button" class="toolbar-btn" onclick="insertBlock('1. 列表项')" title="有序列表">1.</button>
                    <button type="button" class="toolbar-btn" onclick="insertBlock('- [ ] 待办')" title="待办列表" set:html={uiIcon("fluent-color:clipboard-task-24")} />
                    <button type="button" class="toolbar-btn" onclick="insertBlock('| 列 1 | 列 2 |\n| --- | --- |\n| 内容 | 内容 |')" title="表格" set:html={uiIcon("fluent-color:table-24")} />
                    <button type="button" class="toolbar-btn" onclick="insertBlock('---')" title="分割线">—</button>
                  </div>
                </div>
                <textarea class="editor-textarea" id="content-input" placeholder="用 Markdown 写下文章…" ondrop="onBodyDrop(event)" ondragover="onBodyDragOver(event)" spellcheck="false"></textarea>
                <input type="file" id="body-file" accept="image/*" class="hidden" />
                <div class="editor-footer">
                  <span id="content-counter">0 字</span>
                  <span class="editor-hint"><kbd>Ctrl</kbd>+<kbd>B</kbd> 加粗 · <kbd>Ctrl</kbd>+<kbd>K</kbd> 链接 · <kbd>Ctrl</kbd>+<kbd>S</kbd> 保存 · <kbd>Tab</kbd> 缩进 · <b>图片可直接拖进来或 Ctrl+V</b> · <b>从 Word／网页复制的内容粘进来自动转格式</b></span>
                </div>
              </div>

              <!-- 预览窗格 -->
              <div class="editor-pane" data-pane="preview">
                <div class="editor-pane-header">
                  <span>预览</span>
                  <div class="seg mobile-only">
                    <button type="button" class="seg-btn" data-pane-btn="edit">编辑</button>
                    <button type="button" class="seg-btn active" data-pane-btn="preview">预览</button>
                  </div>
                </div>
                <div class="preview-pane" id="preview-pane">
                  <div class="empty-state preview-empty"><p>开始写就能在这里看到成稿的样子</p></div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="editor-actions">
          <button class="btn btn-primary" id="save-btn" onclick="savePost()">发布文章</button>
          <div class="edit-bar hidden" id="edit-bar">
            <button class="btn btn-ghost" onclick="cancelEdit()">取消编辑</button>
            <a class="btn btn-ghost hidden" id="view-post-btn" href="#" target="_blank" rel="noopener">查看前台</a>
          </div>
          <span class="draft-hint" id="draft-hint"></span>
        </div>
      </main>
    </div>

  </div>

  </div>

  <div class="toast" id="toast"></div>

  <script is:inline src="/js/editor-commons.js"></script>
  <script is:inline src="/js/admin-github.js"></script>
  <script is:inline src="/js/admin-media.js"></script>
  <script is:inline data-config={postsConfig}
    data-media-icons={JSON.stringify({
      upload: uiIcon("material-symbols:upload"),
      close: uiIcon("material-symbols:close"),
    })}
    // ⚠️ 图标名必须先去 @iconify-json/*/icons.json 核对存在（写错不报错，前台就是一个空白框），
    //    并且要加进 scripts/generate-icons.js 的 EXPLICIT_ICONS —— uiIcon() 只认那份清单，漏了静默返回空串。
    data-icons={JSON.stringify({
      note: uiIcon("fluent-color:document-text-24"),
      draftNote: uiIcon("fluent-color:document-edit-24"),
      filterOff: uiIcon("fluent-color:options-24"),
      // 控件类图标：单色（与全站约定一致，彩色只给内容类）
      view: uiIcon("material-symbols:open-in-new"),
      edit: uiIcon("material-symbols:edit"),
      del: uiIcon("material-symbols:delete"),
      draft: uiIcon("material-symbols:draft"),
    })}>
    var _script = document.currentScript;
    var CONFIG = JSON.parse(_script.getAttribute("data-config") || "{}");
    // 图标走属性传进来：SVG 字符串里有引号，直接写进脚本正文会打架
    var ICONS = JSON.parse(_script.getAttribute("data-icons") || "{}");
    // 图片能力（共用 /js/admin-media.js）：这一页的上传仍走自己的 uploadImage
    //（图片放 posts/<slug>/ 下，跟文章绑在一起），这里只借它的"从图片库选一张"。
    WBMedia.init({
      owner: CONFIG.owner, repo: CONFIG.repo, branch: CONFIG.branch,
      uploadDir: "public/images/uploads",
      listRoot: "public/images",
      icons: JSON.parse(_script.getAttribute("data-media-icons") || "{}"),
    });
    var posts = [];
    var editingPath = "";
    var editingSha = "";
    var slugAutoMode = true;
    var editingFm = {};
    // 当前列表的搜索词、"只看草稿"开关与排序方式，供 renderList 过滤与排序
    var listKeyword = "";
    var listDraftOnly = false;
    var listSort = "date-desc"; // date-desc | date-asc | title-asc | category-asc
    // 本地草稿与"是否有未保存改动"的判定基线
    var draftStore = WBEditor.createDraftStore("post");
    var cleanSnapshot = "";

    function $(id) { return document.getElementById(id); }
    function esc(t) { var d = document.createElement("div"); d.textContent = t; return d.innerHTML; }
    function toast(msg, type) {
      var el = $("toast"); el.textContent = msg; el.className = "toast " + type + " show";
      clearTimeout(el._t); el._t = setTimeout(function() { el.className = "toast"; }, 2800);
    }
    function doLogout() { localStorage.removeItem("admin_auth"); fetch("/api/auth/logout", { method: "POST" }).catch(function() {}); window.location.href = "/admin/"; }
    function setStatus(ok, text) {
      $("status-dot").className = "status-dot " + (ok ? "ok" : "err");
      $("status-text").textContent = text;
    }
    function todayStr() {
      var d = new Date();
      return d.getFullYear() + "-" + String(d.getMonth() + 1).padStart(2, "0") + "-" + String(d.getDate()).padStart(2, "0");
    }
    function slugFromPath(path) {
      var prefix = CONFIG.postsPath + "/";
      return path.indexOf(prefix) === 0 ? path.slice(prefix.length).replace(/\.(md|mdx)$/i, "") : path;
    }

    function b64EncodeUnicode(str) {
      var bytes = new TextEncoder().encode(str);
      var bin = "";
      bytes.forEach(function(b) { bin += String.fromCharCode(b); });
      return btoa(bin);
    }
    function b64DecodeUnicode(str) {
      var bin = atob(str);
      var bytes = new Uint8Array(bin.length);
      for (var i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
      return new TextDecoder("utf-8").decode(bytes);
    }

    // ===== 认证 =====
    function checkAuth() {
      return fetch("/api/auth/status")
        .then(function(r) { return r.json(); })
        .then(function(d) {
          if (!d.authed) { window.location.href = "/admin/"; return false; }
          return true;
        })
        .catch(function() { window.location.href = "/admin/"; return false; });
    }
    function connect() {
      setStatus(true, "已连接");
      loadPosts();
    }

    // ===== 文章列表 =====
    // 每篇正文都要单独取一次才知道标题、日期、草稿状态，66 篇就是 66 次请求。
    // 所以把读到的元信息连文件指纹一起存在本地：git 返回的 blob sha 没变，
    // 说明这份缓存还是当前版本，直接复用；一旦文件被改过，sha 就变了，自动失效。
    // 于是第一次打开要等一会儿，之后打开是瞬间的。
    var META_CACHE_KEY = "wb-postmeta-cache";
    var metaCache = readMetaCache();

    function readMetaCache() {
      try {
        var raw = localStorage.getItem(META_CACHE_KEY);
        var parsed = raw ? JSON.parse(raw) : null;
        return parsed && typeof parsed === "object" ? parsed : {};
      } catch (e) {
        return {};
      }
    }
    function writeMetaCache() {
      try { localStorage.setItem(META_CACHE_KEY, JSON.stringify(metaCache)); } catch (e) { /* 存不下就算了 */ }
    }

    function loadPosts() {
      $("post-list").innerHTML = '<div class="empty-state"><span class="spinner"></span><p>正在加载…</p></div>';
      WBGitHub.request("/repos/" + CONFIG.owner + "/" + CONFIG.repo + "/git/trees/" + CONFIG.branch + "?recursive=1")
        .then(function(tree) {
          var blobs = (tree.tree || []).filter(function(item) {
            return item.type === "blob" &&
              item.path.indexOf(CONFIG.postsPath + "/") === 0 &&
              /\.(md|mdx)$/i.test(item.path);
          });
          posts = [];
          var needFetch = 0;
          return Promise.all(blobs.map(function(item) {
            return fetchPostMeta(item.path, item.sha).then(function(cached) {
              if (!cached) needFetch++;
              return null;
            });
          })).then(function() { return needFetch; });
        })
        .then(function(needFetch) {
          writeMetaCache();
          posts.sort(function(a, b) {
            return new Date(b.published || 0) - new Date(a.published || 0);
          });
          renderList();
          fillSuggestions();
          setStatus(true, "已连接 · " + posts.length + " 篇");
          applyDeepLink();
        })
        .catch(function(e) {
          $("post-list").innerHTML = '<div class="empty-state" style="color:var(--danger)">加载失败：' + esc(e.message) + '</div>';
          setStatus(false, "加载失败");
        });
    }

    /**
     * 取一篇文章的元信息。
     * blobSha 与缓存里记的一致时直接用缓存，不发请求 —— 返回 true 表示"命中缓存"。
     */
    function fetchPostMeta(path, blobSha) {
      var hit = metaCache[path];
      if (hit && blobSha && hit.blobSha === blobSha) {
        posts.push(hit.meta);
        return Promise.resolve(true);
      }
      return getFileMeta(path)
        .then(function(file) {
          if (!file) throw new Error("仓库里读不到这个文件：" + path);
          var md = b64DecodeUnicode(file.content || "");
          var parsed = parsePost(md);
          var meta = {
            path: path,
            sha: file.sha,
            slug: path.replace(new RegExp("^" + CONFIG.postsPath + "/"), "").replace(/\.(md|mdx)$/i, ""),
            title: parsed.fm.title || path,
            published: String(parsed.fm.published || "").slice(0, 10),
            category: parsed.fm.category || "",
            draft: parsed.fm.draft === true || parsed.fm.draft === "true",
            tags: parsed.fm.tags || [],
          };
          posts.push(meta);
          metaCache[path] = { blobSha: blobSha || file.sha, meta: meta };
          return false;
        });
    }

    /** 把已有文章里出现过的分类与标签填进候选项 */
    function fillSuggestions() {
      var cats = {}, tags = {};
      posts.forEach(function(p) {
        if (p.category && cats[p.category] !== 1) cats[p.category] = 1;
        (p.tags || []).forEach(function(t) { if (t) tags[t] = 1; });
      });
      $("category-options").innerHTML = Object.keys(cats).sort().map(function(c) {
        return '<option value="' + esc(c) + '"></option>';
      }).join("");
      $("tag-options").innerHTML = Object.keys(tags).sort().map(function(t) {
        return '<option value="' + esc(t) + '"></option>';
      }).join("");
    }

    /**
     * `?edit=<slug>` 深链：直接进某篇的编辑器。
     * 为什么加：后台首页要能列出「最近在写的几篇」并且一点就进编辑 ——
     * 否则每次都得"进文章管理 → 在一长串里找那一篇"，这才是真费事的地方。
     * slug 就是文章 id（如 `life/end-of-september`），与 /api/allPostMeta.json 的 id 一致。
     */
    function applyDeepLink() {
      var want = "";
      try {
        want = new URLSearchParams(location.search).get("edit") || "";
      } catch (e) {
        return;
      }
      if (!want) return;
      var hit = posts.filter(function(p) { return p.slug === want || p.path === want; })[0];
      if (hit) {
        editPost(hit.path);
      } else {
        toast("没找到这篇：" + want, "err");
      }
    }

    // ===== 批量选择 / 批量删除（2026-10-04 加）=====
    // 58 篇文章删其中几篇时，一条条点太费事。picked[path]=true 表示勾上了，
    // 列表重绘（搜索、刷新）后仍然保留 —— 否则一搜就白勾。
    var picked = {};

    function pickedCount() { return Object.keys(picked).length; }

    function syncBulkBar() {
      var bar = $("bulk-bar");
      if (!bar) return;
      var n = pickedCount();
      bar.classList.toggle("on", n > 0);
      if (n) $("bulk-count").textContent = "已选 " + n + " 篇";
      // 全选框反映"当前可见的那些"是否都勾上了；勾一部分时显示半选
      var boxes = [].slice.call(document.querySelectorAll("#post-list input[data-pick]"));
      var allChecked = boxes.length > 0 && boxes.every(function (b) { return b.checked; });
      var all = $("bulk-all");
      if (all) {
        all.checked = allChecked;
        all.indeterminate = !allChecked && boxes.some(function (b) { return b.checked; });
      }
    }

    function bulkToggleAll(checked) {
      posts.filter(matchesFilter).forEach(function (p) {
        if (checked) picked[p.path] = true; else delete picked[p.path];
      });
      renderList();
    }

    function bulkClear() { picked = {}; renderList(); }

    function bulkDelete() {
      var paths = Object.keys(picked);
      if (!paths.length) return;
      var titles = paths.map(function (p) {
        var hit = posts.filter(function (x) { return x.path === p; })[0];
        return hit ? hit.title : p;
      });
      var head = titles.slice(0, 5).join("\n");
      if (!confirm(
        "确定删除这 " + paths.length + " 篇文章？\n\n" + head +
        (titles.length > 5 ? "\n…（共 " + titles.length + " 篇）" : "") +
        "\n\n文章图片也会一并删除，删掉找不回来。"
      )) return;
      var btn = $("bulk-delete");
      if (btn) { btn.disabled = true; btn.textContent = "删除中…"; }
      var failed = [];
      // 一篇一篇顺序删：GitHub 接口并发写容易撞限流
      var chain = Promise.resolve();
      paths.forEach(function (p) {
        chain = chain
          .then(function () { return deletePostFile(p); })
          .catch(function (e) { failed.push(p + "：" + e.message); });
      });
      chain.then(function () {
        if (btn) { btn.disabled = false; btn.textContent = "删除所选"; }
        var okCount = paths.length - failed.length;
        if (editingPath && paths.indexOf(editingPath) >= 0) newPost();
        picked = {};
        toast(failed.length ? "删了 " + okCount + " 篇，" + failed.length + " 篇失败" : "已删除 " + okCount + " 篇", failed.length ? "err" : "ok");
        if (failed.length) console.warn("批量删除没成功的：", failed);
        loadPosts();
      });
    }

    function matchesFilter(post) {
      if (listDraftOnly && !post.draft) return false;
      if (!listKeyword) return true;
      var hay = [post.title, post.path, post.slug, post.category]
        .concat(post.tags || [])
        .join(" ")
        .toLowerCase();
      return hay.indexOf(listKeyword) !== -1;
    }
    /* 列表排序：只改**显示顺序**，不改 posts 本身、更不写回仓库。
       默认「最新在前」＝按发布时间倒排（原来就这一种）；其余三种是给"想按
       标题或分类找某一篇"用的。同分类内仍按发布时间倒排，免得顺序看着随机。 */
    function sortedShown(list) {
      var out = list.slice();
      var byDateDesc = function(a, b) { return new Date(b.published || 0) - new Date(a.published || 0); };
      if (listSort === "date-asc") {
        out.sort(function(a, b) { return new Date(a.published || 0) - new Date(b.published || 0); });
      } else if (listSort === "title-asc") {
        out.sort(function(a, b) { return String(a.title || "").localeCompare(String(b.title || ""), "zh-Hans-CN") || byDateDesc(a, b); });
      } else if (listSort === "category-asc") {
        out.sort(function(a, b) {
          return String(a.category || "").localeCompare(String(b.category || ""), "zh-Hans-CN") || byDateDesc(a, b);
        });
      } else {
        out.sort(byDateDesc);
      }
      return out;
    }
    function renderList() {
      var shown = sortedShown(posts.filter(matchesFilter));
      $("list-count").textContent = shown.length === posts.length
        ? posts.length + " 篇"
        : shown.length + " / " + posts.length + " 篇";
      if (!posts.length) {
        $("post-list").innerHTML = '<div class="empty-state"><div class="icon">' + ICONS.note + '</div><p>还没有文章，点「新建文章」开始</p></div>';
        syncBulkBar();
        return;
      }
      if (!shown.length) {
        $("post-list").innerHTML = '<div class="empty-state"><div class="icon">' + ICONS.filterOff + '</div><p>没有符合条件的文章</p></div>';
        syncBulkBar();
        return;
      }
      $("post-list").innerHTML = "";
      shown.forEach(function(post) {
        var row = document.createElement("div");
        row.className = "post-row" + (picked[post.path] ? " picked" : "");
        row.innerHTML =
          // 行首勾选框（批量用）＋ 一枚内容图标：内容类用彩色（.post-icon 在 admin.css 里定尺寸）
          '<label class="row-check" title="选中这篇"><input type="checkbox" data-pick="' + escapeAttr(post.path) + '"' + (picked[post.path] ? " checked" : "") + " /></label>" +
          '<span class="admin-i post-icon">' + (post.draft ? ICONS.draftNote : ICONS.note) + '</span>' +
          '<div class="post-info">' +
          '<div class="post-title">' + esc(post.title) + '</div>' +
          '<div class="post-meta">' +
          '<span>' + esc(post.published) + '</span>' +
          (post.category ? '<span class="sep">·</span><span>' + esc(post.category) + '</span>' : "") +
          (post.draft ? '<span class="post-badge draft"><span class="admin-i">' + ICONS.draft + '</span>草稿</span>' : '') +
          '</div></div>' +
          '<div class="post-actions">' +
          // 「查看」直接开站上那一页（新标签），省得自己去拼地址
          // 按钮文字包一层 .btn-t：左栏窄的时候（容器 <520px）只留图标，宽了才把文字放出来。
          // 这样三个按钮在窄栏里总共只要 ~110px，标题不会被挤成竖排。
          // 带 from=admin：前台那一页据此显示一个「← 回到后台」浮标（访客看不到）
          '<a class="btn btn-sm" target="_blank" rel="noopener" href="' + postUrl(post.path) + '?from=admin" title="在新标签打开站上的这一篇（那一页左下角有「回到后台」）"><span class="admin-i">' + ICONS.view + '</span><span class="btn-t">查看</span></a>' +
          '<button class="btn btn-sm" title="编辑" onclick="editPost(\'' + escapeAttr(post.path) + '\')"><span class="admin-i">' + ICONS.edit + '</span><span class="btn-t">编辑</span></button>' +
          '<button class="btn-danger-sm" title="删除" onclick="deletePost(\'' + escapeAttr(post.path) + '\')"><span class="admin-i">' + ICONS.del + '</span><span class="btn-t">删除</span></button>' +
          '</div>';
        $("post-list").appendChild(row);
      });
      syncBulkBar();
    }

    // 勾选用事件委托：列表每次重绘都会换掉 DOM，逐个绑监听会漏。
    $("post-list").addEventListener("change", function (e) {
      var t = e.target;
      if (!t || !t.getAttribute || !t.getAttribute("data-pick")) return;
      var path = t.getAttribute("data-pick");
      if (t.checked) picked[path] = true; else delete picked[path];
      var row = t.closest(".post-row");
      if (row) row.classList.toggle("picked", t.checked);
      syncBulkBar();
    });
    // 文章在站上的地址：src/content/posts/life/xxx.md → /posts/life/xxx/
    function postUrl(p) {
      return "/posts/" + String(p).replace(/^src\/content\/posts\//, "").replace(/\.md$/, "") + "/";
    }
    function escapeAttr(s) {
      return s.replace(/\\/g, "\\\\").replace(/'/g, "\\'");
    }

    // ===== frontmatter 解析 =====
    function parsePost(md) {
      var fm = {};
      var body = md;
      var m = md.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n?/);
      if (m) {
        body = md.slice(m[0].length);
        m[1].split(/\r?\n/).forEach(function(line) {
          var kv = line.match(/^([A-Za-z_][\w]*):\s*(.*)$/);
          if (!kv) return;
          var key = kv[1], value = kv[2].trim();
          if (key === "tags") {
            try { fm.tags = JSON.parse(value); } catch (e) {
              fm.tags = value.replace(/^\[|\]$/g, "").split(",").map(function(s) { return s.trim().replace(/^["']|["']$/g, ""); }).filter(Boolean);
            }
          } else if (key === "draft" || key === "pinned" || key === "comment") {
            fm[key] = value === "true";
          } else {
            fm[key] = value.replace(/^["']|["']$/g, "");
          }
        });
      }
      return { fm: fm, body: body.trim() };
    }

    // ===== 表单 =====
    function fillForm(fm, body) {
      $("title-input").value = fm.title || "";
      $("slug-input").value = (fm.slug || "");
      $("category-input").value = fm.category && fm.category !== "null" ? fm.category : "";
      $("tags-input").value = (fm.tags || []).join(", ");
      $("date-input").value = String(fm.published || todayStr()).slice(0, 10);
      $("description-input").value = fm.description || "";
      $("cover-input").value = fm.image || "";
      $("draft-input").checked = fm.draft === true || fm.draft === "true";
      $("content-input").value = body || "";
      slugAutoMode = false;
      refreshDerived();
      updatePreview();
      updateCounter();
      markClean();
    }
    function resetForm() {
      $("title-input").value = "";
      $("slug-input").value = "";
      $("category-input").value = "";
      $("tags-input").value = "";
      $("date-input").value = todayStr();
      $("description-input").value = "";
      $("cover-input").value = "";
      $("draft-input").checked = false;
      $("content-input").value = "";
      slugAutoMode = true;
      refreshDerived();
      updatePreview();
      updateCounter();
      markClean();
    }
    function newPost() {
      editingPath = "";
      editingSha = "";
      resetForm();
      editingFm = {};
      $("editor-title").textContent = "写文章";
      $("save-btn").textContent = "发布文章";
      $("edit-bar").classList.add("hidden");
      window.scrollTo({ top: 0, behavior: "smooth" });
      toast("开始写新文章", "ok");
    }
    function startNewPost() {
      if (!confirmDiscardIfDirty("开始写新文章")) return;
      newPost();
    }
    function cancelEdit() {
      if (!confirmDiscardIfDirty("取消编辑")) return;
      newPost();
    }
    function editPost(path) {
      if (!confirmDiscardIfDirty("切换到另一篇")) return;
      getFileMeta(path)
        .then(function(file) {
          if (!file) throw new Error("仓库里读不到这个文件：" + path);
          var parsed = parsePost(b64DecodeUnicode(file.content || ""));
          editingPath = path;
          editingSha = file.sha;
          parsed.fm.slug = path.replace(new RegExp("^" + CONFIG.postsPath + "/"), "").replace(/\.(md|mdx)$/i, "");
          editingFm = parsed.fm;
          fillForm(parsed.fm, parsed.body);
          $("editor-title").textContent = "编辑文章";
          $("save-btn").textContent = "保存修改";
          $("edit-bar").classList.remove("hidden");
          window.scrollTo({ top: 0, behavior: "smooth" });
          toast("正在编辑：" + (parsed.fm.title || path), "ok");
        })
        .catch(function(e) { toast("加载失败：" + e.message, "err"); });
    }

    // ===== slug =====
    function slugifyTitle(title) {
      var s = (title || "").trim().toLowerCase()
        .replace(/\s+/g, "-")
        .replace(/[^\w\u4e00-\u9fa5-]+/g, "")
        .replace(/-+/g, "-")
        .replace(/^-+|-+$/g, "");
      return s || "post-" + todayStr();
    }
    function ensureSlug() {
      var slug = $("slug-input").value.trim();
      if (!slug) {
        slug = slugifyTitle($("title-input").value);
        $("slug-input").value = slug;
      }
      return slug;
    }
    $("title-input").addEventListener("input", function() {
      if (slugAutoMode) {
        $("slug-input").value = slugifyTitle(this.value);
        refreshDerived();
      }
    });
    $("slug-input").addEventListener("input", function() {
      slugAutoMode = false;
      refreshDerived();
    });

    // ===== 保存 =====
    function buildMarkdown() {
      var title = $("title-input").value.trim();
      var date = $("date-input").value || todayStr();
      var category = $("category-input").value.trim();
      var tags = $("tags-input").value.split(/[,，]/).map(function(s) { return s.trim(); }).filter(Boolean);
      var description = $("description-input").value.trim();
      var cover = $("cover-input").value.trim();
      var draft = $("draft-input").checked;
      var body = $("content-input").value.trim();
      var lines = ["---", "title: " + JSON.stringify(title), "published: " + date];
      if (description) lines.push("description: " + JSON.stringify(description));
      if (cover) lines.push("image: " + JSON.stringify(cover));
      lines.push("tags: " + JSON.stringify(tags));
      if (category) lines.push("category: " + JSON.stringify(category));
      lines.push("draft: " + draft);
      var knownKeys = ["title", "published", "description", "image", "tags", "category", "draft", "slug"];
      Object.keys(editingFm).forEach(function(key) {
        if (knownKeys.indexOf(key) !== -1) return;
        var v = editingFm[key];
        if (v === undefined || v === null || v === "") return;
        lines.push(key + ": " + (typeof v === "boolean" || typeof v === "number" ? String(v) : JSON.stringify(v)));
      });
      lines.push("---");
      lines.push("");
      lines.push(body);
      return lines.join("\n");
    }
    function putTextFile(path, text, sha, message) {
      return WBGitHub.putFile({
        owner: CONFIG.owner, repo: CONFIG.repo, path: path, branch: CONFIG.branch,
        content: b64EncodeUnicode(text), message: message, sha: sha
      });
    }
    // 读文件：文件不存在返回 null（不是报错）—— 调用方靠它区分"新建"与"更新"
    function getFileMeta(path) {
      return WBGitHub.getFile({
        owner: CONFIG.owner, repo: CONFIG.repo, path: path, branch: CONFIG.branch
      });
    }
    function deleteFile(path, sha, message) {
      return WBGitHub.deleteFile({
        owner: CONFIG.owner, repo: CONFIG.repo, path: path, branch: CONFIG.branch,
        sha: sha, message: message
      });
    }
    function listImagesDir(slug) {
      return WBGitHub.listDir({
        owner: CONFIG.owner, repo: CONFIG.repo, branch: CONFIG.branch,
        path: CONFIG.imagesPath + "/" + slug
      });
    }
    function deleteImagesForPost(slug) {
      return listImagesDir(slug).then(function(files) {
        var list = files.filter(function(f) { return f.type === "file"; });
        return Promise.all(list.map(function(f) {
          return deleteFile(f.path, f.sha, "删除文章图片: " + f.path);
        }));
      });
    }
    function putBase64File(path, content, message) {
      return WBGitHub.putFile({
        owner: CONFIG.owner, repo: CONFIG.repo, path: path, branch: CONFIG.branch,
        content: content, message: message
      });
    }
    function moveImageFile(oldPath, newPath) {
      return getFileMeta(oldPath).then(function(file) {
        if (!file || !file.sha || !file.content) throw new Error("读取图片失败: " + oldPath);
        return putBase64File(newPath, file.content, "移动文章图片: " + newPath)
          .then(function() { return deleteFile(oldPath, file.sha, "移动文章图片: " + oldPath); });
      });
    }
    function moveImagesForPost(oldSlug, newSlug) {
      return listImagesDir(oldSlug).then(function(files) {
        var list = files.filter(function(f) { return f.type === "file"; });
        return Promise.all(list.map(function(f) {
          var name = f.path.split("/").pop();
          return moveImageFile(f.path, CONFIG.imagesPath + "/" + newSlug + "/" + name);
        }));
      });
    }
    function savePost() {
      var title = $("title-input").value.trim();
      var body = $("content-input").value.trim();
      if (!title) { toast("请填写标题", "err"); return; }
      if (!body) { toast("请填写正文", "err"); return; }

      // 先把本地这份写下来：万一这次没存进仓库，内容也还在
      saveDraftNow();
      clearTimeout(autosaveTimer);

      var slug = ensureSlug();
      var newPath = CONFIG.postsPath + "/" + slug + ".md";
      var btn = $("save-btn");
      btn.disabled = true;
      var originalText = btn.textContent;
      btn.textContent = "保存中…";
      var isNew = !editingPath;
      var renamingFrom = editingPath && editingPath !== newPath ? editingPath : "";
      var newSlug = slugFromPath(newPath);
      if (renamingFrom) {
        var oldImgPrefix = "/images/posts/" + slugFromPath(renamingFrom) + "/";
        var newImgPrefix = "/images/posts/" + newSlug + "/";
        $("cover-input").value = $("cover-input").value.split(oldImgPrefix).join(newImgPrefix);
        $("content-input").value = $("content-input").value.split(oldImgPrefix).join(newImgPrefix);
      }
      var md = buildMarkdown();

      function finish(okMsg) {
        toast(okMsg, "ok");
        btn.disabled = false;
        btn.textContent = originalText;
        editingPath = newPath;
        editingSha = "";
        // 内容已经进了仓库，本地那份临时草稿就没用了
        clearDraft();
        markClean();
        refreshDerived();
        loadPosts();
      }

      function doPut(sha) {
        putTextFile(newPath, md, sha, (renamingFrom || !isNew ? "更新文章: " : "发布文章: ") + title)
          .then(function() {
            editingPath = newPath;
            if (!renamingFrom) return;
            return moveImagesForPost(slugFromPath(renamingFrom), newSlug)
              .catch(function(e) {
                toast("文章已保存，但图片目录迁移失败: " + e.message, "err");
              })
              .then(function() {
                return getFileMeta(renamingFrom).then(function(old) {
                  if (old.sha) return deleteFile(renamingFrom, old.sha, "文章改名: " + title);
                });
              })
              .catch(function(e) {
                toast("文章已保存，但旧文件删除失败: " + e.message, "err");
              });
          })
          .then(function() { finish(isNew ? "发布成功 ✓" : "已保存 ✓"); })
          .catch(function(e) {
            toast("保存失败：" + e.message, "err");
            btn.disabled = false;
            btn.textContent = originalText;
          });
      }

      if (editingPath) {
        getFileMeta(editingPath).then(function(file) { doPut(file && file.sha ? file.sha : ""); })
          .catch(function() { doPut(""); });
      } else {
        getFileMeta(newPath).then(function(file) {
          if (file && file.sha && !confirm("仓库已有同名文章，确定覆盖？")) throw new Error("已取消");
          doPut(file && file.sha ? file.sha : "");
        }).catch(function(e) {
          if (e && e.message === "已取消") {
            btn.disabled = false;
            btn.textContent = originalText;
            return;
          }
          doPut("");
        });
      }
    }

    // ===== 删除 =====
    /** 删一篇文章的仓库文件（连它的图片一起）。不弹确认、不刷列表 —— 单条与批量共用。 */
    function deletePostFile(path) {
      return getFileMeta(path).then(function(file) {
        if (!file || !file.sha) throw new Error("仓库里找不到这个文件，可能已经被删掉了");
        var slug = slugFromPath(path);
        return deleteFile(path, file.sha, "删除文章: " + path)
          .then(function() {
            return deleteImagesForPost(slug).catch(function(e) {
              toast("文章已删除，但图片清理失败: " + e.message, "err");
              return null;
            });
          });
      });
    }

    function deletePost(path) {
      if (!confirm("确定删除这篇文章？文章图片也会一并删除。")) return;
      deletePostFile(path).then(function() {
        toast("已删除", "ok");
        if (editingPath === path) newPost();
        loadPosts();
      }).catch(function(e) {
        toast("删除失败：" + e.message, "err");
      });
    }

    // ===== Markdown 预览 =====
    // 后台是独立页面，拿不到博客构建时的 Markdown 管线，所以这里自己过一遍。
    // 按行分块解析（标题 / 代码块 / 引用 / 表格 / 列表 / 段落），再处理行内语法，
    // 比一条条正则替换可靠得多 —— 表格、待办列表、带语言的代码块都能出来。
    function escapeHtml(s) {
      return String(s)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        // 引号也转掉：后面会把 alt / href 拼进属性里，留着裸引号会把标签拆坏
        .replace(/"/g, "&quot;");
    }

    function renderInline(text) {
      var codes = [];
      // 行内代码先抽出来，免得里面的 ** 又被当成加粗
      var t = text.replace(/`([^`]+)`/g, function(m, code) {
        codes.push(code);
        return "\u0000" + (codes.length - 1) + "\u0000";
      });
      t = t
        .replace(/!\[([^\]]*)\]\(([^)\s]+)\)/g, '<img src="$2" alt="$1" loading="lazy">')
        .replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>')
        .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>")
        .replace(/(^|[^*])\*([^*\n]+)\*/g, "$1<em>$2</em>")
        .replace(/~~([^~]+)~~/g, "<del>$1</del>");
      t = t.replace(/\u0000(\d+)\u0000/g, function(m, i) {
        return "<code>" + codes[Number(i)] + "</code>";
      });
      return t;
    }

    function renderMarkdown(md) {
      if (!md) return "";
      var lines = escapeHtml(md.replace(/\r\n?/g, "\n")).split("\n");
      var out = [];
      var i = 0;
      var tableSep = /^\s*\|?\s*:?-{2,}:?\s*(\|\s*:?-{2,}:?\s*)*\|?\s*$/;

      function isBlockStart(line) {
        return /^\s*(#{1,4})\s+/.test(line) ||
          /^\s*(```|~~~)/.test(line) ||
          /^\s*>/.test(line) ||
          /^\s*([-*+]|\d+\.)\s+/.test(line) ||
          /^\s*([-*_])\1{2,}\s*$/.test(line);
      }

      while (i < lines.length) {
        var line = lines[i];

        // 空行
        if (!line.trim()) { i++; continue; }

        // 围栏代码块
        var fence = line.match(/^\s*(```|~~~)\s*(\S*)\s*$/);
        if (fence) {
          var closer = fence[1];
          var lang = fence[2];
          var buf = [];
          i++;
          while (i < lines.length && !new RegExp("^\\s*" + closer).test(lines[i])) {
            buf.push(lines[i]);
            i++;
          }
          i++; // 跳过结束围栏
          out.push(
            '<pre data-lang="' + (lang || "") + '"><code>' + buf.join("\n") + "</code></pre>"
          );
          continue;
        }

        // 标题
        var h = line.match(/^\s*(#{1,4})\s+(.*)$/);
        if (h) {
          var level = h[1].length;
          out.push("<h" + level + ">" + renderInline(h[2].trim()) + "</h" + level + ">");
          i++;
          continue;
        }

        // 分割线
        if (/^\s*([-*_])\1{2,}\s*$/.test(line)) {
          out.push("<hr>");
          i++;
          continue;
        }

        // 表格：本行含 |，下一行是分隔行
        if (line.indexOf("|") !== -1 && i + 1 < lines.length && tableSep.test(lines[i + 1])) {
          var cells = function(row) {
            return row.replace(/^\s*\|/, "").replace(/\|\s*$/, "").split("|").map(function(c) { return c.trim(); });
          };
          var head = cells(line);
          i += 2;
          var rows = [];
          while (i < lines.length && lines[i].indexOf("|") !== -1 && lines[i].trim()) {
            rows.push(cells(lines[i]));
            i++;
          }
          var html = "<table><thead><tr>" +
            head.map(function(c) { return "<th>" + renderInline(c) + "</th>"; }).join("") +
            "</tr></thead><tbody>" +
            rows.map(function(r) {
              return "<tr>" + r.map(function(c) { return "<td>" + renderInline(c) + "</td>"; }).join("") + "</tr>";
            }).join("") +
            "</tbody></table>";
          out.push(html);
          continue;
        }

        // 引用
        if (/^\s*>/.test(line)) {
          var quote = [];
          while (i < lines.length && /^\s*>/.test(lines[i])) {
            quote.push(lines[i].replace(/^\s*>\s?/, ""));
            i++;
          }
          out.push("<blockquote><p>" + renderInline(quote.join("<br>")) + "</p></blockquote>");
          continue;
        }

        // 列表：连续的同类行合成一个 ul / ol，[-] 或 [x] 开头的是待办
        var li = line.match(/^\s*([-*+]|\d+\.)\s+(.*)$/);
        if (li) {
          var ordered = /\d+\./.test(li[1]);
          var items = [];
          while (i < lines.length) {
            var m2 = lines[i].match(/^\s*([-*+]|\d+\.)\s+(.*)$/);
            if (!m2) break;
            if (/\d+\./.test(m2[1]) !== ordered) break;
            var text = m2[2];
            var task = text.match(/^\[( |x|X)\]\s*(.*)$/);
            if (task) {
              items.push(
                '<li><input type="checkbox" disabled' + (task[1].toLowerCase() === "x" ? " checked" : "") +
                "> " + renderInline(task[2]) + "</li>"
              );
            } else {
              items.push("<li>" + renderInline(text) + "</li>");
            }
            i++;
          }
          var tag = ordered ? "ol" : "ul";
          out.push("<" + tag + ">" + items.join("") + "</" + tag + ">");
          continue;
        }

        // 段落：收拢到下一个空行或下一个块级起点
        var para = [];
        while (i < lines.length && lines[i].trim() && !isBlockStart(lines[i])) {
          para.push(lines[i]);
          i++;
          // 单独的图片行不跟后面的文字粘成一段
          if (i < lines.length && /^\s*!\[[^\]]*\]\([^)]+\)\s*$/.test(lines[i - 1])) break;
        }
        var paraText = para.join("\n");
        // 整段只有一张图时，按博客的样式配上图注
        var soloImg = paraText.trim().match(/^!\[([^\]]*)\]\(([^)\s]+)\)$/);
        if (soloImg) {
          out.push(
            "<figure><img src=\"" + soloImg[2] + "\" alt=\"" + soloImg[1] + "\" loading=\"lazy\">" +
            (soloImg[1] ? "<figcaption>" + soloImg[1] + "</figcaption>" : "") +
            "</figure>"
          );
        } else {
          out.push("<p>" + renderInline(paraText).replace(/\n/g, "<br>") + "</p>");
        }
      }
      return out.join("\n");
    }

    /**
     * 刚上传的图片：正式地址 → 本地 blob 的映射（2026-10-03 加）。
     *
     * 为什么需要：上传后正文里写的是 /images/posts/<slug>/xxx.webp，而这张图
     * **要等 Cloudflare 重新构建（一两分钟）站上才存在** —— 在那之前预览里
     * 就是一张裂图，站长会以为"预览不支持图片"。
     * 所以本地记一份副本：预览渲染完把 src 换成 blob，保存/提交仍是正式地址。
     * 只活在这次会话里，刷新页面就没了（那时图也已经构建好了）。
     */
    var freshImages = {};

    /** 把预览 HTML 里"刚上传、站上还没有"的图换成本地副本 */
    function swapFreshImages(html) {
      var keys = Object.keys(freshImages);
      if (!keys.length) return html;
      return html.replace(/src="([^"]+)"/g, function(m, src) {
        return freshImages[src] ? 'src="' + freshImages[src] + '" data-fresh="1"' : m;
      });
    }

    var previewTimer = null;
    function updatePreview() {
      clearTimeout(previewTimer);
      previewTimer = setTimeout(function() {
        var md = $("content-input").value;
        $("preview-pane").innerHTML = md
          ? swapFreshImages(renderMarkdown(md))
          : '<div class="empty-state preview-empty"><p>开始写就能在这里看到成稿的样子</p></div>';
      }, 180);
    }
    $("content-input").addEventListener("input", updatePreview);

    // ===== 不想写 Markdown 也能用（2026-10-03 加）=====
    // ① 从 Word / 网页 / 公众号复制的富文本，粘进来自动转成干净的 Markdown；
    // ② 回车自动接上列表/引用，不用自己敲「- 」「1. 」「> 」。
    WBEditor.installRichPaste($("content-input"), {
      onConverted: function() { toast("已把粘贴的内容转成 Markdown（可再手动微调）", "ok"); }
    });
    WBEditor.installAutoList($("content-input"));

    // ===== 编辑器工具栏 =====
    // 走 WBEditor.replaceSelection，让插入的文本能进浏览器原生撤销栈，
    // 也顺带触发 input 事件（字数、草稿、预览都会跟着更新）。
    function insertMd(before, after, placeholder) {
      var ta = $("content-input");
      var selected = ta.value.slice(ta.selectionStart, ta.selectionEnd);
      var body = selected || placeholder || "";
      WBEditor.replaceSelection(ta, before + body + after, before.length, before.length + body.length);
    }
    // 块级语法（代码块、表格、列表）单独占行，别和上一行黏在一起
    function insertBlock(text) {
      var ta = $("content-input");
      var before = ta.value.slice(0, ta.selectionStart);
      var after = ta.value.slice(ta.selectionEnd);
      var prefix = !before || /\n$/.test(before) ? "" : "\n";
      var suffix = !after || /^\n/.test(after) ? "" : "\n";
      WBEditor.replaceSelection(ta, prefix + text + suffix);
    }

    // ===== 小屏：编辑 / 预览 二选一 =====
    (function() {
      var box = $("editor-container");
      var btns = box.querySelectorAll("[data-pane-btn]");
      Array.prototype.forEach.call(btns, function(btn) {
        btn.addEventListener("click", function() {
          var pane = btn.getAttribute("data-pane-btn");
          box.setAttribute("data-mobile-pane", pane);
          Array.prototype.forEach.call(btns, function(b) {
            b.classList.toggle("active", b.getAttribute("data-pane-btn") === pane);
          });
        });
      });
    })();

    // ===== 图片上传 =====
    function pickCover() { $("cover-file").click(); }
    function pickBodyImage() { $("body-file").click(); }
    /** 从图片库挑一张插进正文（2026-10-02 加） */
    function pickBodyImageFromLibrary() {
      WBMedia.openPicker({
        title: "从图片库选一张（插到正文里）",
        onPick: function (url) { insertBlock("![](" + url + ")"); },
      });
    }
    $("cover-file").addEventListener("change", function() {
      if (this.files && this.files[0]) uploadImage(this.files[0], "cover");
      this.value = "";
    });
    $("body-file").addEventListener("change", function() {
      if (this.files && this.files[0]) uploadImage(this.files[0], "body");
      this.value = "";
    });
    function onBodyDragOver(e) {
      // 拖页面里的图（带 uri-list/html）不显示"可以放"的光标 —— 那种放下不会上传，
      // 给个 copy 光标等于骗人（详见下面 isExternalFileDrop 的注释）
      if (!isExternalFileDrop(e)) return;
      e.preventDefault();
      if (e.dataTransfer) e.dataTransfer.dropEffect = "copy";
    }
    /**
     * 只认「从系统拖进来的文件」。
     * ⚠️ 2026-10-04 站长报的「拖动图片会导致复制 / 重新上传」就是这么来的：
     *    浏览器把"拖页面里的图片"也当成拖一个文件（dataTransfer.files 里塞了一份），
     *    这里不分辨就会把同一张图**又传一遍**（文件名带时间戳 → 仓库里多一份）。
     * 判据：页面内拖拽会附带 `text/uri-list` / `text/html`（"拖的是页面里的东西"），
     *      真正从资源管理器拖文件过来只有 Files。
     */
    function isExternalFileDrop(e) {
      var t = e.dataTransfer;
      if (!t) return false;
      var types = [];
      try { types = Array.prototype.slice.call(t.types || []); } catch (err) { types = []; }
      if (types.indexOf("Files") < 0) return false;
      if (types.indexOf("text/uri-list") >= 0 || types.indexOf("text/html") >= 0) return false;
      return true;
    }

    function onBodyDrop(e) {
      e.preventDefault();
      if (!isExternalFileDrop(e)) return;   // 拖页面里的图不算"上传一张新图"
      if (e.dataTransfer.files && e.dataTransfer.files[0]) uploadImage(e.dataTransfer.files[0], "body");
    }
    // 粘贴上传（2026-10-02 加）：截图之后 Ctrl+V 直接传进正文。
    // 之前只有「工具栏按钮」和「拖拽」两条路，粘贴是唯一没接住的一种输入方式 ——
    // 站长说的「文章中间无法插入图片」，多半就是在正文里按 Ctrl+V 没反应。
    var bodyArea = $("content-input");
    if (bodyArea) {
      bodyArea.addEventListener("paste", function (e) {
        var items = e.clipboardData && e.clipboardData.items;
        if (!items) return;
        for (var i = 0; i < items.length; i++) {
          if (items[i].type && items[i].type.indexOf("image/") === 0) {
            var f = items[i].getAsFile();
            if (f) { e.preventDefault(); uploadImage(f, "body"); return; }
          }
        }
      });
    }

    function loadImage(file) {
      return new Promise(function(resolve, reject) {
        var url = URL.createObjectURL(file);
        var img = new Image();
        img.onload = function() { URL.revokeObjectURL(url); resolve(img); };
        img.onerror = function() { URL.revokeObjectURL(url); reject(new Error("图片读取失败")); };
        img.src = url;
      });
    }
    function canvasToBlob(canvas, quality) {
      return new Promise(function(resolve, reject) {
        canvas.toBlob(function(blob) {
          if (blob) { resolve(blob); return; }
          canvas.toBlob(function(png) {
            if (png) resolve(png);
            else reject(new Error("图片压缩失败"));
          }, "image/png");
        }, "image/webp", quality);
      });
    }
    // 按实际编码格式给扩展名。canvas.toBlob 编不出 webp 时会回退成 PNG
    // （上面 canvasToBlob 就是这么写的），此时若仍硬写 .webp，存进仓库的就是
    // 「内容是 PNG、扩展名是 .webp」的文件 —— 浏览器按 webp 解不出来，就是一张裂图。
    function imageExtOf(blob) {
      var t = (blob && blob.type) || "";
      if (t.indexOf("webp") >= 0) return "webp";
      if (t.indexOf("jpeg") >= 0 || t.indexOf("jpg") >= 0) return "jpg";
      return "png";
    }
    function compressImage(file, maxSide, quality) {
      return loadImage(file).then(function(img) {
        var scale = Math.min(1, maxSide / Math.max(img.width, img.height));
        var canvas = document.createElement("canvas");
        canvas.width = Math.max(1, Math.round(img.width * scale));
        canvas.height = Math.max(1, Math.round(img.height * scale));
        var ctx = canvas.getContext("2d");
        ctx.imageSmoothingEnabled = true;
        ctx.imageSmoothingQuality = "high";
        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
        return canvasToBlob(canvas, quality).then(function(blob) {
          if (blob.size > 500 * 1024 && quality > 0.55) {
            return compressImage(blob, maxSide, quality - 0.15);
          }
          return blob;
        });
      });
    }
    function blobToBase64(blob) {
      return new Promise(function(resolve, reject) {
        var reader = new FileReader();
        reader.onload = function() { resolve(String(reader.result).split(",")[1]); };
        reader.onerror = reject;
        reader.readAsDataURL(blob);
      });
    }
    function uploadImage(file, purpose) {
      if (!/^image\//.test(file.type)) { toast("请选择图片文件", "err"); return; }
      var slug = ensureSlug();
      if (!slug) { toast("请先填写标题", "err"); return; }

      var btn = purpose === "cover" ? $("cover-upload-btn") : $("body-upload-btn");
      var original = btn.textContent;
      btn.disabled = true;
      btn.textContent = "上传中…";

      toast(purpose === "cover" ? "正在压缩封面上传…" : "正在压缩图片上传…", "");

      compressImage(file, 1600, 0.82)
        .then(function(blob) {
          // 文件名按压缩后的真实格式取，不能写死 .webp（见 imageExtOf 的注释）
          var fileName = Date.now() + "." + imageExtOf(blob);
          var imagePath = CONFIG.imagesPath + "/" + slug + "/" + fileName;
          var imageUrl = "/images/posts/" + slug + "/" + fileName;
          // 本地留一份副本：正文里写正式地址，但预览先显示本地这张
          // （否则重建前预览是裂图，看着像"预览不支持图片"）
          try { freshImages[imageUrl] = URL.createObjectURL(blob); } catch (e) { /* 记不住也不影响上传 */ }
          return blobToBase64(blob).then(function(base64) {
            return WBGitHub.putFile({
              owner: CONFIG.owner, repo: CONFIG.repo, path: imagePath, branch: CONFIG.branch,
              content: base64, message: "上传文章图片: " + slug
            }).then(function() { return imageUrl; });
          });
        })
        .then(function(imageUrl) {
          if (purpose === "cover") {
            $("cover-input").value = imageUrl;
            updateCoverPreview();
          } else {
            insertBlock("![](" + imageUrl + ")");
            updatePreview(); // 立刻用本地副本渲染，不等重建
          }
          toast("图片已上传 ✓ 预览里已经能看到了（重新构建后站上生效）", "ok");
        })
        .catch(function(e) {
          toast("上传失败：" + e.message, "err");
        })
        .finally(function() {
          btn.disabled = false;
          btn.textContent = original;
        });
    }

    // ===== 正文字数 =====
    function updateCounter() {
      var s = WBEditor.summarize($("content-input").value);
      $("content-counter").textContent = "正文 " + s.chars + " 字 · 约 " + s.minutes + " 分钟读完";
    }
    $("content-input").addEventListener("input", updateCounter);

    // ===== 本地草稿：写到一半也不会丢 =====
    // 只存在这台浏览器里，不上传任何地方。正式内容仍然以保存进仓库的为准。
    var pendingDraft = null;
    var autosaveTimer = null;

    function snapshot() {
      return {
        path: editingPath,
        title: $("title-input").value,
        slug: $("slug-input").value,
        category: $("category-input").value,
        tags: $("tags-input").value,
        date: $("date-input").value,
        description: $("description-input").value,
        cover: $("cover-input").value,
        draft: $("draft-input").checked,
        body: $("content-input").value,
      };
    }
    function isDirty() {
      return JSON.stringify(snapshot()) !== cleanSnapshot;
    }
    function markClean() {
      cleanSnapshot = JSON.stringify(snapshot());
    }
    function applySnapshot(s) {
      $("title-input").value = s.title || "";
      $("slug-input").value = s.slug || "";
      $("category-input").value = s.category || "";
      $("tags-input").value = s.tags || "";
      $("date-input").value = s.date || todayStr();
      $("description-input").value = s.description || "";
      $("cover-input").value = s.cover || "";
      $("draft-input").checked = !!s.draft;
      $("content-input").value = s.body || "";
      slugAutoMode = false;
      refreshDerived();
      updatePreview();
      updateCounter();
    }
    function pad2(n) { return String(n).padStart(2, "0"); }
    function fmtTime(ts) {
      var d = new Date(ts);
      return pad2(d.getMonth() + 1) + "月" + pad2(d.getDate()) + "日 " + pad2(d.getHours()) + ":" + pad2(d.getMinutes());
    }
    function clearDraft() {
      draftStore.clear();
      pendingDraft = null;
      $("draft-hint").textContent = "";
      $("restore-bar").classList.add("hidden");
    }
    function saveDraftNow() {
      var s = snapshot();
      // 空表单不写草稿，免得把上一份还有用的内容顶掉
      if (!s.title.trim() && !s.body.trim()) return;
      if (draftStore.save(s)) $("draft-hint").textContent = "本地草稿 " + fmtTime(Date.now());
    }
    function scheduleDraftSave() {
      clearTimeout(autosaveTimer);
      autosaveTimer = setTimeout(saveDraftNow, 900);
    }
    ["title-input", "slug-input", "category-input", "tags-input", "date-input",
     "description-input", "cover-input", "content-input"].forEach(function(id) {
      $(id).addEventListener("input", scheduleDraftSave);
    });
    $("draft-input").addEventListener("change", function() {
      refreshDerived();
      scheduleDraftSave();
    });

    function showRestoreBar() {
      var draft = draftStore.load();
      if (!draft || !draft.data) return;
      var d = draft.data;
      if (!String(d.title || "").trim() && !String(d.body || "").trim()) {
        draftStore.clear();
        return;
      }
      pendingDraft = draft;
      $("restore-text").textContent =
        "上次有内容没保存（" + fmtTime(draft.at) + "）：" +
        (String(d.title || "").trim() ? "《" + d.title + "》" : "未填标题");
      $("restore-bar").classList.remove("hidden");
    }
    function restoreDraft() {
      if (!pendingDraft) return;
      var d = pendingDraft.data;
      applySnapshot(d);
      editingPath = d.path || "";
      $("editor-title").textContent = editingPath ? "编辑文章" : "写文章";
      $("save-btn").textContent = editingPath ? "保存修改" : "发布文章";
      if (editingPath) $("edit-bar").classList.remove("hidden");
      $("restore-bar").classList.add("hidden");
      $("draft-hint").textContent = "本地草稿 " + fmtTime(pendingDraft.at);
      refreshDerived();
      markClean();
      toast("已恢复上次未保存的内容", "ok");
    }
    function discardDraft() {
      clearDraft();
      toast("已丢弃本地草稿", "ok");
    }
    function confirmDiscardIfDirty(action) {
      if (!isDirty()) return true;
      return confirm(
        "当前内容还没保存，确定要" + action + "吗？\n" +
        "未保存的内容仍留在本地草稿里，之后可以点「恢复」取回。"
      );
    }

    // 关标签页或刷新时拦一下，避免手滑丢掉正在写的内容
    WBEditor.guardUnsavedChanges(isDirty);

    // ===== 跟着内容一起刷新的几处提示 =====
    function updateCoverPreview() {
      var box = $("cover-preview");
      var img = $("cover-preview-img");
      var src = $("cover-input").value.trim();
      if (!src) {
        box.classList.add("hidden");
        img.removeAttribute("src");
        return;
      }
      // 地址没变就不重新加载：浏览器对同一个 src 不会再触发 load，会一直空着
      if (img.getAttribute("src") === src) {
        if (img.complete && img.naturalWidth > 0) box.classList.remove("hidden");
        return;
      }
      img.onload = function() { box.classList.remove("hidden"); };
      img.onerror = function() { box.classList.add("hidden"); };
      img.setAttribute("src", src);
    }

    function updateSlugHint() {
      var slug = $("slug-input").value.trim();
      var hint = $("slug-hint");
      if (!slug) { hint.textContent = "留空会按标题生成，建议手填英文，链接更干净"; return; }
      var warn = /[^\x00-\x7F]/.test(slug) ? ' <span class="warn">含中文，前台链接也会是中文</span>' : "";
      hint.innerHTML = esc(CONFIG.postsPath + "/" + slug + ".md") + warn;
    }

    function updateViewLink() {
      var btn = $("view-post-btn");
      var slug = $("slug-input").value.trim() || (editingPath ? slugFromPath(editingPath) : "");
      // 草稿在正式构建里不会产出页面，所以只对已发布的文章给出入口
      if (!editingPath || !slug || $("draft-input").checked) {
        btn.classList.add("hidden");
        btn.removeAttribute("href");
        return;
      }
      btn.setAttribute("href", "/posts/" + slug + "/");
      btn.classList.remove("hidden");
    }

    // 封面预览、路径提示、前台链接都依赖表单当前值，一起刷新
    function refreshDerived() {
      updateCoverPreview();
      updateSlugHint();
      updateViewLink();
    }
    $("cover-input").addEventListener("input", updateCoverPreview);

    // ===== 快捷键 =====
    WBEditor.installTabIndent($("content-input"));
    WBEditor.installShortcuts($("content-input"), {
      bold: function() { insertMd("**", "**"); },
      italic: function() { insertMd("*", "*"); },
      link: function() { insertMd("[", "](url)", "链接文字"); },
      save: savePost,
      submit: savePost,
    });

    // ===== 文章列表的搜索与筛选 =====
    $("list-search").addEventListener("input", function() {
      listKeyword = this.value.trim().toLowerCase();
      renderList();
    });
    $("list-draft-only").addEventListener("change", function() {
      listDraftOnly = this.checked;
      renderList();
    });
    $("list-sort").addEventListener("change", function() {
      listSort = this.value;
      renderList();
    });

    // ===== 初始化 =====
    $("date-input").value = todayStr();
    updateCounter();
    refreshDerived();
    markClean();
    showRestoreBar();
    checkAuth().then(function(ok) {
      if (!ok) return;
      connect();
    });
  </script>
</body>
</html>
