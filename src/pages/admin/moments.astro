---
// 说说写作页面 - 通过 GitHub Gist 存储，完全免费，不修改仓库代码
import AdminTheme from "@/components/admin/AdminTheme.astro";
import AdminTopBar from "@/components/admin/AdminTopBar.astro";
import Footer from "@components/layout/Footer.astro";
import { adminBodyClass, adminHtmlClass } from "@/components/admin/adminShell";
import { externalMomentsConfig } from "@/config/externalMomentsConfig";
---

<html lang="zh-CN" class={adminHtmlClass}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>写说说</title>
  {/* 后台是站长自用界面，不该出现在搜索结果里（sitemap 中同样已剔除） */}
  <meta name="robots" content="noindex, nofollow" />
  {/* 样式、字体、主题色都来自这里，页面自己的样式放在它后面 */}
  <AdminTheme />
  <style is:inline>
    /* ===== 只放这一页特有的排版，通用部分在 src/styles/admin.css ===== */

    /* 这一页是窄栏内容，标题条与内容区一起收窄，免得四周太空 */
    #admin-main { --admin-content-max: 640px; }

    /* 连接状态独立成一行，单独给它一点卡片感 */
    .status-bar {
      display: flex;
      width: 100%;
      margin-bottom: 1rem;
      padding: 0.5rem 0.75rem;
      background: var(--card-bg);
      border: 1px solid var(--line-soft);
      border-radius: var(--radius-md);
    }

    /* 底部一行：主按钮 + 本地草稿时刻 */
    .submit-row, .save-row {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
      margin-top: 1rem;
    }
    .submit-row .btn-primary, .save-row .btn-primary { flex: 1; }
    .draft-hint { font-size: 0.6875rem; color: var(--text-3); white-space: nowrap; }
    .field-footer .hint { opacity: 0.75; }

    /* 正文输入框比默认的再高一点 */
    .card textarea { min-height: 150px; }
    @media (min-width: 640px) { .card textarea { min-height: 170px; } }

    /* 输入框 + 按钮 的一行 */
    .input-row { display: flex; align-items: center; gap: 0.5rem; }
    .input-row input[type="text"] { flex: 1; min-width: 0; }

    .custom-time-panel {
      margin-top: 0.5rem;
      padding-top: 0.625rem;
      border-top: 1px dashed var(--line);
    }

    /* ===== 图片缩略图 ===== */
    .img-list { display: flex; flex-wrap: wrap; gap: 0.375rem; margin-top: 0.625rem; }
    .img-thumb {
      position: relative;
      width: 56px;
      height: 56px;
      flex-shrink: 0;
      overflow: hidden;
      border: 1px solid var(--line-soft);
      border-radius: var(--radius-sm);
      background: var(--card-bg-soft);
    }
    .img-thumb img { width: 100%; height: 100%; object-fit: cover; }
    .img-thumb .remove {
      position: absolute;
      top: 0;
      right: 0;
      width: 18px;
      height: 18px;
      border: none;
      cursor: pointer;
      background: rgba(0, 0, 0, 0.62);
      color: #fff;
      font-size: 11px;
      line-height: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 0 0 0 var(--radius-sm);
      opacity: 0;
      transition: opacity 0.15s;
    }
    .img-thumb:hover .remove { opacity: 1; }
    @media (max-width: 480px) {
      .img-thumb { width: 48px; height: 48px; }
      .img-thumb .remove { opacity: 1; }
    }

    /* ===== 开关 ===== */
    .toggle-row {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      cursor: pointer;
      user-select: none;
    }
    .toggle-label {
      display: flex;
      align-items: center;
      gap: 0.375rem;
      font-size: 0.8125rem;
      font-weight: 700;
      color: var(--text-2);
    }
    /* 真正的勾选框藏起来但仍在焦点顺序里，键盘照样能切 */
    .toggle-checkbox {
      position: absolute;
      width: 1px;
      height: 1px;
      opacity: 0;
      margin: 0;
      pointer-events: none;
    }
    .toggle-switch {
      position: relative;
      width: 38px;
      height: 22px;
      flex-shrink: 0;
      background: var(--line);
      border-radius: var(--radius-full);
      transition: background-color 0.15s;
    }
    .toggle-switch::after {
      content: '';
      position: absolute;
      top: 2px;
      left: 2px;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: #fff;
      box-shadow: 0 1px 2px rgb(0 0 0 / 0.2);
      transition: transform 0.15s;
    }
    .toggle-checkbox:checked + .toggle-switch { background: var(--primary); }
    .toggle-checkbox:checked + .toggle-switch::after { transform: translateX(16px); }
    .toggle-checkbox:focus-visible + .toggle-switch { outline: 2px solid var(--primary); outline-offset: 2px; }

    /* ===== 说说列表 ===== */
    .moment-row {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 0.75rem;
      padding: 0.75rem 0.5rem;
      margin: 0 -0.5rem;
      border-bottom: 1px solid var(--line-soft);
      border-radius: var(--radius-md);
      transition: background-color 0.15s;
    }
    .moment-row:hover { background: var(--hover); }
    .moment-row:last-child { border-bottom: none; }
    .moment-body { flex: 1; min-width: 0; }
    .moment-text {
      font-size: 0.8125rem;
      line-height: 1.7;
      color: var(--text);
      word-break: break-word;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .moment-meta {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
      margin-top: 0.375rem;
      font-size: 0.6875rem;
      color: var(--text-3);
    }
    .moment-meta .sep { opacity: 0.5; }
    .moment-images { display: flex; gap: 0.25rem; margin-top: 0.375rem; }
    .moment-images img {
      width: 44px;
      height: 44px;
      object-fit: cover;
      border: 1px solid var(--line-soft);
      border-radius: var(--radius-sm);
    }
  </style>
</head>
<body class={adminBodyClass}>

  <!-- ===== 后台主页 ===== -->
  <div id="admin-main">
    <AdminTopBar title="写说说" withStatus={false} />

    <div class="container">
      <!-- 连接状态 -->
      <div class="status-bar" id="status-bar">
        <span class="status-dot" id="status-dot"></span>
        <span id="status-text">正在连接...</span>
      </div>

      {/* 上次没有保存就离开时，把本地留存的草稿提示出来 */}
      <div class="restore-bar hidden" id="restore-bar">
        <span class="restore-icon">🕘</span>
        <span class="restore-text" id="restore-text"></span>
        <div class="restore-actions">
          <button class="btn btn-sm" onclick="restoreDraft()">恢复</button>
          <button class="btn btn-sm" onclick="discardDraft()">丢弃</button>
        </div>
      </div>


      <!-- 写说说 -->
      <div class="card">
        <div class="field">
          <div class="field-label"><span class="icon">✍️</span> 内容</div>
          <textarea id="content-input" placeholder="分享此刻的想法..."></textarea>
          <div class="field-footer">
            <span id="content-counter">0 字</span>
            <span class="hint">Ctrl+Enter 发布 · Ctrl+S 保存 · Tab 缩进</span>
          </div>
        </div>
        <div class="field">
          <div class="field-label"><span class="icon">🖼️</span> 图片</div>
          <div class="input-row">
            <input type="text" id="image-input" placeholder="粘贴图片链接，回车添加" />
            <button class="btn btn-sm" onclick="addImage()">添加</button>
          </div>
          <div style="margin-top:0.375rem;">
            <button class="btn btn-sm" onclick="toggleBatchImages()" id="batch-toggle-btn" style="font-size:0.6875rem;">📋 批量添加</button>
          </div>
          <div class="hidden" id="batch-panel" style="margin-top:0.375rem;">
            <textarea id="batch-images-input" placeholder="每行一个图片链接，支持批量粘贴&#10;https://example.com/1.jpg&#10;https://example.com/2.jpg&#10;https://example.com/3.jpg" style="min-height:80px;font-size:0.8125rem;padding:0.5rem 0.75rem;"></textarea>
            <button class="btn btn-sm" onclick="applyBatchImages()" style="margin-top:0.375rem;">确认添加</button>
          </div>
          <div class="img-list" id="img-preview"></div>
        </div>
        <div class="field">
          <div class="field-label"><span class="icon">🏷️</span> 标签</div>
          <input type="text" class="input-single" id="tags-input" placeholder="逗号分隔，如：日常, 生活" value="日常" />
        </div>
        <div class="field">
          <div class="field-label"><span class="icon">📍</span> 位置</div>
          <div class="input-row">
            <input type="text" class="input-single" id="location-input" placeholder="可选" style="flex:1;" />
            <button class="btn btn-sm" onclick="fetchLocation()" id="geo-btn" title="获取当前位置">📍</button>
          </div>
          <div id="geo-status" style="margin-top:0.25rem;font-size:0.6875rem;color:var(--text-3);display:none;"></div>
        </div>
        <div class="field">
          <label class="toggle-row" for="custom-time-toggle">
            <span class="toggle-label"><span class="icon">🕐</span> 自定义发布时间</span>
            <input type="checkbox" id="custom-time-toggle" class="toggle-checkbox" onchange="toggleCustomTime()" />
            <span class="toggle-switch"></span>
          </label>
          <div class="custom-time-panel hidden" id="custom-time-panel">
            <input type="datetime-local" id="time-input" />
          </div>
        </div>
        <div class="field">
          <label class="toggle-row" for="pinned-input">
            <span class="toggle-label"><span class="icon">📌</span> 置顶</span>
            <input type="checkbox" id="pinned-input" class="toggle-checkbox" />
            <span class="toggle-switch"></span>
          </label>
        </div>
        <div class="submit-row">
          <button class="btn btn-primary" id="submit-btn" onclick="submitMoment()">发布</button>
          <span class="draft-hint" id="draft-hint"></span>
        </div>
        <div class="hidden" id="edit-bar" style="display:flex;gap:0.5rem;margin-top:0.5rem;">
          <button class="btn btn-sm" onclick="confirmCancelEdit()" style="flex:1;">取消编辑</button>
        </div>
      </div>

      <!-- 已有说说 -->
      <div class="card">
        <div class="list-header">
          <div class="field-label" style="margin:0"><span class="icon">📋</span> 已发布</div>
          <span class="count" id="list-count"></span>
        </div>
        <div id="moments-list">
          <div class="empty-state"><span class="spinner"></span></div>
        </div>
      </div>
    </div>

    {/* 页脚与博客同一个组件 */}
    <Footer />
  </div>

  <div class="toast" id="toast"></div>

  <script is:inline src="/js/editor-commons.js"></script>
  <script is:inline src="/js/admin-github.js"></script>
  <script is:inline
    data-gist={externalMomentsConfig.gistId || ""}
    data-file={externalMomentsConfig.fileName || "moments.json"}>
    var _script = document.currentScript;
    var GIST_ID = _script.getAttribute("data-gist") || "";
    var FILE_NAME = _script.getAttribute("data-file") || "moments.json";
    // 本地草稿与"是否有未保存改动"的判定基线
    var draftStore = WBEditor.createDraftStore("moment");
    var cleanSnapshot = "";

    // ===== 工具 =====
    function $(id) { return document.getElementById(id); }
    function getImages() { try { return JSON.parse(localStorage.getItem("moment_imgs") || "[]"); } catch(e) { return []; } }
    function setImages(v) {
      localStorage.setItem("moment_imgs", JSON.stringify(v));
      // 图片也算草稿的一部分，改动后跟着存一份
      scheduleDraftSave();
    }
    function esc(t) { var d = document.createElement("div"); d.textContent = t; return d.innerHTML; }

    function toast(msg, type) {
      var el = $("toast"); el.textContent = msg; el.className = "toast " + type + " show";
      clearTimeout(el._t); el._t = setTimeout(function() { el.className = "toast"; }, 2800);
    }

    // toggleDark 与明暗初始化由 <AdminTheme /> 提供

    // ===== 退出 =====
    function doLogout() {
      sessionStorage.removeItem("admin_auth");
      fetch("/api/auth/logout", { method: "POST" }).catch(function() {});
      window.location.href = "/admin/";
    }

    function setStatus(ok, text) {
      $("status-dot").className = "status-dot " + (ok ? "ok" : "err");
      $("status-text").textContent = text;
    }
    function checkAuth() {
      return fetch("/api/auth/status")
        .then(function(r) { return r.json(); })
        .then(function(d) {
          if (!d.authed) { window.location.href = "/admin/"; return false; }
          return true;
        })
        .catch(function() { window.location.href = "/admin/"; return false; });
    }
    function validateAndLoad() {
      if (!GIST_ID) {
        setStatus(false, "未配置 Gist ID");
        showEmpty();
        return;
      }
      setStatus(true, "已连接");
      loadMoments();
    }

    // ===== 图片 =====
    function addImage() {
      var input = $("image-input"), url = input.value.trim();
      if (!url) return;
      var imgs = getImages(); imgs.push(url); setImages(imgs);
      input.value = ""; renderImgs();
      toast("已添加第 " + imgs.length + " 张图片", "ok");
    }

    function removeImage(i) {
      var imgs = getImages(); imgs.splice(i, 1); setImages(imgs); renderImgs();
    }

    function renderImgs() {
      var imgs = getImages(), c = $("img-preview"); c.innerHTML = "";
      imgs.forEach(function(url, i) {
        var d = document.createElement("div"); d.className = "img-thumb";
        d.innerHTML = '<img src="' + url + '" alt="" onerror="this.style.opacity=\'0.3\'"><button class="remove" onclick="removeImage(' + i + ')">×</button>';
        c.appendChild(d);
      });
    }

    $("image-input").addEventListener("keydown", function(e) {
      if (e.key === "Enter") { e.preventDefault(); addImage(); }
    });

    // ===== 批量添加图片 =====
    function toggleBatchImages() {
      var panel = $("batch-panel");
      var btn = $("batch-toggle-btn");
      if (panel.classList.contains("hidden")) {
        panel.classList.remove("hidden");
        btn.textContent = "收起批量添加";
      } else {
        panel.classList.add("hidden");
        btn.textContent = "📋 批量添加";
      }
    }

    function applyBatchImages() {
      var text = $("batch-images-input").value.trim();
      if (!text) { toast("请输入图片链接", "err"); return; }
      var urls = text.split(/[\n\r]+/).map(function(s) { return s.trim(); }).filter(Boolean);
      if (!urls.length) { toast("未识别到链接", "err"); return; }
      var imgs = getImages();
      urls.forEach(function(u) { imgs.push(u); });
      setImages(imgs);
      renderImgs();
      $("batch-images-input").value = "";
      $("batch-panel").classList.add("hidden");
      $("batch-toggle-btn").textContent = "📋 批量添加";
      toast("已添加 " + urls.length + " 张图片", "ok");
    }

    // ===== 获取当前位置 =====
    function fetchLocation() {
      var statusEl = $("geo-status");
      var btn = $("geo-btn");
      if (!navigator.geolocation) {
        statusEl.textContent = "浏览器不支持定位"; statusEl.style.display = ""; return;
      }
      statusEl.textContent = "正在定位..."; statusEl.style.color = "var(--text-3)"; statusEl.style.display = "";
      btn.disabled = true; btn.textContent = "⏳";

      navigator.geolocation.getCurrentPosition(
        function(pos) {
          var lat = pos.coords.latitude, lng = pos.coords.longitude;
          statusEl.textContent = "正在解析地址...";
          // BigDataCloud: 免费、无需 key、支持 CORS、支持中文
          fetch("https://api.bigdatacloud.net/data/reverse-geocode-client?latitude=" + lat + "&longitude=" + lng + "&localityLanguage=zh")
            .then(function(r) { return r.json(); })
            .then(function(data) {
              var parts = [];
              if (data.city) parts.push(data.city);
              else if (data.locality) parts.push(data.locality);
              if (data.principalSubdivision) parts.push(data.principalSubdivision);
              var loc = parts.join("-") || data.locality || data.countryName || (lat.toFixed(4) + ", " + lng.toFixed(4));
              $("location-input").value = loc;
              statusEl.textContent = "✓ " + loc; statusEl.style.color = "var(--success)";
              btn.disabled = false; btn.textContent = "📍";
            })
            .catch(function() {
              // 解析失败，回退到 IP 定位
              fetch("https://ipapi.co/json/")
                .then(function(r) { return r.json(); })
                .then(function(ip) {
                  var loc = [ip.city, ip.region].filter(Boolean).join("-") || (lat.toFixed(4) + ", " + lng.toFixed(4));
                  $("location-input").value = loc;
                  statusEl.textContent = "✓ " + loc + "（IP 回退）"; statusEl.style.color = "var(--success)";
                  btn.disabled = false; btn.textContent = "📍";
                })
                .catch(function() {
                  $("location-input").value = lat.toFixed(4) + ", " + lng.toFixed(4);
                  statusEl.textContent = "已获取坐标，地址解析失败"; statusEl.style.color = "var(--text-3)";
                  btn.disabled = false; btn.textContent = "📍";
                });
            });
        },
        function(err) {
          var msg = { 1: "定位权限被拒绝，请在浏览器设置中允许定位", 2: "无法获取位置", 3: "定位超时" }[err.code] || "定位失败";
          statusEl.textContent = msg; statusEl.style.color = "var(--danger)";
          btn.disabled = false; btn.textContent = "📍";
        },
        { enableHighAccuracy: false, timeout: 10000, maximumAge: 300000 }
      );
    }

    // ===== 加载列表 =====
    function loadMoments() {
      var list = $("moments-list");
      list.innerHTML = '<div class="empty-state"><span class="spinner"></span></div>';

      WBGitHub.readGist(GIST_ID).then(function(gist) {
        var text = WBGitHub.gistText(gist, FILE_NAME);
        var moments = []; try { moments = JSON.parse(text || "[]"); } catch(e) {}
        if (!moments.length) { showEmpty(); return; }

        moments.sort(function(a, b) { return new Date(b.published) - new Date(a.published); });
        $("list-count").textContent = moments.length + " 条";
        list.innerHTML = "";

        moments.forEach(function(m) {
          var d = document.createElement("div"); d.className = "moment-row";
          var date = new Date(m.published);
          var ds = date.toLocaleDateString("zh-CN") + " " + date.toLocaleTimeString("zh-CN", { hour: "2-digit", minute: "2-digit" });
          var text = (m.content || "").slice(0, 120) + ((m.content || "").length > 120 ? "..." : "");
          var imgs = (m.images || []);
          var imgHtml = imgs.length ? '<div class="moment-images">' + imgs.slice(0, 4).map(function(u) {
            return '<img src="' + u + '" alt="">';
          }).join("") + (imgs.length > 4 ? '<span style="font-size:0.75rem;color:var(--text-3);align-self:center;">+' + (imgs.length - 4) + '</span>' : "") + '</div>' : "";
          var tags = (m.tags || []);
          var tagStr = tags.length ? '<span class="sep">·</span><span>#' + tags.join(" #") + '</span>' : "";
          var loc = m.location ? '<span class="sep">·</span><span>📍 ' + esc(m.location) + '</span>' : "";

          d.innerHTML = '<div class="moment-body"><div class="moment-text">' + esc(text) + '</div>' + imgHtml + '<div class="moment-meta"><span>' + ds + '</span>' + tagStr + loc + '</div></div><div style="display:flex;gap:0.375rem;flex-shrink:0;"><button class="btn btn-sm" onclick="editMoment(\'' + m.id + '\')">编辑</button><button class="btn btn-danger-sm" onclick="deleteMoment(\'' + m.id + '\')">删除</button></div>';
          list.appendChild(d);
        });
      }).catch(function(e) { list.innerHTML = '<div class="empty-state" style="color:var(--danger)">加载失败：' + esc(e.message) + '</div>'; });
    }

    function showEmpty() {
      $("moments-list").innerHTML = '<div class="empty-state"><div class="icon">💭</div><p>还没有说说</p></div>';
      $("list-count").textContent = "";
    }

    // ===== 自定义时间 =====
    function toggleCustomTime() {
      var panel = $("custom-time-panel");
      if ($("custom-time-toggle").checked) {
        panel.classList.remove("hidden");
      } else {
        panel.classList.add("hidden");
        $("time-input").value = "";
      }
    }

    function getPublishedTime() {
      if ($("custom-time-toggle").checked) {
        var custom = $("time-input").value;
        if (custom) {
          var d = new Date(custom);
          if (!isNaN(d.getTime())) return d.toISOString();
        }
      }
      return new Date().toISOString();
    }

    // ===== 编辑状态 =====
    var editingId = null;

    function editMoment(id) {
      if (!confirmDiscardIfDirty("切换到另一条")) return;
      WBGitHub.readGist(GIST_ID).then(function(gist) {
        var moments = []; try { moments = JSON.parse(WBGitHub.gistText(gist, FILE_NAME) || "[]"); } catch(e) {}
        var m = moments.find(function(x) { return x.id === id; });
        if (!m) { toast("未找到该条说说", "err"); return; }

        editingId = id;
        $("content-input").value = m.content || "";
        $("tags-input").value = (m.tags || []).join(", ");
        $("location-input").value = m.location || "";
        $("pinned-input").checked = !!m.pinned;
        setImages(m.images || []); renderImgs();

        // 时间
        if (m.published) {
          $("custom-time-toggle").checked = true;
          $("custom-time-panel").classList.remove("hidden");
          var d = new Date(m.published);
          var pad = function(n) { return String(n).padStart(2, "0"); };
          $("time-input").value = d.getFullYear() + "-" + pad(d.getMonth()+1) + "-" + pad(d.getDate()) + "T" + pad(d.getHours()) + ":" + pad(d.getMinutes());
        }

        $("submit-btn").textContent = "保存修改";
        $("edit-bar").classList.remove("hidden");
        $("content-input").focus();
        $("content-input").scrollIntoView({ behavior: "smooth", block: "center" });
        updateCounter();
        markClean();
        toast("正在编辑（ID: " + id.slice(-6) + "）", "ok");
      }).catch(function(e) { toast("读取失败：" + e.message, "err"); });
    }

    function cancelEdit() {
      editingId = null;
      $("content-input").value = "";
      $("tags-input").value = "日常";
      $("location-input").value = "";
      $("pinned-input").checked = false;
      $("time-input").value = "";
      $("custom-time-toggle").checked = false;
      $("custom-time-panel").classList.add("hidden");
      setImages([]); renderImgs();
      $("submit-btn").textContent = "发布";
      $("edit-bar").classList.add("hidden");
      updateCounter();
      markClean();
    }
    // 点“取消编辑”时先问一句；发布成功后内部的收尾不走这个口
    function confirmCancelEdit() {
      if (!confirmDiscardIfDirty("取消编辑")) return;
      cancelEdit();
    }

    // ===== 发布/更新 =====
    function submitMoment() {
      var content = $("content-input").value.trim();
      if (!content) { toast("请输入内容", "err"); return; }

      // 先把本地这份写下来：万一这次没发出去，内容也还在
      saveDraftNow();
      clearTimeout(autosaveTimer);

      var images = getImages();
      var tags = $("tags-input").value.split(",").map(function(s) { return s.trim(); }).filter(Boolean);
      var location = $("location-input").value.trim();
      var pinned = $("pinned-input").checked;
      var published = getPublishedTime();
      var btn = $("submit-btn");
      var isEdit = !!editingId;
      var saved = false;
      btn.disabled = true;
      btn.textContent = isEdit ? "保存中..." : (images.length ? "发布中...（含 " + images.length + " 张图）" : "发布中...");

      WBGitHub.readGist(GIST_ID).then(function(gist) {
        var moments = [];
        try { moments = JSON.parse(WBGitHub.gistText(gist, FILE_NAME) || "[]"); } catch(e) {}

        if (isEdit) {
          var idx = moments.findIndex(function(x) { return x.id === editingId; });
          if (idx === -1) { throw new Error("这条说说在 Gist 里已经找不到了，刷新页面看看"); }
          moments[idx] = {
            id: editingId, content: content,
            published: published,
            images: images, tags: tags, location: location,
            pinned: pinned || false,
            author: moments[idx].author,
            avatar: moments[idx].avatar,
          };
        } else {
          moments.push({
            id: "ext-" + Date.now(), content: content,
            published: published,
            images: images, tags: tags, location: location,
            pinned: pinned || false
          });
        }

        return WBGitHub.patchGist(GIST_ID, FILE_NAME, JSON.stringify(moments, null, 2));
      }).then(function() {
        saved = true;
        // 已经进了仓库，本地那份临时草稿就没用了
        clearDraft();
        toast(isEdit ? "已保存 ✓" : "发布成功 ✓", "ok");
        cancelEdit();
        loadMoments();
      }).catch(function(e) {
        toast((isEdit ? "保存失败" : "发布失败") + "：" + (e && e.message ? e.message : "网络错误"), "err");
      }).finally(function() {
        btn.disabled = false;
        // 成功时 cancelEdit 已把文字复位；失败时也要复位，
        // 否则一次失败之后按钮会一直停在“保存中...”
        if (!saved) btn.textContent = isEdit ? "保存修改" : "发布";
      });
    }

    // ===== 删除 =====
    function deleteMoment(id) {
      if (!confirm("确定删除？")) return;
      WBGitHub.readGist(GIST_ID).then(function(gist) {
        var moments = []; try { moments = JSON.parse(WBGitHub.gistText(gist, FILE_NAME) || "[]"); } catch(e) {}
        moments = moments.filter(function(m) { return m.id !== id; });
        return WBGitHub.patchGist(GIST_ID, FILE_NAME, JSON.stringify(moments, null, 2));
      }).then(function() {
        toast("已删除", "ok");
        loadMoments();
      }).catch(function(e) { toast("删除失败：" + e.message, "err"); });
    }

    // ===== 字数 =====
    function updateCounter() {
      var s = WBEditor.summarize($("content-input").value);
      $("content-counter").textContent = "正文 " + s.chars + " 字 · 约 " + s.minutes + " 分钟读完";
    }
    $("content-input").addEventListener("input", updateCounter);

    // ===== 本地草稿：写到一半也不会丢 =====
    // 只存在这台浏览器里，不上传任何地方。正式内容仍然以发布出去的为准。
    var pendingDraft = null;
    var autosaveTimer = null;

    function snapshot() {
      return {
        id: editingId,
        content: $("content-input").value,
        tags: $("tags-input").value,
        location: $("location-input").value,
        pinned: $("pinned-input").checked,
        customTime: $("custom-time-toggle").checked,
        time: $("time-input").value,
        images: getImages(),
      };
    }
    function isDirty() {
      return JSON.stringify(snapshot()) !== cleanSnapshot;
    }
    function markClean() {
      cleanSnapshot = JSON.stringify(snapshot());
    }
    function pad2(n) { return String(n).padStart(2, "0"); }
    function fmtTime(ts) {
      var d = new Date(ts);
      return pad2(d.getMonth() + 1) + "月" + pad2(d.getDate()) + "日 " + pad2(d.getHours()) + ":" + pad2(d.getMinutes());
    }
    function clearDraft() {
      draftStore.clear();
      pendingDraft = null;
      $("draft-hint").textContent = "";
      $("restore-bar").classList.add("hidden");
    }
    function saveDraftNow() {
      var s = snapshot();
      // 空内容不写草稿，免得把上一份还有用的顶掉
      if (!String(s.content || "").trim() && !s.images.length) return;
      if (draftStore.save(s)) $("draft-hint").textContent = "本地草稿 " + fmtTime(Date.now());
    }
    function scheduleDraftSave() {
      clearTimeout(autosaveTimer);
      autosaveTimer = setTimeout(saveDraftNow, 900);
    }
    ["content-input", "tags-input", "location-input", "time-input"].forEach(function(id) {
      $(id).addEventListener("input", scheduleDraftSave);
    });
    ["pinned-input", "custom-time-toggle"].forEach(function(id) {
      $(id).addEventListener("change", scheduleDraftSave);
    });

    function applySnapshot(s) {
      editingId = s.id || null;
      $("content-input").value = s.content || "";
      $("tags-input").value = s.tags || "日常";
      $("location-input").value = s.location || "";
      $("pinned-input").checked = !!s.pinned;
      $("custom-time-toggle").checked = !!s.customTime;
      $("time-input").value = s.time || "";
      $("custom-time-panel").classList.toggle("hidden", !s.customTime);
      setImages(s.images || []);
      renderImgs();
      $("submit-btn").textContent = editingId ? "保存修改" : "发布";
      $("edit-bar").classList.toggle("hidden", !editingId);
      updateCounter();
    }
    function showRestoreBar() {
      var draft = draftStore.load();
      if (!draft || !draft.data) return;
      var d = draft.data;
      var hasImages = (d.images || []).length > 0;
      if (!String(d.content || "").trim() && !hasImages) {
        draftStore.clear();
        return;
      }
      pendingDraft = draft;
      var preview = String(d.content || "").trim().replace(/\s+/g, " ");
      if (preview.length > 24) preview = preview.slice(0, 24) + "…";
      $("restore-text").textContent =
        "上次有内容没保存（" + fmtTime(draft.at) + "）：" +
        (preview || (d.images || []).length + " 张图片");
      $("restore-bar").classList.remove("hidden");
    }
    function restoreDraft() {
      if (!pendingDraft) return;
      applySnapshot(pendingDraft.data);
      $("restore-bar").classList.add("hidden");
      $("draft-hint").textContent = "本地草稿 " + fmtTime(pendingDraft.at);
      markClean();
      toast("已恢复上次未保存的内容", "ok");
    }
    function discardDraft() {
      clearDraft();
      toast("已丢弃本地草稿", "ok");
    }
    function confirmDiscardIfDirty(action) {
      if (!isDirty()) return true;
      return confirm(
        "当前内容还没保存，确定要" + action + "吗？\n" +
        "未保存的内容仍留在本地草稿里，之后可以点“恢复”取回。"
      );
    }

    // 关标签页或刷新时拦一下，避免手滑丢掉正在写的内容
    WBEditor.guardUnsavedChanges(isDirty);

    // ===== 快捷键 =====
    WBEditor.installTabIndent($("content-input"));
    WBEditor.installShortcuts($("content-input"), {
      submit: submitMoment,
      save: submitMoment,
    });

    // ===== 初始化 =====
    updateCounter();
    markClean();
    showRestoreBar();
    (function() {
      checkAuth().then(function(ok) {
        if (!ok) return;
        renderImgs();
        validateAndLoad();
      });
    })();
  </script>
</body>
</html>
