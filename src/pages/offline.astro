---
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { url } from "@/utils/url-utils";
---

<MainGridLayout
  title={i18n(I18nKey.offlineTitle)}
  description={i18n(I18nKey.offlineDescription)}
>
  {/* 离线兜底页不是常态内容，声明不被收录；sitemap 里也已同步剔除 */}
  <meta slot="head" name="robots" content="noindex, follow" />

  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-96">
    <div class="card-base z-10 px-9 py-12 relative w-full flex flex-col items-center justify-center text-center">
      <div class="mb-6">
        <Icon is:inline name="material-symbols:cloud-off-rounded" class="text-6xl text-(--primary)" />
      </div>

      <div class="text-3xl md:text-4xl font-bold mb-4 text-90">
        {i18n(I18nKey.offlineTitle)}
      </div>

      <p class="text-lg text-75 mb-8 max-w-md">
        {i18n(I18nKey.offlineDescription)}
      </p>

      <div class="flex flex-col sm:flex-row items-center gap-3">
        <a
          href={url("/")}
          class="inline-flex items-center gap-2 px-6 py-3 bg-(--primary) text-white rounded-(--radius-large) hover:bg-(--btn-content) transition-colors duration-200 font-medium"
        >
          <Icon is:inline name="material-symbols:home" class="text-xl" />
          {i18n(I18nKey.backToHome)}
        </a>
        {/*
          重新加载按钮由脚本接管：直接 location.reload() 会重新走网络，
          连不上时浏览器会再次落到本页，体验上像是「点了没反应」。
          因此点击时先探测一次，能连上才跳转。
        */}
        <button
          id="offline-retry"
          type="button"
          data-retry-url={url("/")}
          class="inline-flex items-center gap-2 px-6 py-3 rounded-(--radius-large) border border-(--line-color) text-90 hover:bg-(--btn-plain-bg-hover) transition-colors duration-200 font-medium cursor-pointer"
        >
          <Icon is:inline name="material-symbols:refresh" class="text-xl" />
          <span id="offline-retry-label">重新连接</span>
        </button>
      </div>
    </div>
  </div>
</MainGridLayout>

<script>
  const button = document.getElementById("offline-retry");
  const label = document.getElementById("offline-retry-label");
  if (button && label) {
    const original = label.textContent ?? "";
    button.addEventListener("click", async () => {
      label.textContent = "正在重试…";
      (button as HTMLButtonElement).disabled = true;
      const target = button.getAttribute("data-retry-url") ?? "/";
      try {
        // no-store 避免命中 Service Worker 的缓存，否则连不上也会「成功」
        const res = await fetch(target, { method: "HEAD", cache: "no-store" });
        if (res.ok) {
          window.location.href = target;
          return;
        }
      } catch {
        /* 仍然连不上，走下面的复原逻辑 */
      }
      label.textContent = "仍然无法连接";
      (button as HTMLButtonElement).disabled = false;
      window.setTimeout(() => {
        label.textContent = original;
      }, 2000);
    });
  }
</script>

<style>
  .card-base {
    animation: fadeInUp 0.6s ease-out;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
