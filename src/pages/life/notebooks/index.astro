---
import { Icon } from "astro-icon/components";
import FilterTabs from "@/components/atoms/FilterTabs.astro";
import PageHeader from "@/components/features/page-header/PageHeader.astro";
import { externalNotebooksConfig } from "@/config/externalNotebooksConfig";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

// 笔记列表页
//
// 笔记内容存在远程仓库里（每本笔记一个地址），页面打开后再去取，因此这里
// 只负责搭好骨架与筛选按钮，条目由页面脚本填充。
//
// 取数用的地址表放在一段 JSON 脚本里交给页面脚本读取，而不是让脚本直接
// 引入配置文件 —— 配置文件里同时存着后台密码校验值，直接引入会把那段值
// 一起打进公开页面的脚本里。

const title = "笔记";
const subtitle = "按笔记本归集的随手记录，点开即可阅读全文";

const notebookGists = externalNotebooksConfig.notebookGists || {};
const notebooks = Object.keys(notebookGists);

const tabs = [
	{ value: "all", label: "全部", icon: "material-symbols:list-rounded" },
	...notebooks.map((name) => ({ value: name, label: name })),
];
---

<MainGridLayout title={title} description={subtitle} keywords={notebooks}>
  <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-6 sm:px-9 py-6 relative w-full">
      <PageHeader title={title} subtitle={subtitle} />

      {/* 笔记本名 -> 远程地址，供页面脚本取数使用 */}
      <script
        is:inline
        type="application/json"
        id="notebook-config"
        set:html={JSON.stringify(notebookGists).replace(/</g, "\\u003c")}
      />

      <div class="mb-8">
        <FilterTabs tabs={tabs} dataAttr="notebook" />
      </div>

      {/* 条目容器：加载状态先占位，取到数据后由脚本替换 */}
      <div id="notebook-entries" class="grid grid-cols-1 md:grid-cols-2 gap-4 items-start">
        {
          notebooks.length > 0 ? (
            <div
              id="notebook-loading"
              class="col-span-full flex flex-col items-center justify-center gap-3 py-16 text-(--content-meta)"
            >
              <Icon name="svg-spinners:ring-resize" class="text-4xl" />
              <span>正在取回笔记…</span>
            </div>
          ) : (
            <div class="col-span-full flex flex-col items-center justify-center gap-3 py-16 text-(--content-meta)">
              <Icon name="material-symbols:book-2-outline" class="text-5xl opacity-40" />
              <span>还没有配置任何笔记本</span>
            </div>
          )
        }
      </div>

      {/* 筛不出结果时的提示，由页面脚本控制显隐 */}
      <div id="notebook-no-results" class="hidden flex-col items-center justify-center gap-3 py-16 text-(--content-meta)">
        <Icon name="material-symbols:search-off-rounded" class="text-5xl opacity-40" />
        <span>这个笔记本下还没有笔记</span>
      </div>

      <div class="mt-8 text-sm text-(--content-meta)">
        <p>
          笔记列表来自远程存储，需要联网才能读取。想写新笔记请到
          <a href="/admin/notebooks/" class="text-(--primary) underline decoration-dashed underline-offset-4">笔记管理</a>。
        </p>
      </div>
    </div>
  </div>
</MainGridLayout>

<!-- 卡片由页面脚本动态生成，Astro 的作用域样式不会匹配到这些节点，
     因此这里用全局样式。类名都带 notebook 前缀，不会波及站点其它部分。 -->
<style is:global>
  .notebook-card.filtered-out {
    display: none;
  }

  .notebook-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--line-divider);
    border-radius: var(--radius-large);
    background: var(--btn-regular-bg);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      background 0.2s ease,
      transform 0.2s ease;
  }

  .notebook-card:hover {
    border-color: var(--primary);
    transform: translateY(-2px);
  }

  .notebook-card-title {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.5;
    color: var(--text-color);
    /* 标题最多两行，卡片高度保持一致 */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .notebook-card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--content-meta);
  }

  .notebook-card-badge {
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    background: color-mix(in oklch, var(--primary) 16%, transparent);
    color: var(--primary);
    font-weight: 500;
  }

  .notebook-card-excerpt {
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--content-meta);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .notebook-card {
      transition: none;
    }

    .notebook-card:hover {
      transform: none;
    }
  }
</style>

<script>
	interface NotebookEntry {
		id?: string;
		notebook?: string;
		title?: string;
		date?: string;
		content?: string;
		createdAt?: string;
		updatedAt?: string;
	}

	interface DisplayEntry {
		id: string;
		notebook: string;
		title: string;
		date: string;
		excerpt: string;
	}

	const ENTRY_PAGE = "/life/notebooks/remote-entry/";

	/** 取回数据后缓存在内存里，来回切页不用重复请求 */
	let cache: DisplayEntry[] | null = null;

	/**
	 * 读取笔记条目。
	 *
	 * 远程文件的实际形态是"条目数组"，但早期版本与部分笔记本里可能是
	 * "{ entries: [...] }" 这种包了一层的写法，两种都接受，避免因为形态
	 * 不同就整本笔记读不出来。
	 */
	function readEntries(payload: unknown): NotebookEntry[] {
		if (Array.isArray(payload)) return payload as NotebookEntry[];
		if (payload && typeof payload === "object") {
			const nested = (payload as { entries?: unknown }).entries;
			if (Array.isArray(nested)) return nested as NotebookEntry[];
		}
		return [];
	}

	function escapeHtml(text: string): string {
		return text
			.replace(/&/g, "&amp;")
			.replace(/</g, "&lt;")
			.replace(/>/g, "&gt;")
			.replace(/"/g, "&quot;");
	}

	/** 把 markdown 正文压成一段纯文本摘要 */
	function toExcerpt(content: string): string {
		return content
			.replace(/```[\s\S]*?```/g, " ") // 代码块
			.replace(/!\[[^\]]*\]\([^)]*\)/g, " ") // 图片
			.replace(/\[([^\]]*)\]\([^)]*\)/g, "$1") // 链接只留文字
			.replace(/^\s{0,3}#{1,6}\s*/gm, "") // 标题符号
			.replace(/^\s{0,3}>\s?/gm, "") // 引用符号
			.replace(/^\s{0,3}[-*+]\s+/gm, "") // 列表符号
			.replace(/[*_~`]/g, "")
			.replace(/\s+/g, " ")
			.trim();
	}

	function sortKey(entry: NotebookEntry): string {
		return entry.date || entry.updatedAt || entry.createdAt || "";
	}

	async function fetchNotebook(
		notebook: string,
		gistId: string,
	): Promise<DisplayEntry[]> {
		const res = await fetch(
			`https://gist.githubusercontent.com/raw/${gistId}/notebooks-entries.json`,
			{ cache: "no-cache" },
		);
		if (!res.ok) throw new Error(`${notebook} 读取失败`);
		const entries = readEntries(await res.json());
		return entries.map((entry, index) => {
			const content = entry.content || "";
			return {
				id: String(entry.id ?? `${notebook}-${index}`),
				notebook: entry.notebook || notebook,
				title: entry.title || "未命名笔记",
				date: sortKey(entry).slice(0, 10),
				excerpt: toExcerpt(content),
			};
		});
	}

	function renderCard(entry: DisplayEntry): string {
		const href =
			`${ENTRY_PAGE}?nb=${encodeURIComponent(entry.notebook)}` +
			`&id=${encodeURIComponent(entry.id)}`;
		return `
			<a class="notebook-card" data-notebook="${escapeHtml(entry.notebook)}" href="${escapeHtml(href)}">
				<span class="notebook-card-title">${escapeHtml(entry.title)}</span>
				<span class="notebook-card-meta">
					<span class="notebook-card-badge">${escapeHtml(entry.notebook)}</span>
					${entry.date ? `<span>${escapeHtml(entry.date)}</span>` : ""}
				</span>
				${entry.excerpt ? `<span class="notebook-card-excerpt">${escapeHtml(entry.excerpt)}</span>` : ""}
			</a>
		`;
	}

	function currentFilter(): string {
		const active = document.querySelector<HTMLElement>(".filter-tabs-item.active");
		return active?.dataset.filterValue || "all";
	}

	function applyFilter(value: string): void {
		const host = document.getElementById("notebook-entries");
		const noResults = document.getElementById("notebook-no-results");
		if (!host) return;
		let visible = 0;
		host.querySelectorAll<HTMLElement>(".notebook-card").forEach((card) => {
			const match = value === "all" || card.dataset.notebook === value;
			card.classList.toggle("filtered-out", !match);
			if (match) visible++;
		});
		if (noResults) {
			noResults.classList.toggle("hidden", visible > 0);
			noResults.classList.toggle("flex", visible === 0);
		}
	}

	function showMessage(host: HTMLElement, icon: string, text: string): void {
		host.innerHTML = `
			<div class="col-span-full flex flex-col items-center justify-center gap-3 py-16 text-(--content-meta)">
				<span class="text-5xl opacity-40">${icon}</span>
				<span>${escapeHtml(text)}</span>
			</div>
		`;
	}

	async function loadAll(host: HTMLElement, gists: Record<string, string>): Promise<void> {
		const names = Object.keys(gists);
		const results = await Promise.all(
			names.map(async (name) => {
				try {
					return await fetchNotebook(name, gists[name]);
				} catch {
					return [] as DisplayEntry[];
				}
			}),
		);
		const all = results
			.flat()
			.sort((a, b) => (a.date < b.date ? 1 : a.date > b.date ? -1 : 0));
		cache = all;

		if (all.length === 0) {
			showMessage(host, "📭", "笔记本里还没有内容");
			return;
		}
		host.innerHTML = all.map(renderCard).join("");
		applyFilter(currentFilter());
	}

	function init(): void {
		const configEl = document.getElementById("notebook-config");
		const host = document.getElementById("notebook-entries");
		// 当前不在笔记列表页
		if (!configEl || !host) return;

		let gists: Record<string, string> = {};
		try {
			gists = JSON.parse(configEl.textContent || "{}");
		} catch {
			gists = {};
		}
		if (Object.keys(gists).length === 0) return;

		// 筛选按钮：站点在页面切换时会把内容整块换掉，按钮是全新的节点，
		// 不需要解绑；这里只在同一个节点上重复走初始化时跳过，避免一次点击
		// 触发两次筛选。
		document.querySelectorAll<HTMLElement>(".filter-tabs-item").forEach((tab) => {
			if (tab.dataset.filterBound === "1") return;
			tab.dataset.filterBound = "1";
			tab.addEventListener("click", () => {
				document
					.querySelectorAll(".filter-tabs-item")
					.forEach((t) => t.classList.remove("active"));
				tab.classList.add("active");
				applyFilter(tab.dataset.filterValue || "all");
			});
		});

		if (cache) {
			host.innerHTML = cache.map(renderCard).join("");
			applyFilter("all");
			return;
		}

		loadAll(host, gists).catch(() => {
			showMessage(host, "⚠️", "笔记读取失败，请检查网络后刷新重试");
		});
	}

	document.addEventListener("swup:contentReplaced", init);
	document.addEventListener("astro:page-load", init);
	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", init);
	} else {
		init();
	}
</script>
