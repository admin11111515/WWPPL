---
import { externalNotebooksConfig } from "@/config/externalNotebooksConfig";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

// 单篇笔记详情页
//
// 要读哪一篇由地址里的参数决定（nb = 笔记本名，id = 笔记编号），所以这个页面
// 是"一页多用"：同一份产物服务所有笔记。内容来自远程仓库，打开后再取。
//
// 这里不用 Astro 的内联脚本写逻辑 —— 内联脚本里的 Astro 表达式不会被求值，
// 而且页面切换时新插入的内联脚本也不会执行。逻辑放在下方的模块脚本里，
// 由页面切换事件驱动重新初始化。

const notebookGists = externalNotebooksConfig.notebookGists || {};

const title = "笔记";
const description = "查看笔记全文";
---

<MainGridLayout title={title} description={description}>
  <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-6 sm:px-9 py-6 relative w-full">
      {/* 笔记本名 -> 远程地址，供页面脚本取数使用 */}
      <script
        is:inline
        type="application/json"
        id="notebook-config"
        set:html={JSON.stringify(notebookGists).replace(/</g, "\\u003c")}
      />

      <div class="notebook-entry-header">
        <a class="notebook-back" href="/life/notebooks/">
          <span aria-hidden="true">←</span>
          返回列表
        </a>
      </div>

      <div class="notebook-entry-content" id="entry-content">
        <div class="notebook-state">
          <span class="notebook-spinner" aria-hidden="true"></span>
          <p>正在取回笔记…</p>
        </div>
      </div>
    </div>
  </div>
</MainGridLayout>

<style is:global>
  .notebook-entry-header {
    margin-bottom: 1.5rem;
  }

  .notebook-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--line-divider);
    border-radius: var(--radius-large);
    background: var(--btn-regular-bg);
    color: var(--btn-content);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .notebook-back:hover {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  .notebook-entry-content {
    background: var(--card-bg);
    border: 1px solid var(--line-divider);
    border-radius: var(--radius-large);
    padding: 1.5rem;
    min-height: 12rem;
  }

  .notebook-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 3rem 1rem;
    color: var(--content-meta);
    text-align: center;
  }

  .notebook-state-icon {
    font-size: 2.25rem;
    line-height: 1;
  }

  /* 纯样式加载指示器：动态生成的节点用不了站点的图标组件 */
  .notebook-spinner {
    width: 2rem;
    height: 2rem;
    border: 3px solid var(--line-divider);
    border-top-color: var(--primary);
    border-radius: 50%;
    animation: notebook-spin 0.9s linear infinite;
  }

  @keyframes notebook-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .notebook-spinner {
      animation-duration: 2.5s;
    }

    .notebook-back {
      transition: none;
    }
  }

  .notebook-title {
    font-size: 1.75rem;
    font-weight: 600;
    line-height: 1.35;
    margin-bottom: 0.75rem;
  }

  .notebook-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--line-divider);
    font-size: 0.875rem;
    color: var(--content-meta);
  }

  .notebook-badge {
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    background: color-mix(in oklch, var(--primary) 16%, transparent);
    color: var(--primary);
    font-weight: 500;
  }

  .notebook-body {
    line-height: 1.85;
  }

  .notebook-body h1,
  .notebook-body h2,
  .notebook-body h3,
  .notebook-body h4 {
    margin: 1.5rem 0 0.75rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .notebook-body h1 { font-size: 1.5rem; }
  .notebook-body h2 { font-size: 1.25rem; }
  .notebook-body h3 { font-size: 1.125rem; }
  .notebook-body h4 { font-size: 1rem; }

  .notebook-body > :first-child {
    margin-top: 0;
  }

  .notebook-body p,
  .notebook-body ul,
  .notebook-body ol,
  .notebook-body blockquote,
  .notebook-body pre,
  .notebook-body table {
    margin-bottom: 1rem;
  }

  .notebook-body ul,
  .notebook-body ol {
    padding-left: 1.5rem;
  }

  .notebook-body ul { list-style: disc; }
  .notebook-body ol { list-style: decimal; }

  .notebook-body li {
    margin-bottom: 0.25rem;
  }

  .notebook-body blockquote {
    border-left: 4px solid var(--primary);
    border-radius: 0 var(--radius) var(--radius) 0;
    background: var(--btn-regular-bg);
    padding: 0.75rem 1rem;
    color: var(--content-meta);
  }

  .notebook-body code {
    background: var(--btn-regular-bg);
    border-radius: 4px;
    padding: 0.125rem 0.375rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.9em;
  }

  .notebook-body pre {
    background: var(--btn-regular-bg);
    border-radius: var(--radius);
    padding: 1rem;
    overflow-x: auto;
  }

  .notebook-body pre code {
    background: transparent;
    padding: 0;
  }

  .notebook-body img {
    max-width: 100%;
    border-radius: var(--radius);
    margin: 1rem 0;
  }

  .notebook-body a {
    color: var(--primary);
    text-decoration: underline;
    text-decoration-style: dashed;
    text-underline-offset: 4px;
  }

  .notebook-body hr {
    border: none;
    border-top: 1px solid var(--line-divider);
    margin: 1.5rem 0;
  }

  .notebook-body table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  .notebook-body th,
  .notebook-body td {
    border: 1px solid var(--line-divider);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }

  .notebook-body input[type="checkbox"] {
    margin-right: 0.375rem;
  }

  .notebook-plain {
    white-space: pre-wrap;
    word-break: break-word;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.9rem;
    line-height: 1.7;
  }
</style>

<script>
	const ENTRY_LIST_PAGE = "/life/notebooks/";
	// 渲染库优先用站内副本：它本来就在产物里，跟着页面一起分发，
	// 不依赖第三方 CDN（国内访问 jsdelivr 经常超时）；取不到再退回 CDN。
	const MARKED_LOCAL = "/assets/js/marked.min.js";
	const MARKED_CDN = "https://cdn.jsdelivr.net/npm/marked/marked.min.js";

	interface NotebookEntry {
		id?: string;
		notebook?: string;
		title?: string;
		date?: string;
		content?: string;
		createdAt?: string;
		updatedAt?: string;
	}

	/** 取回的数据可能是"条目数组"，也可能被包了一层，两种都接受 */
	function readEntries(payload: unknown): NotebookEntry[] {
		if (Array.isArray(payload)) return payload as NotebookEntry[];
		if (payload && typeof payload === "object") {
			const nested = (payload as { entries?: unknown }).entries;
			if (Array.isArray(nested)) return nested as NotebookEntry[];
		}
		return [];
	}

	function escapeHtml(text: string): string {
		return text
			.replace(/&/g, "&amp;")
			.replace(/</g, "&lt;")
			.replace(/>/g, "&gt;")
			.replace(/"/g, "&quot;");
	}

	function renderState(host: HTMLElement, icon: string, text: string, extra = ""): void {
		host.innerHTML = `
			<div class="notebook-state">
				<span class="notebook-state-icon" aria-hidden="true">${icon}</span>
				<p>${escapeHtml(text)}</p>
				${extra}
			</div>
		`;
	}

	let markedPromise: Promise<unknown> | null = null;

	/**
	 * 按需加载 markdown 渲染库。
	 *
	 * 原来是在页面里写死一个脚本标签，但站点用页面切换的方式换内容，新插入的
	 * 脚本不会执行，第二次进入这个页面时渲染库就不在了。这里改成按需注入，
	 * 加载过一次就一直可用。
	 */
	function ensureMarked(): Promise<unknown> {
		const w = window as unknown as { marked?: unknown };
		if (w.marked) return Promise.resolve(w.marked);
		if (markedPromise) return markedPromise;
		/** 依次尝试给定的地址，全部失败才算失败 */
		const load = (sources: string[]): Promise<unknown> =>
			new Promise((resolve, reject) => {
				const [src, ...rest] = sources;
				if (!src) {
					reject(new Error("渲染库加载失败"));
					return;
				}
				const el = document.createElement("script");
				el.src = src;
				el.onload = () => resolve((window as unknown as { marked?: unknown }).marked);
				el.onerror = () => {
					el.remove();
					load(rest).then(resolve, reject);
				};
				document.head.appendChild(el);
			});
		markedPromise = load([MARKED_LOCAL, MARKED_CDN]);
		return markedPromise;
	}

	/** 去掉正文里可能夹带的脚本与事件属性后再插入页面 */
	function sanitize(html: string): string {
		const doc = new DOMParser().parseFromString(html, "text/html");
		doc.querySelectorAll("script, iframe, object, embed, form, link, meta").forEach((el) => el.remove());
		doc.querySelectorAll("*").forEach((el) => {
			for (const attr of Array.from(el.attributes)) {
				const name = attr.name.toLowerCase();
				if (name.startsWith("on") || (name === "href" && attr.value.trim().toLowerCase().startsWith("javascript:"))) {
					el.removeAttribute(attr.name);
				}
			}
		});
		return doc.body.innerHTML;
	}

	async function render(host: HTMLElement, entry: NotebookEntry, notebook: string): Promise<void> {
		const title = entry.title || "未命名笔记";
		const date = (entry.date || entry.updatedAt || entry.createdAt || "").slice(0, 10);
		const content = entry.content || "";

		document.title = title;
		host.innerHTML = `
			<article>
				<h1 class="notebook-title">${escapeHtml(title)}</h1>
				<div class="notebook-meta">
					<span class="notebook-badge">${escapeHtml(entry.notebook || notebook)}</span>
					${date ? `<span>${escapeHtml(date)}</span>` : ""}
				</div>
				<div class="notebook-body" id="entry-body"></div>
			</article>
		`;

		const body = document.getElementById("entry-body");
		if (!body) return;
		if (!content.trim()) {
			body.innerHTML = '<p style="color: var(--content-meta)">这篇笔记还没有正文。</p>';
			return;
		}

		try {
			const marked = (await ensureMarked()) as { parse: (text: string) => string };
			body.innerHTML = sanitize(marked.parse(content));
		} catch {
			// 渲染库取不到时退化为纯文本，至少内容能看
			body.innerHTML = `<div class="notebook-plain">${escapeHtml(content)}</div>`;
		}
	}

	async function init(): Promise<void> {
		const configEl = document.getElementById("notebook-config");
		const host = document.getElementById("entry-content");
		// 当前不在笔记详情页
		if (!configEl || !host) return;
		// 同一次进入里可能被多个事件重复触发，已渲染出内容就不再重复处理
		if (host.dataset.rendered === "1") return;

		let gists: Record<string, string> = {};
		try {
			gists = JSON.parse(configEl.textContent || "{}");
		} catch {
			gists = {};
		}

		const params = new URLSearchParams(window.location.search);
		const notebook = params.get("nb") || "";
		const id = params.get("id") || "";

		if (!notebook || !id) {
			renderState(
				host,
				"🧭",
				"没有指定要看的笔记，请从列表进入",
				`<a class="notebook-back" href="${ENTRY_LIST_PAGE}">去笔记列表</a>`,
			);
			host.dataset.rendered = "1";
			return;
		}

		const gistId = gists[notebook];
		if (!gistId) {
			renderState(
				host,
				"⚠️",
				`没有找到名为「${notebook}」的笔记本`,
				`<a class="notebook-back" href="${ENTRY_LIST_PAGE}">去笔记列表</a>`,
			);
			host.dataset.rendered = "1";
			return;
		}

		try {
			const res = await fetch(
				`https://gist.githubusercontent.com/raw/${gistId}/notebooks-entries.json`,
				{ cache: "no-cache" },
			);
			if (!res.ok) throw new Error(`读取失败（${res.status}）`);
			const entries = readEntries(await res.json());
			const entry = entries.find((item) => String(item.id) === id);
			if (!entry) {
				renderState(
					host,
					"🔍",
					"这篇笔记不存在，可能已经被删除",
					`<a class="notebook-back" href="${ENTRY_LIST_PAGE}">去笔记列表</a>`,
				);
				host.dataset.rendered = "1";
				return;
			}
			await render(host, entry, notebook);
			host.dataset.rendered = "1";
		} catch (error) {
			const reason = error instanceof Error ? error.message : "未知原因";
			renderState(
				host,
				"⚠️",
				`笔记读取失败：${reason}`,
				`<a class="notebook-back" href="${ENTRY_LIST_PAGE}">去笔记列表</a>`,
			);
			host.dataset.rendered = "1";
		}
	}

	document.addEventListener("swup:contentReplaced", () => {
		void init();
	});
	document.addEventListener("astro:page-load", () => {
		void init();
	});
	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", () => {
			void init();
		});
	} else {
		void init();
	}
</script>
