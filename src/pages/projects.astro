---
import { FilterTabs } from "@components/atoms";
import { PageHeader } from "@components/features/page-header";
import { ProjectCard } from "@components/features/projects";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";

import { siteConfig } from "../config";
import { UNCATEGORIZED } from "../constants/constants";
import { projectsData } from "../data/projects";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";

if (!siteConfig.pages.projects) {
	return Astro.redirect("/404/");
}

const categories = [
	...new Set(projectsData.map((project) => project.category)),
];

const getCategoryText = (category: string) => {
	switch (category) {
		case "web":
			return i18n(I18nKey.projectsWeb);
		case "mobile":
			return i18n(I18nKey.projectsMobile);
		case "desktop":
			return i18n(I18nKey.projectsDesktop);
		case "other":
			return i18n(I18nKey.projectsOther);
		case UNCATEGORIZED:
			return i18n(I18nKey.uncategorized);
		default:
			return category;
	}
};

const getCategoryIcon = (category: string) => {
	switch (category) {
		case "web":
			return "fluent-color:globe-24";
		case "mobile":
			return "fluent-color:phone-24";
		case "desktop":
			return "fluent-color:laptop-24";
		case "other":
			return "fluent-color:apps-24";
		default:
			return "fluent-color:document-folder-24";
	}
};

const filterTabs = [
	{
		value: "all",
		label: i18n(I18nKey.friendsFilterAll),
		icon: "fluent-color:apps-24",
		count: projectsData.length,
	},
	...categories.map((category) => ({
		value: category,
		label: getCategoryText(category),
		icon: getCategoryIcon(category),
		count: projectsData.filter((p) => p.category === category).length,
	})),
];

const title = i18n(I18nKey.projects);
const subtitle = i18n(I18nKey.projectsSubtitle);
// 一项都还没有的时候，不摆一个"全部 (0)"的筛选栏和一个空网格
const hasProjects = projectsData.length > 0;
---

<MainGridLayout hasVisibleTitle title={title} description={subtitle}>
	{/*
		这里原来有一句 initIconLoader()，是白写的：本页一个 <iconify-icon> 都没有
		（筛选栏的图标走 astro-icon，构建期就内联成 <svg> 了），
		而 Layout 里的 initIconLoaderIfNeeded() 已经会在真用得上时兜底。
		留着的唯一效果是让每个访客白下一次第三方脚本，所以删掉。
	*/}
	<script is:inline src="/js/filter-tabs-handler.js"></script>

	<div
		class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32"
	>
		<div class="card-base z-10 px-6 sm:px-9 py-6 relative w-full">
			<PageHeader title={title} subtitle={subtitle} />

			{hasProjects && (
				<div class="mb-8">
					<FilterTabs tabs={filterTabs} dataAttr="category" />
				</div>
			)}

			<div
				id="projects-grid"
				class="grid grid-cols-1 md:grid-cols-2 gap-6 items-start"
			>
				{
					projectsData.map((project) => (
						<ProjectCard project={project} maxTechStack={4} />
					))
				}
			</div>

			{
				!hasProjects && (
					<div class="text-center py-16">
						<Icon is:inline
							name="fluent-color:document-folder-24"
							class="text-6xl text-black/15 dark:text-white/15 mb-4"
						/>
						<p class="text-black/40 dark:text-white/40 text-lg">
							{i18n(I18nKey.projectsEmpty)}
						</p>
						<a
							href="/archive/"
							class="inline-block mt-4 text-sm underline underline-offset-4 opacity-70 transition-opacity hover:opacity-100"
						>
							{i18n(I18nKey.keepExploring)}
						</a>
					</div>
				)
			}

			<div id="no-results" class="hidden text-center py-16">
				<Icon is:inline
					name="fluent-color:search-visual-24"
					class="text-6xl text-black/15 dark:text-white/15 mb-4"
				/>
				<p class="text-black/40 dark:text-white/40 text-lg">
					{i18n(I18nKey.noData)}
				</p>
				<a
					href="/archive/"
					class="inline-block mt-4 text-sm underline underline-offset-4 opacity-70 transition-opacity hover:opacity-100"
				>
					{i18n(I18nKey.keepExploring)}
				</a>
			</div>
		</div>
	</div>
</MainGridLayout>