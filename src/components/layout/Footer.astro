---
import fs from "node:fs";
import path from "node:path";
import { footerConfig, profileConfig } from "@/config";
import { siteInfo } from "@/config/siteInfo";
import {
	getAnalyticsServicesHtml,
	getServiceBadgesHtml,
} from "@/utils/footer-services";
import { url } from "@/utils/url-utils";

const currentYear = new Date().getFullYear();

/**
 * FooterConfig.html 里可以写 {{xxx}} 占位符，这里负责顶掉。
 * 目前只有一个：{{footerText}} —— 页脚那行文案，后台「站点信息」页可改。
 *
 * 值要做 HTML 转义：它是一句纯文案，里面的 < > & 应该原样显示，
 * 而不是被当成标签塞进页脚。
 */
const FOOTER_PLACEHOLDERS: Record<string, string> = {
	footerText: siteInfo.footerText,
};

function fillPlaceholders(html: string): string {
	return html.replace(/\{\{(\w+)\}\}/g, (match, key: string) => {
		const value = FOOTER_PLACEHOLDERS[key];
		if (value === undefined) return match;
		return value
			.replace(/&/g, "&amp;")
			.replace(/</g, "&lt;")
			.replace(/>/g, "&gt;");
	});
}

// 读取 package.json 获取版本号
let themeVersion = "unknown";
try {
	const packageJsonPath = path.join(process.cwd(), "package.json");
	const packageJson = JSON.parse(fs.readFileSync(packageJsonPath, "utf-8"));
	themeVersion = packageJson.version;
} catch (error) {
	console.warn("读取 package.json 版本号失败:", error.message);
}

// 读取FooterConfig.html文件内容
let customFooterHtml = "";
if (footerConfig.enable) {
	try {
		const footerConfigPath = path.join(
			process.cwd(),
			"src",
			"config",
			"FooterConfig.html",
		);
		customFooterHtml = fs.readFileSync(footerConfigPath, "utf-8");
		// 移除HTML注释
		customFooterHtml = customFooterHtml.replace(/<!--[\s\S]*?-->/g, "").trim();
		// 替换版本号占位符
		customFooterHtml = customFooterHtml.replace(
			/__THEME_VERSION__/g,
			themeVersion,
		);
		// 替换服务徽章与统计服务说明（按实际配置生成，避免页脚写着用了其实没用的服务）
		customFooterHtml = customFooterHtml
			.replace(/__SERVICE_BADGES__/g, getServiceBadgesHtml())
			.replace(/__ANALYTICS_SERVICES__/g, getAnalyticsServicesHtml());
		// 最后顶掉 {{footerText}} 这类站点信息占位符
		customFooterHtml = fillPlaceholders(customFooterHtml);
		// 页脚文案留空时（后台清空了），把只剩空 <span> 的那个容器一起去掉，
		// 否则 .footer-info 的 margin-top 会在页脚底部留一段空行。
		// 占位符本身保留 —— 以后在后台填回文案就照常显示。
		if (!siteInfo.footerText) {
			customFooterHtml = customFooterHtml.replace(
				/\s*<div class="footer-info">\s*<span><\/span>\s*<\/div>/g,
				"",
			);
		}
	} catch (error) {
		console.warn("FooterConfig.html文件读取失败:", error.message);
	}
}
---


<div
  class="transition border-t border-black/10 dark:border-white/15 my-10 border-dashed mx-32"
>
</div>

<div
  class="transition border-dashed border-[oklch(85%_0.01_var(--hue))] dark:border-white/15 rounded-2xl mb-12 flex flex-col items-center justify-center px-6"
>
  <div class="transition text-50 text-sm text-center wrap">
    <div class="mb-2">
      {customFooterHtml && <div set:html={customFooterHtml} />}
    </div>
    <div class="m-0.5">
      &copy; <span id="copyright-year">{currentYear}</span>
      {profileConfig.name}. All Rights Reserved. /
      <a
        class="transition link text-(--primary) font-medium"
        target="_blank"
        href={url("rss.xml")}>RSS</a
      > /
      <a
        class="transition link text-(--primary) font-medium"
        target="_blank"
        href={url("sitemap-index.xml")}>Sitemap</a
      >
    </div>
    <div class="m-0.5">
      Powered by
      <a
        class="transition link text-(--primary) font-medium"
        target="_blank"
        href="https://astro.build">Astro</a
      > &
      <a
        class="transition link text-(--primary) font-medium"
        target="_blank"
        href="https://github.com/admin11111515/WWPPL">Firefly</a
      >
    </div>
    <!-- 
      注意：请勿随意修改或删除 "Powered by Astro & Firefly" 部分，这是对开源项目的尊重和支持。
      如果您需要在底部增加内容，请在src/config/footerConfig.ts中修改enable属性为true，然后编辑src/config/FooterConfig.html文件。
      您可以随意在src/config/FooterConfig.html中随意添加自定义内容，不需要修改Footer.astro文件。
    -->
  </div>
</div>
