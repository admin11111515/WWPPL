---
import FloatingButton from "@/components/common/FloatingButton.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
---

<!-- There can't be a filter on parent element, or it will break `fixed` -->
<FloatingButton
  id="back-to-top-btn"
  icon="material-symbols:keyboard-arrow-up-rounded"
  ariaLabel={i18n(I18nKey.backToTop)}
  onclick="backToTop()"
  class="hide" 
/>

<script is:raw is:inline>
  function backToTop() {
    // 直接使用原生滚动，避免OverlayScrollbars冲突
    window.scroll({ top: 0, behavior: "smooth" });
  }

  // 响应式返回顶部按钮管理器
  if (typeof window.BackToTopManager === "undefined") {
    window.BackToTopManager = class BackToTopManager {
      constructor() {
        this.button = document.getElementById("back-to-top-btn");
        this.init();
      }

      init() {
        if (!this.button) return; // wrapper checks removed as it is now flexible

        this.setupScrollListener();
      }

      setupScrollListener() {
        const updateVisibility = () => {
          const scrollTop =
            window.pageYOffset || document.documentElement.scrollTop;

          // 当滚动超过200px时显示按钮
          if (scrollTop > 200) {
            this.button.classList.remove("hide");
          } else {
            this.button.classList.add("hide");
          }
        };

        window.addEventListener("scroll", updateVisibility, { passive: true });
      }
    };
  }
  // ... existing initialization logic ...
  //
  // ⚠️ 这段 is:inline 脚本每次站内跳转都会重跑一遍（swup 的 scripts-plugin 会把
  //    inline 脚本复制重放）。原来这里有三处 new BackToTopManager()：
  //    首屏 DOMContentLoaded 那处是无条件注册的，下面 readyState 分支还会再建一个，
  //    于是**首屏就建了两个**，之后每跳一页再加一个，每个都往 window 上挂一个 scroll 回调。
  //    按钮本身在 swup 的替换容器之外，节点一直是同一个，所以建一个就够一辈子。
  //    只在真的拿到按钮时才落标记：万一脚本执行时按钮还没进文档，
  //    留给下一次机会，不会把它永久判死。
  function initBackToTop() {
    if (window.__wwpplBackToTopInited) return;
    if (!document.getElementById("back-to-top-btn")) return;
    window.__wwpplBackToTopInited = true;
    new BackToTopManager();
  }

  // 页面加载完成后初始化
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initBackToTop);
  } else {
    initBackToTop();
  }
</script>