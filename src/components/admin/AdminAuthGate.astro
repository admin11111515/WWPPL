---
/**
 * 后台各页 <head> 里的「首帧登录闸门」（2026-10-03 加，2026-10-15 补成"默认关门"）。
 *
 * 为什么要有它 —— 站长报的「在后台里导航，总会闪一下登录页」就是它造成的：
 * 以前后台各页一律先按「未登录」渲染（`#admin-main` 被 `body:not(.authed)` 藏起来，
 * 登录页可见），等 `fetch("/api/auth/status")` 的网络往返回来才切成后台。
 * 那段时间里屏幕上就是登录页 —— 每次开一个后台页，闪一下。
 *
 * 这里的做法是：本地有登录标记时，**同步**、在 `<body>` 还没解析之前给 `<html>` 加
 * `.admin-authed`，浏览器第一次绘制时后台就已经是「已登录」的样子，闪不出登录页。
 *
 * 2026-10-15 补的一件事（站长报「别人点后台管理竟然直接进去了」）：
 *   原来「没本地标记就直接 return」= **完全不做判断**，而页面是静态产物、
 *   `#admin-main` 那时并没有被藏起来（那条"未登录就藏"的规则只写在首页），
 *   于是访客会看到**完整的后台界面**（图片库那页更是连 checkAuth 都没有，一直不跳）。
 *   现在改成：
 *     · 没标记 → 不留乐观假设，但**照常去核实**；核实不过 → 送登录页（非首页）/ 撤掉标记（首页）；
 *     · 核实通过 → 补上标记与 `.admin-authed`（换设备、清过存储的老站长不用重登也能进）；
 *   配套的 `admin.css` 里 `html:not(.admin-authed) #admin-main { display: none !important }`
 *   才是真正"关着的门"：访客第一帧就看不到后台主体，只有一句"正在核对登录状态…"。
 *
 * 两条硬规矩：
 *   1. **必须同步、必须放在 <head>**（本地有标记时那一句类必须先加）。用 defer /
 *      DOMContentLoaded 都来不及 —— 那就要等第二次绘制，等于没改。
 *   2. **本地标记不算权限**。它只是"看着像已登录"，真正的判断还是 `/api/auth/status`
 *      （会话是 HttpOnly cookie，JS 碰不到）。所以校验说不认时：
 *        · 后台首页（/admin/）→ 把 `.admin-authed` 摘掉，登录页放回来（重新输密码即可）
 *        · 其余后台页          → 立刻整页跳回 /admin/，不白渲染一遍再跳
 *      也就是说本地标记丢了（换标签页重建、清过存储）不会把人锁在门外。
 *
 * ⚠️ 别把 `admin_auth` 这个键换成 sessionStorage：sessionStorage 一关标签页就没了，
 *    会导致每次重开都白闪一次登录页。这里存的是「UI 提示」，真正的凭据是 HttpOnly cookie，
 *    顶掉它也只是先显示后台、下一秒退回登录页，不会变成越权。
 */
---

<script is:inline>
	(function () {
		var KEY = "admin_auth";
		var isLoginPage = location.pathname.replace(/\/+$/, "") + "/" === "/admin/";
		var ok = null;
		try {
			ok = localStorage.getItem(KEY);
		} catch (e) {
			ok = null;
		}
		// 有标记就先乐观放行（首帧即后台，不闪登录页）；真正的判断在下面那次 fetch
		if (ok) document.documentElement.classList.add("admin-authed");

		function deny() {
			// 首页要能说清"为什么把你踢回来了"：只有**原本有标记**才算"会话过期"。
			// 访客第一次来没有标记，别跟他说"登录已过期"（他会一头雾水）。
			// 留个记号给首页的 failLogin() 读（标记本身下面就要清掉，来不及读）。
			if (isLoginPage && ok) document.documentElement.dataset.authExpired = "1";
			try {
				localStorage.removeItem(KEY);
			} catch (e) {}
			if (isLoginPage) document.documentElement.classList.remove("admin-authed");
			else window.location.replace("/admin/");
		}
		function allow() {
			try {
				localStorage.setItem(KEY, "1");
			} catch (e) {}
			document.documentElement.classList.add("admin-authed");
		}

		// ⚠️ 无论有没有本地标记都核实一次 —— 访客必须被挡住（静态页面上什么都有，
		//    只靠"没标记就不做事"等于把后台摊开给人看）。
		fetch("/api/auth/status")
			.then(function (r) {
				return r.json();
			})
			.then(function (d) {
				if (d && d.authed) allow();
				else deny();
			})
			.catch(deny); // 接口挂了按"不认"处理：首页回登录页，其余页送回首页
	})();
</script>
