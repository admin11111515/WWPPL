---
import Navbar from "@components/layout/Navbar.astro";
/**
 * 后台页面顶部 = 博客的那条导航栏，**只有它**。
 *
 * ⚠️ 2026-10-02 站长定稿，前后改了三次，别再加回来：
 *    1. 第一版「博客导航栏 + 后台标题条」→ 站长：要博客导航栏不要后台的条；
 *    2. 第二版把博客导航栏整个拆了，换成后台专用细顶栏（页面名+明暗+返回+退出）
 *       → 那是最不想要的形态：别处没有的一条，图标还是手写描边 SVG；
 *    3. 第三版 = 博客导航栏 + **内容区里一行页头**（页面名/状态/返回/退出）；
 *    4. 现在（第四版）：站长原话「后台管理 / 首页 / 退出 —— 这一栏完全没有必要
 *       保留」。整行删掉，只剩导航栏。
 *
 * 删掉那行之后有两件事要在别处接着：
 *   · **页面名**只剩浏览器标签页（各页 `<title>`），页面里不再重复写一遍；
 *   · **退出**原来只有那行里那一个按钮 → 已在后台首页（`/admin/`）的
 *     「欢迎回来」右侧补了一个「退出登录」，否则整站没有退出的地方。
 *     （各页 inline script 里的 `doLogout()` 还在，只是不再有按钮调它。）
 */
---

{/* 宽度容器与博客 Layout 的内容区一致：max-w-(--page-width) + xl:w-[92vw] */}
<div class="relative z-50 mx-auto w-full max-w-(--page-width) px-0 md:px-4 xl:w-[92vw]">
  <div id="navbar-wrapper" class="sticky top-0 z-50">
    <Navbar />
  </div>
</div>
