---
import Navbar from "@components/layout/Navbar.astro";
import { Icon } from "astro-icon/components";
/**
 * 后台页面顶部：博客导航栏 + **一行页头**。
 *
 * 这地方的形态被站长来回改过四轮，最后一次是 2026-10-03 定的，别再自己发挥：
 *   1. 导航栏 + 后台标题条           → 「要博客导航栏不要后台的条」
 *   2. 拆掉导航栏换后台细顶栏        → 最错：别处没有的条 + 手写描边图标
 *   3. 导航栏 + 一行页头（页面名/状态/返回/退出）→ 「这一栏完全没有必要保留」，整行删掉
 *   4. 只剩导航栏 → 于是「查看文章时也返回到上一级，现在找不到按钮交互」
 *   5. **现在（第五版）**：一行页头回来了，但站长看过实际渲染图后选的 ——
 *      左「← 后台首页 / 页面名」，右「● 已连接 + 退出」，下面一条细线。
 *
 * ⚠️ 与第 3 版被否掉那条的区别（核验脚本按这几条断言，别改坏）：
 *      · **没有底色**、**不吸顶**（那是"一条栏"让人烦的地方）
 *      · 就是内容区宽度里的一行，不是另开一条横贯全宽的条
 *
 * 页头里的状态点/文字用的是各页 `setStatus()` 认的那两个 id（`status-dot` /
 * `status-text`）—— 所以**各页内容区里那份状态条已经删掉**，别再加回来（会撞 id）。
 */
interface Props {
	/** 页面名，显示在返回链接右边 */
	title: string;
	/** 是否有连接状态；后台首页不调 setStatus，传 false */
	withStatus?: boolean;
}

const { title, withStatus = true } = Astro.props;

/** 后台首页自己不用显示「返回后台首页」—— 那是指向自己 */
const isAdminHome = Astro.url.pathname.replace(/\/+$/, "") === "/admin";
---

{/* 宽度容器与博客 Layout 的内容区一致：max-w-(--page-width) + xl:w-[92vw] */}
<div class="relative z-50 mx-auto w-full max-w-(--page-width) px-0 md:px-4 xl:w-[92vw]">
  <div id="navbar-wrapper" class="sticky top-0 z-50">
    <Navbar />
  </div>
</div>

<div class="container">
  <div class="admin-head">
    <div class="admin-head-left">
      {
        !isAdminHome && (
          <a href="/admin/" class="admin-back" title="回到后台首页">
            <Icon name="material-symbols:arrow-back-rounded" class="admin-back-arrow" />
            <span>后台首页</span>
          </a>
        )
      }
      {!isAdminHome && <span class="admin-head-sep">/</span>}
      <span class="admin-head-title">{title}</span>
    </div>
    <div class="admin-head-right">
      {
        withStatus && (
          <span class="status-bar" id="status-bar">
            <span class="status-dot" id="status-dot" />
            <span id="status-text">正在连接…</span>
          </span>
        )
      }
      <button type="button" class="btn btn-sm" onclick="doLogout()">退出</button>
    </div>
  </div>
</div>

<style is:inline>
  /* 一行页头。⚠️ 刻意不写 background、不写 position —— 它就不是"一条栏" */
  .admin-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 0.75rem;
    padding-bottom: 0.6875rem;
    border-bottom: 1px solid var(--line-soft);
  }
  .admin-head-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }
  .admin-back {
    display: inline-flex;
    align-items: center;
    gap: 0.125rem;
    font-size: 0.75rem;
    color: var(--text-3);
    text-decoration: none;
    transition: color 0.15s;
  }
  .admin-back:hover { color: var(--primary); }
  .admin-back .admin-back-arrow {
    font-size: 1rem;
    line-height: 1;
  }
  .admin-head-sep {
    font-size: 0.75rem;
    color: var(--text-4);
  }
  .admin-head-title {
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
  .admin-head-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }
  @media (max-width: 560px) {
    .admin-head { margin-top: 0.625rem; }
    .admin-head-title { font-size: 0.875rem; }
  }
</style>
