---
import LightDarkSwitch from "@components/controls/LightDarkSwitch.svelte";
import AdminSideNav from "@components/admin/AdminSideNav.astro";
import AdminCommandPalette from "@components/admin/AdminCommandPalette.astro";
import { uiIcon } from "@/constants/ui-icons";
import { Icon } from "astro-icon/components";
/**
 * 后台页面顶部：**只有一行页头**。
 *
 * 这地方的形态被站长来回改过，最后一次是 2026-10-03，别再自己发挥：
 *   1. 导航栏 + 后台标题条           → 「要博客导航栏不要后台的条」
 *   2. 拆掉导航栏换后台细顶栏        → 最错：别处没有的条 + 手写描边图标
 *   3. 导航栏 + 一行页头（页面名/状态/返回/退出）→ 「这一栏完全没有必要保留」，整行删掉
 *   4. 只剩导航栏 → 于是「查看文章时也返回到上一级，现在找不到按钮交互」
 *   5. 导航回来，只留一行页头：左「← 后台首页 / 页面名」，右「● 已连接 + 退出」
 *   6. **现在（第六版）**：站长要求「后台里不需要顶部博客导航栏」→ 博客 `<Navbar />`
 *      整个撤掉。它带来的音乐键 / 背景播放 / 显示设置 / 搜索在后台都是前台功能，
 *      摆在那儿纯是噪音；页头一行照旧，右边顺手接住它留下的**主题开关**。
 *
 * ⚠️ 与第 3 版被否掉那条的区别（核验脚本按这几条断言，别改坏）：
 *      · **没有底色**、**不吸顶**（那是"一条栏"让人烦的地方）
 *      · 就是内容区宽度里的一行，不是另开一条横贯全宽的条
 *
 * ⚠️ 撤导航栏会顺带丢掉的三条口子，都已另行接住，别又把导航栏加回来：
 *      · 回前台 → 侧栏底部「看前台」（新标签打开）
 *      · 回后台首页 / 换功能 → 侧栏那几组入口 + 页头左的「← 后台首页」面包屑
 *      · 切主题 → 页头右侧那个开关（开合逻辑见本文件尾部的内联脚本）
 *
 * 页头里的状态点/文字用的是各页 `setStatus()` 认的那两个 id（`status-dot` /
 * `status-text`）—— 所以**各页内容区里那份状态条已经删掉**，别再加回来（会撞 id）。
 */
interface Props {
	/** 页面名，显示在返回链接右边 */
	title: string;
	/** 是否有连接状态；后台首页不调 setStatus，传 false */
	withStatus?: boolean;
}

const { title, withStatus = true } = Astro.props;

/** 后台首页自己不用显示「返回后台首页」—— 那是指向自己 */
const isAdminHome = Astro.url.pathname.replace(/\/+$/, "") === "/admin";
---

{/* ⚠️ 这里原先是博客 `<Navbar />`（2026-10-03 站长要求撤掉）。
    它带出来的那几件（音乐 / 背景播放 / 显示设置 / 搜索）在后台全是前台功能；
    它承着的「切主题」搬到页头右侧，「回前台」由侧栏底部「看前台」承接。
    删掉这一层后网格只剩侧栏 + 页头容器两列，别再把某个节点塞回这个位置。 */}

{/* 左侧导航：占网格第一列（见 admin.css 的「后台外壳布局」） */}
<AdminSideNav />

{/* 页头（+ 页面内容）：落在网格第二列。
    ⚠️ `admin-head-container` 这个类不能省：`.container` 自带 `padding-bottom: 5rem`（给页面
       收尾留白用的），而页头这个容器**不是内容容器** —— 它下面还紧跟着页面自己的
       `.container`（也带 1.25rem 上内边距），两条叠起来让页头到内容之间空出 ~96px 死白。
       见 admin.css 里 `#admin-main > .container.admin-head-container` 那条。 */}
<div class="container admin-head-container">
  <div class="admin-head">
    <div class="admin-head-left">
      {
        !isAdminHome && (
          <a href="/admin/" class="admin-back" title="回到后台首页">
            <Icon name="material-symbols:arrow-back-rounded" class="admin-back-arrow" />
            <span>后台首页</span>
          </a>
        )
      }
      {!isAdminHome && <span class="admin-head-sep">/</span>}
      <span class="admin-head-title">{title}</span>
    </div>
    <div class="admin-head-right">
      {/*
        命令面板的入口（⌘K / Ctrl+K）。
        ⚠️ 形态上只是一个按钮，加在**已有那一行页头**里 —— 别把它做成一搜一栏。
           站长把后台顶部来回改过六版，最后定的是"一条顶栏都没有"（见文件头）。
        按钮里那个键位由面板自己的脚本按平台填（Mac 显示 ⌘K，其它显示 Ctrl K）——
           写死显示错键位比不显示更糟。
      */}
      <button
        type="button"
        class="btn btn-sm cmdk-trigger"
        data-cmdk-open
        title="搜索功能与操作（⌘K / Ctrl+K）"
        aria-label="搜索功能与操作"
      >
        <span class="admin-i" set:html={uiIcon("fluent-color:search-visual-24")} />
        <span class="cmdk-trigger-key" data-cmdk-key>Ctrl K</span>
      </button>
      {
        withStatus && (
          <span class="status-bar" id="status-bar">
            <span class="status-dot" id="status-dot" />
            <span id="status-text">正在连接…</span>
          </span>
        )
      }
      {/*
        主题开关：博客那条导航栏撤掉后，后台就只剩这一处能切亮/暗/跟随系统了。
        ⚠️ 开合得自己在下面那个内联脚本里接一次 —— `Navbar.astro` 的
           `loadButtonScript()` 已经随导航栏一起不加载了，它原来管着 `#scheme-switch`。
      */}
      <LightDarkSwitch client:load />
      <button type="button" class="btn btn-sm" onclick="doLogout()">退出</button>
    </div>
  </div>
</div>

<AdminCommandPalette />

<style is:inline>
  /* 一行页头。⚠️ 刻意不写 background、不写 position —— 它就不是"一条栏" */
  .admin-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 0.75rem;
    padding-bottom: 0.6875rem;
    border-bottom: 1px solid var(--line-soft);
  }
  .admin-head-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }
  /* ⚠️ 「← 后台首页」是个要点的链接，高度得够：原来只有 18px，
     体检（_gen/_后台易用性体检.mjs）里它是全站唯一「目标小于 24px」的交互元素 ——
     鼠标点不中、触屏更点不到。这里给它一个 24px 的触控高度（项目里定的下限），
     左右再补一点内边距让点击范围不至于刚好卡在文字上。 */
  .admin-back {
    display: inline-flex;
    align-items: center;
    gap: 0.125rem;
    min-height: 24px;
    padding: 0 0.25rem;
    margin-left: -0.25rem;
    border-radius: var(--radius-md, 0.375rem);
    font-size: 0.75rem;
    color: var(--text-3);
    text-decoration: none;
    transition: color 0.15s, background-color 0.15s;
  }
  .admin-back:hover { color: var(--primary); }
  .admin-back .admin-back-arrow {
    font-size: 1rem;
    line-height: 1;
  }
  .admin-head-sep {
    font-size: 0.75rem;
    color: var(--text-4);
  }
  .admin-head-title {
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
  .admin-head-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }
  @media (max-width: 560px) {
    .admin-head { margin-top: 0.625rem; }
    .admin-head-title { font-size: 0.875rem; }
  }
</style>

<script is:inline>
  /* 后台页头上的主题开关：浮层开合。
     原来这一下是 `Navbar.astro` 的 loadButtonScript() 管的，2026-10-03 撤掉
     博客导航栏后它不再加载，所以后台这边自己接一次（面板与按钮都在同一个
     LightDarkSwitch 里，见 LightDarkSwitch.svelte）。 */
  document.addEventListener("DOMContentLoaded", function () {
    var btn = document.getElementById("scheme-switch");
    var panel = document.getElementById("theme-mode-panel");
    if (!btn || !panel) return;
    btn.addEventListener("click", function (e) {
      e.stopPropagation();
      panel.classList.toggle("float-panel-closed");
    });
    document.addEventListener("click", function (e) {
      if (panel.classList.contains("float-panel-closed")) return;
      if (e.target instanceof Node && !panel.contains(e.target) && !btn.contains(e.target)) {
        panel.classList.add("float-panel-closed");
      }
    });
  });
</script>
