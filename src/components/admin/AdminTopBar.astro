---
/**
 * 后台页面顶部：一条干净的后台顶栏（页面名 + 连接状态 + 明暗 + 返回 + 退出）。
 *
 * ⚠️ 2026-10-01 改：这里原来会渲染博客的 `<Navbar />`（主页/文章/动态/兴趣/作品/关于 + 大搜索框）。
 *    后台是**站长自用**界面，顶上挂一排公开菜单既不专业也占地方（还常被挤成竖排）。
 *    现在后台页顶部只留本页该有的东西，返回入口默认回后台首页；首页那页由调用方传 `backHref="/"`。
 *    明暗切换按钮调用 `window.toggleDark()` —— 由 `<AdminTheme />` 提供（各后台页都会渲染它）。
 */

interface Props {
	/** 页面名，显示在顶栏上 */
	title: string;
	/** 是否显示连接状态（有接口调用的页面才需要） */
	withStatus?: boolean;
	/** 返回链接指向哪里，默认回后台首页 */
	backHref?: string;
	/** 返回链接上的字 */
	backLabel?: string;
}

const { title, withStatus = true, backHref = "/admin/", backLabel = "后台" } = Astro.props;
---

<div class="admin-topbar">
  <div class="admin-topbar-inner">
    {/* 页面名是这一条上最该看清的东西，不许被挤；状态文字长了就自己省略 */}
    <div class="admin-topbar-left">
      <h1 class="admin-topbar-title">{title}</h1>
      {
        withStatus && (
          <span class="status-bar min-w-0">
            <span class="status-dot" id="status-dot" />
            <span id="status-text" class="truncate">正在连接…</span>
          </span>
        )
      }
    </div>

    <div class="admin-topbar-right">
      <button
        type="button"
        class="btn-plain rounded-lg h-9 gap-1 px-2.5 text-xs font-bold"
        aria-label="切换明暗"
        title="切换明暗"
        onclick="toggleDark()"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        明暗
      </button>

      <a href={backHref} class="btn-plain rounded-lg h-9 gap-1 px-2.5 text-xs font-bold">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5M12 19l-7-7 7-7"></path>
        </svg>
        {backLabel}
      </a>

      <button type="button" class="btn-plain rounded-lg h-9 px-2.5 text-xs font-bold" onclick="doLogout()">
        退出
      </button>
    </div>
  </div>
</div>

<style is:inline>
  /* 顶栏内部：一行，左右两端对齐；窄屏自动换行而不是挤成一团 */
  .admin-topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
    padding: 0.625rem 0.875rem;
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-large);
    background: var(--card-bg);
  }
  .admin-topbar-left {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-width: 0;
  }
  .admin-topbar-title {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }
  .admin-topbar-right {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    flex-shrink: 0;
  }
</style>
