---
import { uiIcon } from "@/constants/ui-icons";
import { ADMIN_NAV_GROUPS } from "@components/admin/adminNav";

/**
 * 后台左侧导航（2026-10-03 加，站长选的 A 方案）。
 *
 * 为什么要有它：量过一遍 —— 在「文章管理」页里**直达其它后台功能的链接是 0 个**，
 * 想换个功能得「回后台首页 → 再点卡片」= 2 步 + 一次整页跳转。这就是"不好用"的根。
 * 加了这个侧栏，切功能 1 步到位。
 *
 * 分组照功能性质分：内容（产出入的） / 站点（配置） / 媒体。
 *
 * ⚠️ 图标一律单色（material-symbols）—— 跟顶部导航栏同一条约定：
 *    导航是"一排横向扫过"的构件，彩色在上面显杂。内容类才用 fluent-color。
 * ⚠️ 侧栏挂在 `#admin-main` 的网格里（见 admin.css 的「后台外壳布局」），
 *    不是浮层；改布局别把它挤掉。
 */
// 导航数据在 adminNav.ts —— 侧栏与命令面板共用同一份，别在这儿另抄一遍
const GROUPS = ADMIN_NAV_GROUPS;

/** 当前页：末尾斜杠归一，跟 href 精确比 */
const here = Astro.url.pathname.replace(/\/+$/, "") + "/";
const isActive = (href) => href === here;
---

<aside class="admin-side" aria-label="后台导航">
  <nav class="admin-side-nav">
    {
      GROUPS.map((g) => (
        <div class="admin-side-group">
          <div class="admin-side-label">{g.title}</div>
          {g.items.map((it) => (
            <a
              class="admin-side-item"
              href={it.href}
              aria-current={isActive(it.href) ? "page" : undefined}
            >
              <span class="admin-side-icon" set:html={uiIcon(`material-symbols:${it.icon}`)} />
              <span>{it.name}</span>
            </a>
          ))}
        </div>
      ))
    }
  </nav>

  <div class="admin-side-foot">
    <a class="admin-side-item" href="/" target="_blank" rel="noopener">
      <span class="admin-side-icon" set:html={uiIcon("material-symbols:open-in-new")} />
      <span>看前台</span>
    </a>
    <button type="button" class="admin-side-item" onclick="doLogout()">
      <span class="admin-side-icon" set:html={uiIcon("material-symbols:logout")} />
      <span>退出登录</span>
    </button>
  </div>
</aside>

{/*
  窄屏（≤900px）顶部横条的两件事，纯 CSS 做不到，只能在这儿补：

  ① **让人知道"还能往右滑"**。14 个入口挤成一条，右端会把当前那一项从中间切断
     （实测：「技能」显示成「技」），看着像坏了。滚动条在手机上不可见，
     所以按滚动位置给 `.admin-side-nav` 切 `can-left` / `can-right` 两个类，
     由 CSS 在那一侧做渐隐（admin.css 的「窄屏：侧栏不再占一列」那段）。

  ② **载入时把"我在哪一项"滚到看得见的地方**。手机上第一屏常常只能看到前 5 项，
     如果当前页是「友链」，用户会以为导航里没有自己这一项。

  ⚠️ 自己算 scrollLeft，不用 scrollIntoView —— 后者在块轴方向也可能动，
     会把整页往上卷一下（手机上一进页面就跳一下很难受）。
  ⚠️ 字体载入完宽度会变，得再画一次；resize 同理。
*/}
<script is:inline>
  (function () {
    var nav = document.querySelector(".admin-side-nav");
    if (!nav) return;
    var EDGE = 4; // 容差：1px 的亚像素差不当成"还有内容"

    function paint() {
      var max = nav.scrollWidth - nav.clientWidth;
      nav.classList.toggle("can-left", nav.scrollLeft > EDGE);
      nav.classList.toggle("can-right", max > EDGE && nav.scrollLeft < max - EDGE);
    }

    function centerActive() {
      var active = nav.querySelector('[aria-current="page"]');
      if (!active) return;
      var navBox = nav.getBoundingClientRect();
      var itemBox = active.getBoundingClientRect();
      // 只改横轴：把当前项挪到横条中间（左右各留一半余量）
      var delta = itemBox.left - navBox.left - (nav.clientWidth - itemBox.width) / 2;
      nav.scrollLeft = Math.max(0, nav.scrollLeft + delta);
    }

    centerActive();
    paint();
    nav.addEventListener("scroll", paint, { passive: true });
    window.addEventListener("resize", paint);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(paint);
    // 兜底：图片/图标字形晚一步把宽度撑开时，再画一次
    window.setTimeout(function () {
      centerActive();
      paint();
    }, 400);
  })();
</script>
