---
import { uiIcon } from "@/constants/ui-icons";
import { ADMIN_NAV_GROUPS } from "@components/admin/adminNav";

/**
 * 后台左侧导航（2026-10-03 加，站长选的 A 方案）。
 *
 * 为什么要有它：量过一遍 —— 在「文章管理」页里**直达其它后台功能的链接是 0 个**，
 * 想换个功能得「回后台首页 → 再点卡片」= 2 步 + 一次整页跳转。这就是"不好用"的根。
 * 加了这个侧栏，切功能 1 步到位。
 *
 * 分组照功能性质分：内容（产出入的） / 站点（配置） / 媒体。
 *
 * ⚠️ 图标一律单色（material-symbols）—— 跟顶部导航栏同一条约定：
 *    导航是"一排横向扫过"的构件，彩色在上面显杂。内容类才用 fluent-color。
 * ⚠️ 侧栏挂在 `#admin-main` 的网格里（见 admin.css 的「后台外壳布局」）。
 *    桌面宽它是常驻的一列；**窄屏（≤900px）改成抽屉**（2026-10-15）——
 *    同样是这一份 DOM，靠 admin.css 的媒体查询 + 本文件尾部的开关脚本变形态，
 *    别把 aside 拆成两份。
 */
// 导航数据在 adminNav.ts —— 侧栏与命令面板共用同一份，别在这儿另抄一遍
const GROUPS = ADMIN_NAV_GROUPS;

/** 当前页：末尾斜杠归一，跟 href 精确比 */
const here = Astro.url.pathname.replace(/\/+$/, "") + "/";
const isActive = (href) => href === here;
---

<aside class="admin-side" id="admin-side" aria-label="后台导航">
  <nav class="admin-side-nav">
    {
      GROUPS.map((g) => (
        <div class="admin-side-group">
          <div class="admin-side-label">{g.title}</div>
          {g.items.map((it) => (
            <a
              class="admin-side-item"
              href={it.href}
              aria-current={isActive(it.href) ? "page" : undefined}
            >
              <span class="admin-side-icon" set:html={uiIcon(`material-symbols:${it.icon}`)} />
              <span>{it.name}</span>
            </a>
          ))}
        </div>
      ))
    }
  </nav>

  <div class="admin-side-foot">
    <a class="admin-side-item" href="/" target="_blank" rel="noopener">
      <span class="admin-side-icon" set:html={uiIcon("material-symbols:open-in-new")} />
      <span>看前台</span>
    </a>
    <button type="button" class="admin-side-item" onclick="doLogout()">
      <span class="admin-side-icon" set:html={uiIcon("material-symbols:logout")} />
      <span>退出登录</span>
    </button>
  </div>
</aside>

{/* 窄屏抽屉的遮罩。桌面宽永远是 hidden（脚本那边根本不开抽屉），
    样式在 admin.css「窄屏：侧栏改成抽屉」那段。 */}
<div class="admin-side-mask" id="admin-side-mask" hidden></div>

{/*
  窄屏（≤900px）侧栏是**抽屉**（2026-10-15 起；原来是顶部横向滚动条）。
  开合的三条路：页头 ☰（#admin-nav-toggle，在 AdminTopBar 里）/ 遮罩点击 / Esc；
  点了菜单项也顺手关上。桌面宽（>900px）抽屉永远不开 —— 那边侧栏是常驻一列。

  为什么脚本要做这些事（CSS 独自不够）：
    · 开合是状态，得有个类在 `.admin-side` 上换来换去（`.on`）；
    · Esc 要监听 document；
    · 拉宽到桌面以上时把开着的抽屉收起来，别留一个浮层在路上；
    · 焦点：打开时移进菜单（键盘用户接着 Tab 还在菜单里），
      关上时还给那颗开关（不会掉回 body 顶部）。
  ⚠️ 早先这儿还有一段"横条"脚本（can-left/can-right 渐隐、当前项居中）——
     抽屉是竖排全量的，用不上了，一并删掉，别留死代码。
*/}
<script is:inline>
  (function () {
    function init() {
      var side = document.getElementById("admin-side");
      var mask = document.getElementById("admin-side-mask");
      var toggle = document.getElementById("admin-nav-toggle");
      if (!side || !mask || !toggle) return;
      var mq = window.matchMedia("(max-width: 900px)");

      function open() {
        if (!mq.matches) return; // 桌面宽不当浮层用
        side.classList.add("on");
        mask.hidden = false;
        toggle.setAttribute("aria-expanded", "true");
        // 焦点移进抽屉：键盘用户接着 Tab 还在菜单里，不会掉回页面底下
        var first = side.querySelector(".admin-side-item");
        if (first) first.focus();
      }
      function close(back) {
        side.classList.remove("on");
        mask.hidden = true;
        toggle.setAttribute("aria-expanded", "false");
        // 焦点还给那颗开关（从菜单里或遮罩上关的都算；从开关自己关的不用动）
        if (back !== false && (document.activeElement === document.body || side.contains(document.activeElement))) {
          toggle.focus();
        }
      }
      toggle.addEventListener("click", function () {
        if (side.classList.contains("on")) close();
        else open();
      });
      mask.addEventListener("click", function () {
        close();
      });
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape" && side.classList.contains("on")) close();
      });
      // 点了菜单项就关上（手机上选完功能不该还挡着半屏）
      side.addEventListener("click", function (e) {
        var a = e.target && e.target.closest ? e.target.closest("a.admin-side-item") : null;
        if (a) close();
      });
      // 拉宽到桌面以上：把开着的抽屉收起来，别留一个浮层
      if (mq.addEventListener) {
        mq.addEventListener("change", function (e) {
          if (!e.matches) close(false);
        });
      }
    }

    /* ⚠️ 必须等 DOM 解析完再挂监听（2026-10-15 实测踩到）：
       ☰ 开关在 AdminTopBar 里，而页头在本页 DOM 里排在**侧栏之后**（开关在 ~38793 字节处，
       这段脚本在 ~37125 处）。同步跑到这里时 getElementById("admin-nav-toggle") 拿到 null
       → 整个 init 早退 → 表现是"☰ 点得动、click 也照常冒泡，抽屉就是不开"
       （探针里文档级 click 计数器有值、抽屉状态纹丝不动，就是这个坑）。
       改成等解析完再挂；首帧就已存在时（readyState 不是 loading）直接挂，不留延迟。 */
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", init);
    else init();
  })();
</script>
