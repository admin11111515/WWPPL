---
/**
 * 后台页面共用的外壳。
 *
 * 后台每个页面都是独立的 HTML 文档，不走博客的 Layout，所以博客那套设计
 * 令牌、组件类、字体、主题色都拿不到 —— 这正是它们看着和博客不像同一个站的
 * 原因。这个组件不新造样式，只把博客那几份原样接过来：
 *
 *   1. src/styles/main.css       Tailwind 与博客的组件类
 *                                （.card-base / .btn-regular / .btn-plain / .float-panel / .text-90 …）
 *   2. src/styles/variables.styl 设计令牌（色相驱动的 oklch、圆角、分隔线、阴影）
 *   3. src/styles/markdown.css   正文排版 .custom-md，后台的预览区直接用它
 *   4. <FontManager />           博客的字体组件，后台正文与博客同一个字体
 *   5. 主题初始化                色相跟博客访客的选择同源（localStorage 的 hue），
 *                                明暗按 siteConfig.themeColor.defaultMode
 *
 * 用法：在 <head> 里放一个 <AdminTheme />。
 * 页面的 <html> 与 <body> 要带上博客同款类：
 *   <html class="bg-(--page-bg) text-[14px] md:text-[16px]">
 *   <body class="min-h-screen enable-card-border card-follow-theme-hue">
 */
import ConfigCarrier from "@components/layout/ConfigCarrier.astro";
import FontManager from "@/components/features/FontManager.astro";
import { expressiveCodeConfig, siteConfig } from "@/config";
import { PAGE_WIDTH } from "@/constants/constants";

import "@/styles/main.css";
import "@/styles/variables.styl";
import "@/styles/markdown.css";
import "@/styles/admin.css";

const configHue = siteConfig.themeColor.hue;
const defaultMode = siteConfig.themeColor.defaultMode ?? "light";
const pageWidth = `${siteConfig.pageWidth ?? PAGE_WIDTH}rem`;
---

{/* 配置里的值要变成 CSS 变量（--page-width 决定内容区宽度），但不能照抄
   Layout.astro 那种空的 <style define:vars>：Astro 是把这些变量挂到「这个
   组件里的元素」上，而 <html> 与 <body> 在页面文件里、不在这个组件里，
   于是变量一个也挂不出来 —— .container 的 max-width 会悄悄退成 none。
   改由下面那段脚本直接挂到 <html> 上，效果相同，也不受组件边界影响。 */}

{/* 配置载体：博客 Layout 里也有这一个。导航栏上的「显示设置」面板要靠它
    读默认色相（setting-utils 的 getDefaultHue 会找 #config-carrier 的
    data-hue，找不到就用写死的 250）—— 少了它，面板一挂载就把色相从配置里
    的 270 改成 250。 */}
<ConfigCarrier />

{/* 博客的字体：后台与博客用同一份字体文件，
    子集化脚本会扫描 dist 下所有 HTML，后台页面的字也会被收进子集 */}
<FontManager />

<script
  is:inline
  define:vars={{
    configHue,
    defaultMode,
    pageWidth,
    darkTheme: expressiveCodeConfig.darkTheme,
    lightTheme: expressiveCodeConfig.lightTheme,
  }}
>
  (function () {
    var LIGHT_MODE = "light";
    var DARK_MODE = "dark";
    var SYSTEM_MODE = "system";
    var root = document.documentElement;

    /* 后台页不走博客的 swup（2026-10-04 修）。
       起因：`@swup/astro` 集成会把它的 loader **注入每一页**，后台这些独立 HTML 也躲不掉，
       而后台根本没有它在 astro.config.mjs 里声明的那几个容器
       （#swup-container / #banner-*-container …）。结果：在后台点任何站内链接，
       swup 都会拦一下再失败，控制台一串
       `Container mismatch, aborting` + `Container missing …`（点一下报 4 条）。
       这里在 <html> 上打一个 `data-no-swup`（swup 判定点击时用的是
       `closest("[data-no-swup]")`，打在根上等于整页都忽略），后台于是走普通跳转。
       ⚠️ 别删这一行 —— 删了不是「恢复无刷新跳转」，后台从来就没有过它。 */
    root.setAttribute("data-no-swup", "");

    // 色相：博客把访客选的色相存进 localStorage 的 hue，后台跟着走
    var hue = localStorage.getItem("hue") || configHue;
    root.style.setProperty("--hue", hue);

    // 与博客 Layout 挂在 <html> 上的那两个变量对齐。
    // --page-width 决定内容区宽度，后台的 .container 靠它取上限。
    root.style.setProperty("--configHue", configHue);
    root.style.setProperty("--page-width", pageWidth);

    // 明暗：与博客 Layout 的初始化同一套判断
    function getSystemTheme() {
      return window.matchMedia("(prefers-color-scheme: dark)").matches
        ? DARK_MODE
        : LIGHT_MODE;
    }

    function resolveTheme(value) {
      return value === SYSTEM_MODE ? getSystemTheme() : value;
    }

    function applyTheme() {
      var isDark = resolveTheme(localStorage.getItem("theme") || defaultMode) === DARK_MODE;
      root.classList.toggle("dark", isDark);
      root.setAttribute("data-theme", isDark ? darkTheme : lightTheme);
    }

    applyTheme();

    // 系统主题变化时，只有没手动选过时才跟随
    if (window.matchMedia) {
      var mq = window.matchMedia("(prefers-color-scheme: dark)");
      var onSystemChange = function () {
        var saved = localStorage.getItem("theme");
        if (saved && saved !== SYSTEM_MODE) return;
        applyTheme();
      };
      if (mq.addEventListener) mq.addEventListener("change", onSystemChange);
      else if (mq.addListener) mq.addListener(onSystemChange);
    }

    // 供页面上的按钮切换明暗（与博客的 LightDarkSwitch 写同一个键）
    window.toggleDark = function () {
      var next = root.classList.contains("dark") ? LIGHT_MODE : DARK_MODE;
      try {
        localStorage.setItem("theme", next);
      } catch (e) {
        /* 存不下也不影响本次切换 */
      }
      applyTheme();
    };
  })();

  /**
   * 同一枚图标在一页里出现两次时，把 SVG 的 id 就地改名，避免互相抢。
   *
   * ⚠️ 这是一个真 bug 的修法，别删（2026-10-03 站长指着首页截图问「不觉得页面
   *    有问题吗」）：「文章管理」那张卡在页面上是**空框**，而它的 svg 数据完全正常
   *    （12 条 path、渐变颜色都在）。
   *    原因：同一枚图标在页面里出现两次 —— 一次在**登录页的 logo**（登录后
   *    `display:none` 但仍在 DOM 里），一次在文章管理卡。SVG 的 `fill="url(#X)"`
   *    按**文档顺序**取第一个 id=X 的元素，于是取到了登录页那份；而登录页整块是
   *    `display:none`，**藏在里面的渐变当不了画刷** → 后面那枚图标什么都画不出来。
   *    实测：把登录页那块从 DOM 摘掉，这枚图标的墨迹占比立刻从 7% 回到 23%。
   *
   * 做法：找出"同一个 id 被不止一个 svg 定义"的，除第一个外全部改名
   * （连同它自己 svg 内的 url(#…) 引用一起改）。改名对这个 svg 是自洽的，
   * 所以画出来和原来一模一样，只是不再和别处抢先。
   */
  function dedupeSvgIds() {
    var svgs = document.querySelectorAll("svg");
    var seen = Object.create(null);
    // ⚠️ 计数器必须是**全局**的，不能每个 svg 各自从 1 开始：
    //    否则第 2 个 svg 改出 -dup1、第 3 个也改出 -dup1，两处又撞上了。
    var n = 0;
    Array.prototype.forEach.call(svgs, function (svg) {
      var ids = [];
      Array.prototype.forEach.call(svg.querySelectorAll("[id]"), function (el) {
        var id = el.getAttribute("id");
        if (!id) return;
        if (seen[id]) ids.push(id);
        else seen[id] = svg;
      });
      if (!ids.length) return;
      ids.forEach(function (id) {
        var next = id + "-dup" + ++n;
        Array.prototype.forEach.call(svg.querySelectorAll('[id="' + id + '"]'), function (el) {
          el.setAttribute("id", next);
        });
        Array.prototype.forEach.call(svg.querySelectorAll("[fill],[mask],[clip-path],[filter],[stroke]"), function (el) {
          ["fill", "mask", "clip-path", "filter", "stroke"].forEach(function (attr) {
            var v = el.getAttribute(attr);
            if (v && v.indexOf("url(#" + id + ")") === 0) {
              el.setAttribute(attr, v.split("url(#" + id + ")").join("url(#" + next + ")"));
            }
          });
        });
      });
    });
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", dedupeSvgIds);
  } else {
    dedupeSvgIds();
  }
</script>
