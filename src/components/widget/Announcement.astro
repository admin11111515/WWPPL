---
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import { announcementConfig } from "@/config/announcementConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";

const config = announcementConfig;

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}
const { class: className, style, widgetConfig } = Astro.props;

const showTitle = widgetConfig?.showTitle !== false;
---

<!-- 组件显示现在由sidebarLayoutConfig统一控制，无需检查config.enable -->
<WidgetLayout
  name={config.title || i18n(I18nKey.announcement)}
  showTitle={showTitle}
  id="announcement"
  class={className}
  style={style}
>
  <div>
    <!-- 公告栏内容 -->
    <div class="text-neutral-600 dark:text-neutral-300 leading-relaxed mb-3">
      {config.content}
    </div>

    <!-- 可选链接和关闭按钮 -->
    <div class="flex items-center justify-between gap-3">
      <div>
        {
          config.link && config.link.enable !== false && (
            <a
              href={config.link.url}
              target={config.link.external ? "_blank" : "_self"}
              rel={config.link.external ? "noopener noreferrer" : undefined}
              class="btn-regular rounded-lg px-3 py-1.5 text-sm font-medium active:scale-95 transition-transform"
            >
              {config.link.text}
            </a>
          )
        }
      </div>

      {
        config.closable && (
          <button
            class="btn-regular rounded-lg h-8 w-8 text-sm hover:bg-red-100 dark:hover:bg-red-900/30 transition-colors"
            data-announcement-close="true"
            aria-label={i18n(I18nKey.announcementClose)}
          >
            <Icon is:inline name="fa7-solid:xmark" class="text-sm" />
          </button>
        )
      }
    </div>
  </div>
</WidgetLayout>

<script>
	// 公告关闭按钮：点一下，本次会话内不再出现（关掉标签页即复位）。
	//
	// 原来只写了 onclick="closest('widget-layout').style.display='none'"，那只能关掉
	// 当前这一个节点 —— 公告在侧栏和移动端底部各有一份，而且 swup 换页后 DOM 会重建，
	// 刷新也会回来，等于「关不掉」。这里把状态记进 sessionStorage，并在每次内容替换后重新应用。
	const KEY = "wwppl:announcement-closed";

	const hideAll = () => {
		const nodes = document.querySelectorAll<HTMLElement>("widget-layout#announcement");
		nodes.forEach((el) => {
			el.style.display = "none";
		});
	};

	const applyState = () => {
		if (sessionStorage.getItem(KEY) === "1") hideAll();
	};

	// 用事件委托：两份公告、以及换页后重建的按钮，都不用重新绑定。
	document.addEventListener("click", (event) => {
		const target = event.target as HTMLElement | null;
		if (!target?.closest("[data-announcement-close]")) return;
		sessionStorage.setItem(KEY, "1");
		hideAll();
	});

	applyState();

	// swup 换页时这个脚本不会重跑，得挂钩子再应用一次。
	// 注意钩子名是 content:replace（无 d），写成 content:replaced 会被 swup 报 Unknown hook。
	type SwupLike = { hooks?: { on: (name: string, cb: () => void) => void } } | undefined;
	const onSwupReady = () => {
		(window as unknown as { swup?: SwupLike }).swup?.hooks?.on("content:replace", applyState);
	};
	onSwupReady();
	document.addEventListener("swup:enable", onSwupReady);
</script>
