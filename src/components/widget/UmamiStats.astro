---
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import { analyticsConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

interface Props {
	class?: string;
	style?: string;
}
const { class: className, style } = Astro.props;

// 只有配置了公开分享链接，这个组件才有数据可读。
// 没配置就整体不渲染：统计数字要么有来源，要么干脆不出现，
// 不摆一个看起来像真的、实际没有来源的数字。
const shareUrl = (analyticsConfig.umamiAnalytics?.shareUrl ?? "").trim();

const unavailableText = i18n(I18nKey.pageViewsError);
---

{shareUrl && (
	<WidgetLayout
		id="umami-stats"
		name={i18n(I18nKey.umamiStats)}
		class:list={["umami-stats-container", className, "cursor-pointer transition-opacity active:scale-95"]}
		{style}
	>
		<a href={shareUrl} target="_blank" rel="noopener noreferrer" class="block umami-link">
			<div class="text-center py-2">
				<div class="text-3xl font-bold text-neutral-900 dark:text-neutral-100 umami-total-pageviews">-</div>
				<div class="text-sm text-neutral-500 dark:text-neutral-400">{i18n(I18nKey.umamiTotalPageviews)}</div>
			</div>
			<div class="grid grid-cols-2 divide-x divide-neutral-200 dark:divide-neutral-700 text-center pt-2">
				<div class="px-2">
					<div class="text-xl font-bold text-neutral-900 dark:text-neutral-100 umami-total-visits">-</div>
					<div class="text-sm text-neutral-500 dark:text-neutral-400">{i18n(I18nKey.umamiVisits)}</div>
				</div>
				<div class="px-2">
					<div class="text-xl font-bold text-neutral-900 dark:text-neutral-100 umami-total-visitors">-</div>
					<div class="text-sm text-neutral-500 dark:text-neutral-400">{i18n(I18nKey.umamiVisitors)}</div>
				</div>
			</div>
		</a>
		<span class="umami-unavailable-text hidden">{unavailableText}</span>
	</WidgetLayout>
)}

<script>
let __UMAMI_INTERNAL: {
    baseUrl: string;
    websiteId: string;
    shareToken: string;
    isReady: boolean;
} = {
    baseUrl: '',
    websiteId: '',
    shareToken: '',
    isReady: false
};

type UmamiLink = HTMLAnchorElement;

function findLinks(): UmamiLink[] {
    return Array.from(document.querySelectorAll<UmamiLink>('.umami-link'));
}

function unavailableText(): string {
    const el = document.querySelector('.umami-unavailable-text');
    return el && el.textContent ? el.textContent.trim() : '';
}

// 取不到数据时把占位符留成短横线，并把原因写在悬停提示里。
// 这里刻意不做任何"兜底数字"：没有来源的数字比留白更容易误导人。
function markUnavailable() {
    const text = unavailableText();
    document.querySelectorAll('.umami-total-pageviews, .umami-total-visits, .umami-total-visitors').forEach((el) => {
        el.textContent = '-';
        if (text) el.setAttribute('title', text);
    });
}

async function initUmamiConfig(): Promise<boolean> {
    const link = findLinks()[0];
    if (!link) return false;

    const rawUrl = (link.getAttribute('href') || '').trim();
    const sharePath = rawUrl.split('/share/')[1];
    if (!sharePath) {
        console.warn('[Umami] 分享链接格式不对，应形如 https://cloud.umami.is/share/xxxxxxxx');
        return false;
    }

    try {
        let apiBase = '';
        if (rawUrl.includes('cloud.umami.is') || rawUrl.includes('analytics.umami.is')) {
            const region = rawUrl.includes('/analytics/eu/') ? 'eu' : 'us';
            apiBase = `https://cloud.umami.is/analytics/${region}/api`;
        } else {
            apiBase = `${new URL(rawUrl).origin}/api`;
        }

        const res = await fetch(`${apiBase}/share/${sharePath}`);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();

        __UMAMI_INTERNAL = {
            baseUrl: apiBase,
            websiteId: data.websiteId,
            shareToken: data.token,
            isReady: true
        };
        return true;
    } catch (e) {
        console.warn('[Umami] 读取分享配置失败：', e);
        return false;
    }
}

function formatNumber(num: number): string {
    if (num >= 1000000) {
        return (num / 1000000).toFixed(1) + 'M';
    } else if (num >= 1000) {
        return (num / 1000).toFixed(1) + 'K';
    }
    return Math.round(num).toString();
}

function setStats(values: { pageviews: number; visits: number; visitors: number }) {
    const pageviewsElements = document.querySelectorAll('.umami-total-pageviews');
    const visitsElements = document.querySelectorAll('.umami-total-visits');
    const visitorsElements = document.querySelectorAll('.umami-total-visitors');

    const easeOutCubic = (t: number) => 1 - Math.pow(1 - t, 3);
    const animHandles = new Map<Element, number>();

    const animateStat = (el: Element | null, to: number, duration = 2000) => {
        if (!el) return;
        el.removeAttribute('title');

        const prev = animHandles.get(el);
        if (prev) cancelAnimationFrame(prev);

        const startTime = performance.now();

        const tick = (now: number) => {
            const progress = Math.min(1, (now - startTime) / duration);
            el.textContent = formatNumber(to * easeOutCubic(progress));
            if (progress < 1) {
                animHandles.set(el, requestAnimationFrame(tick));
            }
        };
        animHandles.set(el, requestAnimationFrame(tick));
    };

    pageviewsElements.forEach(el => animateStat(el, values.pageviews));
    visitsElements.forEach(el => animateStat(el, values.visits));
    visitorsElements.forEach(el => animateStat(el, values.visitors));
}

async function fetchUmamiStats() {
    if (!__UMAMI_INTERNAL.isReady) {
        const ok = await initUmamiConfig();
        if (!ok) {
            markUnavailable();
            return;
        }
    }

    try {
        const endAt = Date.now();
        const url = `${__UMAMI_INTERNAL.baseUrl}/websites/${__UMAMI_INTERNAL.websiteId}/stats?startAt=0&endAt=${endAt}&unit=hour&timezone=Asia%2FShanghai`;

        const response = await fetch(url, {
            headers: {
                'x-umami-share-context': '1',
                'x-umami-share-token': __UMAMI_INTERNAL.shareToken
            }
        });

        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const data = await response.json();
        const getValue = (field: any) => (typeof field === 'object' ? field?.value : field) || 0;

        setStats({
            pageviews: getValue(data.pageviews),
            visits: getValue(data.visits),
            visitors: getValue(data.visitors),
        });
    } catch (error) {
        console.warn('[Umami] 读取统计数据失败：', error);
        markUnavailable();
    }
}

let __umamiStatsStarted = false;
function startUmamiStats() {
    if (__umamiStatsStarted) return;
    __umamiStatsStarted = true;
    fetchUmamiStats();
}

function initUmamiStatsVisibility() {
    const containers = document.querySelectorAll('.umami-stats-container');
    if (!containers.length) return;

    const io = new IntersectionObserver((entries) => {
        if (entries.some(entry => entry.isIntersecting)) {
            startUmamiStats();
            io.disconnect();
        }
    }, { threshold: 0.1 });

    containers.forEach(container => io.observe(container));
}

initUmamiStatsVisibility();

if (window.swup) {
    window.swup.hooks.on('page:view', () => {
        // 只重置"本轮是否已取过数"，分享配置仍然复用，避免每次切页都多打一次接口
        __umamiStatsStarted = false;
        initUmamiStatsVisibility();
    });
}
</script>
